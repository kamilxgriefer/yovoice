# Not a secret: LiveKit's public WebSocket endpoint (same one every client
# connects to). API key/secret stay in Secret Manager, defined via
# defineSecret() in livekit/token.js — never put those here.
LIVEKIT_URL=wss://yovoice-3f7j9fb7.livekit.cloud

# GIFs in the composer (ADR-172). `yovoice` serves the first-party animated
# reaction pack bundled with every client, so search/send/render work without
# an external credential. This value is available to local runtimes and tests;
# production exports select `yovoice` explicitly in functions/index.js because
# Firebase discovers endpoints before loading .env. A production move to
# `giphy` therefore requires a reviewed source change, a configured
# GIPHY_API_KEY secret and a new functions deploy. `fake` selects the fixture
# catalog and is refused outside the emulator / NODE_ENV=test.
GIF_PROVIDER=yovoice

# Staged App Check enforcement, same rollout convention as
# YOVOICE_ENFORCE_REELS_APP_CHECK. Must be exactly true or false when set.
YOVOICE_ENFORCE_GIF_APP_CHECK=false
