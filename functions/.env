# Not a secret: LiveKit's public WebSocket endpoint (same one every client
# connects to). API key/secret stay in Secret Manager, defined via
# defineSecret() in livekit/token.js — never put those here.
LIVEKIT_URL=wss://yovoice-3f7j9fb7.livekit.cloud

# GIFs in the composer (ADR-172). `none` is the production value today: the
# GIF tab renders disabled and labelled, and searchGifs/reportGifAsset are not
# registered at all. Set to `giphy` AFTER
# `firebase functions:secrets:set GIPHY_API_KEY --project yovoice-ec54a`,
# then deploy firestore.rules first and functions second. `fake` selects the
# fixture catalog and is refused outside the emulator / NODE_ENV=test.
GIF_PROVIDER=none

# Staged App Check enforcement, same rollout convention as
# YOVOICE_ENFORCE_REELS_APP_CHECK. Must be exactly true or false when set.
YOVOICE_ENFORCE_GIF_APP_CHECK=false
