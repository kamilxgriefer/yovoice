{
  "name": "yovoice-functions",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "deploy": "firebase deploy --only functions",
    "serve": "firebase emulators:start --only functions",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:smoke": "node test/global_chat_trigger.smoke.js && node test/moderation_trigger.smoke.js && node test/social_graph_binding.smoke.js",
    "backfill:public-profiles": "node scripts/backfill_public_profiles.js",
    "backfill:profile-identity": "node scripts/backfill_profile_identity.js",
    "scrub:legacy-identity": "node scripts/scrub_legacy_identity_snapshots.js",
    "scrub:retired-social-notifications": "node scripts/scrub_retired_social_notifications.js"
  },
  "dependencies": {
    "firebase-admin": "14.3.0",
    "firebase-functions": "7.3.2",
    "livekit-server-sdk": "2.18.0",
    "music-metadata": "11.15.0",
    "stripe": "22.6.1"
  },
  "overrides": {
    "gaxios": {
      "uuid": "11.1.1"
    },
    "teeny-request": {
      "uuid": "11.1.1"
    }
  }
}
