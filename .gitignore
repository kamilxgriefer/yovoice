# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
**/node_modules/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Production signing material is generated locally and stored in the macOS
# Keychain. Never commit the upload keystore itself.
/android/app/yovoice-upload-keystore.jks

# Apple signing material is installed through Keychain / provisioning profiles
# and stored outside the repository. Never commit private Sign in with Apple
# keys or downloaded provisioning profiles.
*.p8
*.mobileprovision

# Widget Preview related
.widget_preview/

# Local Claude Code state stays local, but the persistent specialist roster in
# .claude/agents/ is project configuration and is versioned like .codex/agents/
# (see docs/AI_TEAM.md).
.claude/*
!.claude/agents/

# Screenshots written by test/moderation_screenshot.dart (visual harness)
test/.screenshots/

# Playwright browser-smoke reports and failure diagnostics
/browser-tests/playwright-report/
/browser-tests/test-results/
