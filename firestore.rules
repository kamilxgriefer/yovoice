rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Nested `match /parent/{id}/collection/{doc}` rules only ever apply to
    // reads/writes scoped to one specific parent — they do NOT authorize a
    // collectionGroup() query, which scans the named collection across every
    // parent at once. Firestore requires a separate, top-level
    // `match /{path=**}/collection/{doc}` rule for that (verified against
    // the emulator: without it, the query is rejected as permission-denied
    // regardless of how permissive the nested rule is). These two mirror the
    // narrowest read case the app's actual collectionGroup() queries need —
    // full create/update/delete authorization still lives on the nested
    // rules below, since writes always go through a specific parent path.
    match /{path=**}/roomMembers/{memberId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /{path=**}/invites/{inviteId} {
      allow read: if isActiveAccount() &&
          resource.data.inviteeId == request.auth.uid;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // request.auth.token.email_verified mirrors the ID token's claim —
    // Firebase Auth sets it automatically and it refreshes the next time
    // the client gets a new token after verifying, so this can't be
    // spoofed from the client the way a Firestore-stored flag could be.
    // Gates outbound/spam-prone actions (sending messages, starting
    // conversations, friend requests, club/room/moment creation, club
    // invites) — NOT passive actions (reading, joining, reacting,
    // blocking), which stay available to a freshly-registered account.
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Kept as the name the rest of this file uses for "is this account
    // staff right now". See isActiveStaff() below for why it is both the
    // signed claim and the server-written mirror.
    function isStaff() {
      return isActiveStaff();
    }

    // AUTHORITATIVE ACCOUNT STATUS.
    //
    // `users/{uid}.banned` is written only by functions/admin/users.js's
    // setUserBan through the Admin SDK. It is deliberately absent from
    // the self-write allowlist on users/{userId} below, so the affected
    // account can neither set nor clear it.
    //
    // Why rules check a DOCUMENT and not just request.auth: disabling an
    // account in Firebase Auth stops it minting NEW ID tokens, but an ID
    // token already in the client's hands stays cryptographically valid
    // until it expires (up to one hour). For that window `request.auth`
    // is still populated and `isSignedIn()` is still true. Reading the
    // status document makes a ban effective on the very next request
    // instead. setUserBan also revokes refresh tokens, which shortens the
    // token's own remaining life — see docs/SECURITY.md.
    //
    // `bannedUntil` records the INTENDED duration; nothing expires it
    // automatically today, so `banned` staying true is what gates access
    // until an administrator lifts it.
    function isRestrictedAccount(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
          get(/databases/$(database)/documents/users/$(userId))
            .data.get('banned', false) == true;
    }

    function accountIsActive(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
          get(/databases/$(database)/documents/users/$(userId))
            .data.get('banned', false) != true &&
          get(/databases/$(database)/documents/users/$(userId))
            .data.get('disabled', false) != true;
    }

    function isActiveAccount() {
      return isSignedIn() && accountIsActive(request.auth.uid);
    }

    // Identity snapshots written by clients are presentation caches, never a
    // second identity authority. Bind every such write to the current private
    // canonical profile so stale Firebase Auth metadata or a modified client
    // cannot impersonate another display name.
    function displayNameMatchesCanonical(userId, displayName) {
      return displayName is string &&
          displayName.size() > 0 &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          displayName == get(
            /databases/$(database)/documents/users/$(userId)
          ).data.get('displayName', '');
    }

    // STAFF COMMUNICATION MUTE — a server-managed restriction, distinct
    // from a personal block (which affects only the acting user) and
    // from a suspension (which disables the account). restrictions/{uid}
    // is written only by the applySanction callable through the Admin
    // SDK; no client writes exist. Expiry is time-based, so a lapsed
    // mute stops applying on the next request with no sweeper involved.
    function isCommunicationMuted(userId) {
      return exists(/databases/$(database)/documents/restrictions/$(userId)) &&
          get(/databases/$(database)/documents/restrictions/$(userId))
            .data.get('type', '') == 'communicationMute' &&
          (
            get(/databases/$(database)/documents/restrictions/$(userId))
              .data.get('expiresAt', null) == null ||
            request.time < get(/databases/$(database)/documents/restrictions/$(userId))
              .data.expiresAt
          );
    }

    function canCommunicate() {
      return isActiveAccount() &&
          !isCommunicationMuted(request.auth.uid);
    }

    // STAFF AUTHORITY — the token claim AND the server-written mirror.
    //
    // `assignUserRole` (functions/admin/users.js) does two things: it
    // sets the `role` custom claim, and it writes the same value to
    // `users/{uid}.role` through the Admin SDK. `role` is absent from
    // the self-write allowlist on users/{userId}, so the affected
    // account cannot grant itself one.
    //
    // Requiring BOTH closes the staleness hole in each direction:
    //  - the claim is signed, so a client cannot forge staff access even
    //    by writing its own profile document;
    //  - the document is written synchronously when a role changes, so a
    //    REVOKED role stops working on the very next request instead of
    //    surviving up to an hour inside an already-issued ID token.
    // A freshly promoted moderator whose token has not refreshed yet
    // fails closed (no access) rather than open.
    function isStaffClaim() {
      return isSignedIn() &&
          request.auth.token.get('role', 'user') in
              ['moderator', 'superModerator', 'superAdmin'];
    }

    function staffRoleOf(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
          ? get(/databases/$(database)/documents/users/$(userId))
              .data.get('role', 'user')
          : 'user';
    }

    function isActiveStaff() {
      return isStaffClaim() &&
          !isRestrictedAccount(request.auth.uid) &&
          staffRoleOf(request.auth.uid) in
              ['moderator', 'superModerator', 'superAdmin'];
    }

    function isBlockedPair(userA, userB) {
      return exists(
        /databases/$(database)/documents/users/$(userA)/blocked/$(userB)
      ) ||
      exists(
        /databases/$(database)/documents/users/$(userB)/blocked/$(userA)
      );
    }

    // Direction matters for known-id profile reads. A member must still be
    // able to resolve the minimal public identity of somebody THEY blocked in
    // order to render Settings -> Blocked users and offer Unblock. The reverse
    // is not true: somebody blocked by the profile owner must not use a stale
    // notification or guessed uid to keep opening that owner's profile.
    function profileOwnerBlockedCaller(profileOwnerId) {
      return isSignedIn() && exists(
        /databases/$(database)/documents/users/$(profileOwnerId)/blocked/$(request.auth.uid)
      );
    }

    // Missing means public solely for backwards compatibility with profiles
    // created before the visibility control shipped. An unknown server value
    // fails closed to private instead of widening access accidentally.
    function profileVisibilityOf(userId) {
      let value = get(
        /databases/$(database)/documents/users/$(userId)
      ).data.get('profileVisibility', 'public');
      return value in ['public', 'friends', 'private'] ? value : 'private';
    }

    function canReadFullProfile(userId) {
      let visibility = profileVisibilityOf(userId);
      return isActiveAccount() && accountIsActive(userId) &&
          (
            isOwner(userId) ||
            (
              !profileOwnerBlockedCaller(userId) &&
              (
                visibility == 'public' ||
                (
                  visibility == 'friends' &&
                  canonicalFriendshipGuard(request.auth.uid, userId) &&
                  canonicalFriendshipGuard(userId, request.auth.uid)
                )
              )
            )
          );
    }

    // Direct-message privacy is private account configuration. Absence means
    // `everyone` for backward compatibility with existing accounts; any
    // present, unknown value fails closed because none of the branches below
    // match. Social edges are server-owned, so a modified client cannot forge
    // the follow/friend relationship needed by a narrower mode.
    function canDirectMessage(senderId, recipientId) {
      let privacy = get(
        /databases/$(database)/documents/users/$(recipientId)
      ).data.get('messagePrivacy', 'everyone');
      return privacy == 'everyone' ||
          (
            privacy == 'peopleYouFollow' &&
            canonicalFollowingEdge(recipientId, senderId)
          ) ||
          (
            privacy == 'friends' &&
            canonicalFriendshipGuard(senderId, recipientId) &&
            canonicalFriendshipGuard(recipientId, senderId)
          );
    }

    function canonicalFollowingEdge(ownerId, targetId) {
      let edgePath = /databases/$(database)/documents/users/$(ownerId)/following/$(targetId);
      return exists(edgePath) &&
          get(edgePath).data.keys().hasAll(['uid', 'followedAt']) &&
          get(edgePath).data.keys().hasOnly(['uid', 'followedAt']) &&
          get(edgePath).data.uid == targetId &&
          get(edgePath).data.followedAt is timestamp;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Premium entitlement check. entitlements/{uid} is written ONLY by
    // Cloud Functions (client writes are denied below), so this cannot be
    // self-granted from a modified client. Validity is time-based —
    // request.time vs currentPeriodEnd — so expiry enforces itself with
    // no scheduled job in the authorization path. "grace" covers billing
    // retry so a failed card doesn't strip capabilities mid-cycle.
    function hasActivePremium() {
      return isSignedIn() &&
          exists(/databases/$(database)/documents/entitlements/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/entitlements/$(request.auth.uid))
            .data.status in ['active', 'trialing', 'grace'] &&
          request.time < get(/databases/$(database)/documents/entitlements/$(request.auth.uid))
            .data.currentPeriodEnd;
    }

    // Product capabilities are explicit even though today's Monthly and
    // Yearly plans grant the same bundle. This keeps rules aligned with the
    // client model when future tiers vary: an active status alone never
    // bypasses a disabled feature, and the same entitlement must grant the
    // public Premium identity before Creator/Clubs unlock.
    function hasCreatorPremium() {
      return hasActivePremium() &&
          get(/databases/$(database)/documents/entitlements/$(request.auth.uid))
            .data.get('premiumIdentityEnabled', false) == true &&
          get(/databases/$(database)/documents/entitlements/$(request.auth.uid))
            .data.get('creatorEnabled', false) == true;
    }

    function userHasCreatorPremium(userId) {
      return exists(/databases/$(database)/documents/entitlements/$(userId)) &&
          get(/databases/$(database)/documents/entitlements/$(userId))
            .data.status in ['active', 'trialing', 'grace'] &&
          get(/databases/$(database)/documents/entitlements/$(userId))
            .data.get('isPremium', false) == true &&
          get(/databases/$(database)/documents/entitlements/$(userId))
            .data.get('premiumIdentityEnabled', false) == true &&
          get(/databases/$(database)/documents/entitlements/$(userId))
            .data.get('creatorEnabled', false) == true &&
          request.time < get(/databases/$(database)/documents/entitlements/$(userId))
            .data.currentPeriodEnd;
    }

    // accountType is client-writable ONLY within these transitions:
    // keeping it unchanged, or setting 'personal' (always allowed), or
    // setting 'creator' with active Premium. 'official' is never
    // client-settable. Before this rule ANY client could write
    // accountType: 'creator' — Creator gating was UI-only.
    function accountTypeChangeAllowed() {
      return !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['accountType']) ||
          request.resource.data.accountType == 'personal' ||
          (request.resource.data.accountType == 'creator' && hasCreatorPremium());
    }

    // displayName becomes server-authoritative after initial profile
    // bootstrap. updateMyDisplayName owns every later change and stamps the
    // private displayNameChangedAt cooldown. Existing installs still need to
    // complete a partial users/{uid} document created first by presence or a
    // social race, so exactly one missing/empty -> non-empty bootstrap remains
    // possible. Keeping unchanged displayName in a merge is also harmless:
    // Firestore diff() does not include equal values.
    function displayNameChangeAllowed() {
      return !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['displayName']) ||
          (
            (
              !resource.data.keys().hasAny(['displayName']) ||
              !(resource.data.displayName is string) ||
              resource.data.displayName.size() == 0
            ) &&
            request.resource.data.displayName is string &&
            request.resource.data.displayName.size() >= 2 &&
            request.resource.data.displayName.size() <= 120
          );
    }

    function messagePrivacyChangeAllowed() {
      return !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['messagePrivacy']) ||
          request.resource.data.messagePrivacy in [
            'everyone', 'peopleYouFollow', 'friends', 'nobody'
          ];
    }

    // A user's first client write used to accept ANY fields, which let a new
    // account create itself as Creator, Premium or staff before the stricter
    // update rule ever applied. First-write races from presence/friends are
    // legitimate, so partial documents remain allowed — but only from the
    // same non-privileged field set used by profile bootstrap.
    function userCreateAllowed(userId) {
      return isOwner(userId) &&
          request.resource.data.keys().hasOnly([
            'uid', 'email', 'displayName', 'username', 'photoUrl',
            'bannerUrl', 'bio', 'country', 'nativeLanguage',
            'spokenLanguages', 'learningLanguages', 'website',
            'statusMessage', 'accountType', 'profileUpdatedAt',
            'createdAt', 'isOnline', 'lastSeen', 'presenceUpdatedAt',
            'messageCount', 'followerCount', 'followingCount',
            'roomCount', 'communityCount', 'voiceMinutes',
            'reactionCount', 'hostMinutes', 'activeDays', 'momentCount',
            'friendCount', 'unlockedTitleIds', 'unlockedTitleTimestamps',
            'selectedTitleId', 'achievementsUpdatedAt',
            'notificationPreferences', 'messagePrivacy'
          ]) &&
          (
            !request.resource.data.keys().hasAny(['uid']) ||
            request.resource.data.uid == userId
          ) &&
          (
            !request.resource.data.keys().hasAny(['accountType']) ||
            request.resource.data.accountType == 'personal'
          ) &&
          (
            !request.resource.data.keys().hasAny(['messagePrivacy']) ||
            request.resource.data.messagePrivacy in [
              'everyone', 'peopleYouFollow', 'friends', 'nobody'
            ]
          ) &&
          (
            !request.resource.data.keys().hasAny(['friendCount']) ||
            request.resource.data.friendCount == 0
          ) &&
          (
            !request.resource.data.keys().hasAny(['followerCount']) ||
            request.resource.data.followerCount == 0
          ) &&
          (
            !request.resource.data.keys().hasAny(['followingCount']) ||
            request.resource.data.followingCount == 0
          );
    }

    function isOneOfUsers(firstUserId, secondUserId) {
      return isSignedIn() &&
          (request.auth.uid == firstUserId ||
           request.auth.uid == secondUserId);
    }

    function conversationExists(conversationId) {
      return exists(
        /databases/$(database)/documents/conversations/$(conversationId)
      );
    }

    function isConversationParticipant(conversationId) {
      return isSignedIn() &&
          conversationExists(conversationId) &&
          request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participantIds;
    }

    function conversationBlocked(conversationId) {
      let participants = get(
        /databases/$(database)/documents/conversations/$(conversationId)
      ).data.participantIds;
      return isBlockedPair(participants[0], participants[1]);
    }

    function roomExists(roomId) {
      return exists(
        /databases/$(database)/documents/rooms/$(roomId)
      );
    }

    function isRoomHost(roomId) {
      return isActiveAccount() &&
          roomExists(roomId) &&
          get(
            /databases/$(database)/documents/rooms/$(roomId)
          ).data.hostId == request.auth.uid;
    }

    function isRoomParticipant(roomId) {
      return isSignedIn() && exists(
        /databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid)
      );
    }

    // A membership row is AUTHORITY — canAccessRoom() reads it to open a
    // private room, and roomVoiceStartAllowed() reads it to start that
    // room's voice session — so it carries the same account-status test
    // every other private-room branch does. isActiveClubRoomMember()
    // already calls isActiveAccount(), and a suspension that stops at the
    // Club lounge door but not the Community room door is not a suspension.
    // A banned or disabled account keeps its membership row; what it loses
    // is the ability to use it.
    function isRoomMember(roomId) {
      return isActiveAccount() && exists(
        /databases/$(database)/documents/rooms/$(roomId)/roomMembers/$(request.auth.uid)
      );
    }

    function isActiveClubRoomMember(roomId) {
      let room = get(
        /databases/$(database)/documents/rooms/$(roomId)
      ).data;
      let clubId = room.get('clubId', '');
      let memberPath = /databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid);
      return isActiveAccount() &&
          roomExists(roomId) &&
          clubId is string &&
          clubId.size() > 0 &&
          exists(/databases/$(database)/documents/clubs/$(clubId)) &&
          exists(memberPath) &&
          get(memberPath).data.userId == request.auth.uid &&
          get(memberPath).data.get('banned', false) != true &&
          get(
            /databases/$(database)/documents/clubs/$(clubId)
          ).data.status == 'active' &&
          get(
            /databases/$(database)/documents/clubs/$(clubId)
          ).data.get('deletionInProgress', false) != true;
    }

    // A private non-Club participant must have been admitted by the current
    // host. This deliberately refuses legacy/self-forged participant rows;
    // Club lounges instead derive admission from canonical Club membership.
    //
    // Account-status gated for the same reason isRoomMember() is: this is
    // the THIRD door into a private room, alongside canonical Club
    // membership and a roomMembers row, and canAccessRoom() reads all three
    // interchangeably. The 2026-08-16 pass closed the other two and left
    // this one on isSignedIn(), so a host-admitted participant kept the
    // private room, its roster, its participant list and its chat straight
    // through a suspension. A suspension that stops at two of three doors
    // is not a suspension. Admission survives the ban — what it loses is
    // the ability to use it — and leaving is unaffected either way, since
    // participant rows are deleted only by the leaveRoomSelf/staff
    // callables (`allow delete: if false` below) and a roomMembers row is
    // self-deletable on a rule that deliberately checks nothing but uid.
    function isHostAdmittedRoomParticipant(roomId) {
      let room = get(
        /databases/$(database)/documents/rooms/$(roomId)
      ).data;
      let participantPath = /databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid);
      return isActiveAccount() &&
          exists(participantPath) &&
          get(participantPath).data.get('admittedBy', '') == room.hostId;
    }

    // A Community room's own members are the fourth way in, and they were
    // missing. Membership is joined while a room is public, but the host can
    // flip `visibility` to private afterwards through the ordinary metadata
    // update — the member documents survive that flip, and without this
    // branch every one of those members loses the room itself.
    //
    // That the omission was accidental rather than a boundary is settled by
    // the rest of this ruleset: a roomMember may already read the room's chat
    // (match /messages) and may already START ITS VOICE SESSION
    // (roomVoiceStartAllowed via membersCanStartVoice) — a document nobody
    // may read but a member may write is not a deliberate privacy design. It
    // also breaks more than the one room: watchMyCommunities() hydrates every
    // id its collectionGroup query returned with a rooms/{id} get inside a
    // single Future.wait, so one unreadable room empties the whole list.
    //
    // This grants no new authority. roomMembers documents can only be created
    // by the room's own host at creation time, or self-joined on a room that
    // is public with approvalRequired false — so an outsider cannot mint the
    // membership that would buy them the read.
    function canAccessRoom(roomId) {
      let room = get(
        /databases/$(database)/documents/rooms/$(roomId)
      ).data;
      return isSignedIn() && roomExists(roomId) &&
          (
            room.visibility == 'public' ||
            room.hostId == request.auth.uid ||
            (
              room.get('clubId', '') is string &&
              room.get('clubId', '').size() > 0
                ? isActiveClubRoomMember(roomId)
                : (
                    isHostAdmittedRoomParticipant(roomId) ||
                    isRoomMember(roomId)
                  )
            )
          );
    }

    function selfRoomParticipantShape(data, expectedRole, expectedSpeaker) {
      return data.keys().hasAll([
            'userId', 'displayName', 'role', 'isMuted', 'isSpeaker',
            'isHandRaised', 'joinedAt', 'updatedAt'
          ]) &&
          data.keys().hasOnly([
            'userId', 'displayName', 'photoUrl', 'role', 'isMuted',
            'isSpeaker', 'isHandRaised', 'joinedAt', 'updatedAt'
          ]) &&
          data.userId == request.auth.uid &&
          displayNameMatchesCanonical(request.auth.uid, data.displayName) &&
          data.role == expectedRole &&
          data.isSpeaker == expectedSpeaker &&
          data.isHandRaised == false &&
          data.joinedAt == request.time &&
          data.updatedAt == request.time;
    }

    function hostAdmittedParticipantShape(data, participantId) {
      return data.keys().hasAll([
            'userId', 'displayName', 'role', 'isMuted', 'isSpeaker',
            'isHandRaised', 'admittedBy', 'updatedAt'
          ]) &&
          data.keys().hasOnly([
            'userId', 'displayName', 'photoUrl', 'role', 'isMuted',
            'isSpeaker', 'isHandRaised', 'admittedBy', 'updatedAt'
          ]) &&
          data.userId == participantId &&
          displayNameMatchesCanonical(participantId, data.displayName) &&
          data.admittedBy == request.auth.uid &&
          data.role in ['listener', 'speaker'] &&
          data.isSpeaker == (data.role == 'speaker') &&
          data.isHandRaised == false &&
          data.updatedAt == request.time;
    }

    function roomCreateAuthorityAllowed(roomId) {
      let expectedClubId = 'family_' + request.auth.uid;
      let familyPath = /databases/$(database)/documents/clubs/$(expectedClubId);
      let hostParticipantPath = /databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid);
      let ownerMemberPath = /databases/$(database)/documents/rooms/$(roomId)/roomMembers/$(request.auth.uid);
      let ordinary =
          !request.resource.data.keys().hasAny(['clubId', 'roomKind']) &&
          (
            (
              request.resource.data.roomType == 'temporary' &&
              request.resource.data.participantCount == 1 &&
              request.resource.data.memberCount == 0 &&
              request.resource.data.isLive == true &&
              existsAfter(hostParticipantPath) &&
              getAfter(hostParticipantPath).data.userId == request.auth.uid &&
              getAfter(hostParticipantPath).data.role == 'host'
            ) ||
            (
              request.resource.data.roomType == 'community' &&
              request.resource.data.participantCount == 0 &&
              request.resource.data.memberCount == 1 &&
              request.resource.data.isLive == false &&
              existsAfter(ownerMemberPath) &&
              getAfter(ownerMemberPath).data.userId == request.auth.uid &&
              getAfter(ownerMemberPath).data.role == 'owner'
            )
          );
      let family =
          (
            roomId == 'club_lounge_' + expectedClubId &&
            request.resource.data.clubId == expectedClubId &&
            request.resource.data.roomKind == 'clubLounge' &&
            request.resource.data.visibility == 'private' &&
            existsAfter(familyPath) &&
            getAfter(familyPath).data.ownerId == request.auth.uid &&
            getAfter(familyPath).data.type == 'family'
          );
      return ordinary || family;
    }

    function roomCreateShapeAllowed() {
      let data = request.resource.data;
      return data.keys().hasAll([
            'hostId', 'hostName', 'name', 'description', 'category',
            'visibility', 'language', 'maxParticipants',
            'participantCount', 'memberCount', 'isLive', 'roomType',
            'status', 'approvalRequired', 'slowModeSeconds',
            'autoMuteNewUsers', 'membersCanStartVoice', 'createdAt',
            'updatedAt'
          ]) &&
          data.keys().hasOnly([
            'hostId', 'hostName', 'hostPhotoUrl', 'name', 'description',
            'category', 'visibility', 'language', 'maxParticipants',
            'participantCount', 'memberCount', 'isLive', 'roomType',
            'status', 'imageUrl', 'approvalRequired', 'slowModeSeconds',
            'autoMuteNewUsers', 'membersCanStartVoice', 'createdAt',
            'updatedAt', 'experience', 'topic', 'audienceCanSpeak',
            'handRaisingEnabled', 'stageLimit', 'targetAudience',
            'topicTags', 'roomGuidelines', 'conversationStyle',
            'newcomerFriendly', 'showFormat', 'clubId', 'roomKind'
          ]) &&
          data.hostId == request.auth.uid &&
          displayNameMatchesCanonical(request.auth.uid, data.hostName) &&
          data.name is string &&
          data.name.size() >= 3 &&
          data.name.size() <= 100 &&
          data.description is string &&
          data.description.size() <= 1000 &&
          data.visibility in ['public', 'private'] &&
          data.roomType in ['temporary', 'community'] &&
          data.status == 'active' &&
          data.participantCount is int &&
          data.participantCount >= 0 &&
          data.memberCount is int &&
          data.memberCount >= 0 &&
          data.createdAt == request.time &&
          data.updatedAt == request.time;
    }

    function initialRoomOwnerMemberShape(data, memberId) {
      return data.keys().hasAll([
            'userId', 'displayName', 'role', 'joinedAt'
          ]) &&
          data.keys().hasOnly([
            'userId', 'displayName', 'photoUrl', 'role', 'joinedAt'
          ]) &&
          data.userId == request.auth.uid &&
          memberId == request.auth.uid &&
          displayNameMatchesCanonical(memberId, data.displayName) &&
          data.role == 'owner' &&
          data.joinedAt == request.time;
    }

    function roomParticipantJoinTransitionAllowed(roomId) {
      let participantPath = /databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid);
      return !exists(participantPath) &&
          existsAfter(participantPath) &&
          getAfter(participantPath).data.userId == request.auth.uid &&
          getAfter(participantPath).data.role == 'listener' &&
          getAfter(participantPath).data.isSpeaker == false &&
          getAfter(participantPath).data.isHandRaised == false &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['participantCount', 'updatedAt']) &&
          request.resource.data.participantCount ==
            resource.data.participantCount + 1 &&
          (
            resource.data.maxParticipants == null ||
            request.resource.data.participantCount <=
              resource.data.maxParticipants
          ) &&
          request.resource.data.updatedAt == request.time;
    }

    function roomParticipantLeaveTransitionAllowed(roomId) {
      let participantPath = /databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid);
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return exists(participantPath) &&
          !existsAfter(participantPath) &&
          resource.data.participantCount > 0 &&
          request.resource.data.participantCount ==
            resource.data.participantCount - 1 &&
          request.resource.data.updatedAt == request.time &&
          (
            changed.hasOnly(['participantCount', 'updatedAt']) ||
            (
              changed.hasOnly([
                'participantCount', 'isLive', 'endedAt', 'updatedAt'
              ]) &&
              resource.data.get('roomKind', '') == 'clubLounge' &&
              request.resource.data.participantCount == 0 &&
              request.resource.data.isLive == false &&
              request.resource.data.endedAt == request.time
            )
          );
    }

    function roomMemberJoinTransitionAllowed(roomId) {
      let memberPath = /databases/$(database)/documents/rooms/$(roomId)/roomMembers/$(request.auth.uid);
      return resource.data.visibility == 'public' &&
          resource.data.get('approvalRequired', false) == false &&
          resource.data.get('status', 'active') == 'active' &&
          !exists(memberPath) &&
          existsAfter(memberPath) &&
          getAfter(memberPath).data.userId == request.auth.uid &&
          getAfter(memberPath).data.role == 'member' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberCount', 'updatedAt']) &&
          request.resource.data.memberCount == resource.data.memberCount + 1 &&
          request.resource.data.updatedAt == request.time;
    }

    // The mirror image of roomMemberJoinTransitionAllowed: the caller's own
    // membership row must be gone once this commit lands, which is what ties
    // the counter to a real departure rather than to a claim of one.
    //
    // This keeps memberCount ACCURATE. It is deliberately not what makes
    // leaving POSSIBLE — the delete rule stands on its own, so a room whose
    // counter has drifted, sits at zero, or predates the field entirely can
    // still be left. An earlier version of this ruleset made the counter a
    // precondition for removal and turned every drifted room into a trap.
    //
    // The freeze guards match roomMemberJoinTransitionAllowed's: a staff
    // suspension stops the room's own state from moving, including the
    // updatedAt that orders watchMyCommunities. Members of a frozen room
    // still leave; what they lose is the counter write, not the exit.
    function roomMemberLeaveTransitionAllowed(roomId) {
      let memberPath = /databases/$(database)/documents/rooms/$(roomId)/roomMembers/$(request.auth.uid);
      return exists(memberPath) &&
          !existsAfter(memberPath) &&
          resource.data.get('status', 'active') == 'active' &&
          resource.data.get('deletionInProgress', false) != true &&
          resource.data.get('memberCount', 0) > 0 &&
          request.resource.data.memberCount ==
            resource.data.get('memberCount', 0) - 1 &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberCount', 'updatedAt']) &&
          request.resource.data.updatedAt == request.time;
    }

    // ROOM RECENCY — the room-root `updatedAt` bump that follows every chat
    // message.
    //
    // sendRoomMessage() (room_service.dart) writes the message and then bumps
    // the room root's `updatedAt`, because that field is what
    // watchPublicRooms() and watchMyCommunities() sort the Home feeds on. The
    // HOST branch has always accepted a bare `updatedAt`: it sits in
    // hostRoomUpdateAllowed()'s metadata allowlist and `changed.hasOnly`
    // passes on a single key. The non-host branch accepted no such transition
    // at all — not a join, not a leave, not a voice start — so every non-host
    // message landed and THEN was refused, and room ordering never advanced
    // from anyone's conversation but the host's. The defect was the
    // ASYMMETRY, not the transition; this restores the missing half.
    //
    // WHO MAY BUMP is deliberately the same expression that decides who may
    // POST, copied verbatim from `match /messages`'s create rule below so the
    // two cannot drift: if you may add a message to this room's chat, you may
    // move the marker that says the chat moved. That is strictly LESS
    // authority than posting. The message is content every other member
    // reads; `updatedAt` is a derived ordering hint, and no rule in this file
    // reads it as a precondition for anything — which is the ADR-056 lesson
    // (never let a room-root field a participant can write become a gate) and
    // must stay true. isRoomHost() is retained in the disjunction even though
    // the ternary selector routes hosts elsewhere, precisely so this stays a
    // character-for-character copy of the create rule.
    //
    // ACCOUNT STATUS IS RE-STATED HERE, not inherited. docs/SECURITY.md
    // principle 9: a branch selector is an authorization condition and does
    // not inherit its helpers' checks. canCommunicate() calls
    // isActiveAccount(), so a banned, disabled or communication-muted account
    // cannot bump for exactly the same reason it cannot post, and isVerified()
    // mirrors the create rule's own gate.
    //
    // hasOnly(['updatedAt']) is what keeps this from becoming a lever: no
    // counter, no visibility flip, no isLive, no hostId can ride along. The
    // remaining room preconditions are copied from hostRoomUpdateAllowed()'s
    // metadata branch, so a host and a participant reach this transition under
    // identical room conditions — which is the symmetry the fix is about.
    //
    // Evaluated FIRST in the non-host disjunction on purpose. Its opening
    // affectedKeys() test is field-only, so a join/leave/voice-start write
    // (which always moves a counter or isLive too) falls through at zero
    // document-access cost, and a bump short-circuits before the four
    // transition helpers spend reads on paths it does not need.
    function roomActivityTouchAllowed(roomId) {
      return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['updatedAt']) &&
          request.resource.data.updatedAt == request.time &&
          resource.data.get('status', 'active') in
            ['active', 'closed', 'archived'] &&
          resource.data.get('deletionInProgress', false) != true &&
          isVerified() &&
          canCommunicate() &&
          (
            (isRoomParticipant(roomId) && canAccessRoom(roomId)) ||
            isRoomMember(roomId) ||
            isRoomHost(roomId)
          );
    }

    function roomVoiceStartAllowed(roomId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.get('status', 'active') == 'active' &&
          resource.data.get('isLive', false) == false &&
          request.resource.data.isLive == true &&
          request.resource.data.updatedAt == request.time &&
          changed.hasOnly(['isLive', 'endedAt', 'updatedAt']) &&
          (
            (
              resource.data.get('clubId', '') is string &&
              resource.data.get('clubId', '').size() > 0 &&
              isActiveClubRoomMember(roomId)
            ) ||
            (
              resource.data.get('membersCanStartVoice', false) == true &&
              isRoomMember(roomId)
            )
          );
    }

    function hostParticipantJoinTransitionAllowed(roomId) {
      let participantPath = /databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid);
      return !exists(participantPath) &&
          existsAfter(participantPath) &&
          getAfter(participantPath).data.userId == request.auth.uid &&
          getAfter(participantPath).data.role == 'host' &&
          getAfter(participantPath).data.isSpeaker == true &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['participantCount', 'updatedAt']) &&
          request.resource.data.participantCount ==
            resource.data.participantCount + 1 &&
          request.resource.data.updatedAt == request.time;
    }

    // HOST AUTHORITY IS STILL ACCOUNT-STATUS GATED.
    //
    // Being the host is an ownership claim, not a licence — isRoomHost()
    // has always paired the two, and this branch is the one place room
    // ownership was read without it. Everything this function authorises is
    // real authority over other people's experience: the metadata every
    // member sees, the visibility flip that decides whether they can reach
    // the room at all, and the voice session itself. A banned or disabled
    // host kept all of it, which contradicted the ban model docs/SECURITY.md
    // states — reading the account-status document is what makes a ban
    // effective on the very next request, and this path never read it.
    //
    // isActiveAccount() leads so it short-circuits before the transition
    // helpers below do any further document reads.
    function hostRoomUpdateAllowed(roomId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let metadata = changed.hasOnly([
        'name', 'description', 'category', 'visibility', 'language',
        'maxParticipants', 'approvalRequired', 'slowModeSeconds',
        'autoMuteNewUsers', 'membersCanStartVoice', 'imageUrl',
        'topic', 'audienceCanSpeak', 'handRaisingEnabled',
        'stageLimit', 'targetAudience', 'topicTags', 'roomGuidelines',
        'conversationStyle', 'newcomerFriendly', 'showFormat', 'updatedAt'
      ]) &&
          request.resource.data.updatedAt == request.time &&
          resource.data.get('status', 'active') in
            ['active', 'closed', 'archived'] &&
          resource.data.get('deletionInProgress', false) != true &&
          (
            resource.data.get('roomKind', '') != 'clubLounge' ||
            request.resource.data.visibility == 'private'
          );
      let start = resource.data.get('status', 'active') == 'active' &&
          resource.data.get('isLive', false) == false &&
          request.resource.data.isLive == true &&
          request.resource.data.updatedAt == request.time &&
          changed.hasOnly(['isLive', 'endedAt', 'updatedAt']);
      return isActiveAccount() &&
          request.resource.data.hostId == resource.data.hostId &&
          request.resource.data.get('clubId', '') ==
            resource.data.get('clubId', '') &&
          request.resource.data.get('roomKind', '') ==
            resource.data.get('roomKind', '') &&
          request.resource.data.get('experience', 'community') ==
            resource.data.get('experience', 'community') &&
          (
            metadata || start ||
            hostParticipantJoinTransitionAllowed(roomId)
          );
    }

    function roomParticipantLeaveRootExists(roomId) {
      let roomPath = /databases/$(database)/documents/rooms/$(roomId);
      let beforeRoom = get(roomPath).data;
      let afterRoom = getAfter(roomPath).data;
      let changed = afterRoom.diff(beforeRoom).affectedKeys();
      return beforeRoom.participantCount > 0 &&
          afterRoom.participantCount == beforeRoom.participantCount - 1 &&
          afterRoom.updatedAt == request.time &&
          (
            changed.hasOnly(['participantCount', 'updatedAt']) ||
            (
              changed.hasOnly([
                'participantCount', 'isLive', 'endedAt', 'updatedAt'
              ]) &&
              beforeRoom.get('roomKind', '') == 'clubLounge' &&
              afterRoom.participantCount == 0 &&
              afterRoom.isLive == false &&
              afterRoom.endedAt == request.time
            )
          );
    }


    function clubExists(clubId) {
      return exists(
        /databases/$(database)/documents/clubs/$(clubId)
      );
    }

    function isClubMember(clubId) {
      let clubPath = /databases/$(database)/documents/clubs/$(clubId);
      let memberPath = /databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid);
      return isActiveAccount() &&
          exists(clubPath) &&
          exists(memberPath) &&
          get(memberPath).data.userId == request.auth.uid &&
          get(memberPath).data.get('banned', false) != true &&
          get(clubPath).data.status == 'active' &&
          get(clubPath).data.get('deletionInProgress', false) != true;
    }

    function isClubOwner(clubId) {
      return isSignedIn() && clubExists(clubId) &&
          get(
            /databases/$(database)/documents/clubs/$(clubId)
          ).data.ownerId == request.auth.uid;
    }

    // Creation writes the club, owner membership and default channels in one
    // atomic batch. getAfter() sees the club document as it will exist after
    // that batch; a plain get()/exists() only sees the pre-write database and
    // rejects an otherwise valid first owner/channel write.
    function isClubOwnerAfter(clubId) {
      return isSignedIn() &&
          !clubExists(clubId) &&
          getAfter(
            /databases/$(database)/documents/clubs/$(clubId)
          ).data.ownerId == request.auth.uid;
    }

    // Membership creation has exactly one persisted shape. Keeping this
    // allowlist at the authorization boundary prevents a modified client
    // from hiding permission-like fields in a membership document. Both the
    // invitation flow and createClub() use these seven fields today.
    function clubMemberCreateShapeAllowed(memberId) {
      return request.resource.data.keys().hasOnly([
            'userId', 'displayName', 'photoUrl', 'role', 'isOnline',
            'joinedAt', 'invitedBy'
          ]) &&
          request.resource.data.keys().hasAll([
            'userId', 'displayName', 'photoUrl', 'role', 'isOnline',
            'joinedAt', 'invitedBy'
          ]) &&
          request.resource.data.userId == memberId &&
          displayNameMatchesCanonical(
            memberId,
            request.resource.data.displayName
          ) &&
          (
            request.resource.data.photoUrl == null ||
            request.resource.data.photoUrl is string
          ) &&
          request.resource.data.isOnline is bool &&
          request.resource.data.joinedAt == request.time;
    }

    // users/{uid}/clubs/{clubId} is a private discovery/index mirror, never
    // membership authority. It used to be owner-writable without any
    // relationship to the real Club member document. Besides making the
    // owned-Club counter forgeable, that became a privilege path because the
    // profile identity fan-out enumerates this mirror. Keep every client
    // write tied to a real post-write membership and copy only its role and
    // join timestamp. getAfter() makes both createClub() and invite acceptance
    // work in their existing atomic batches.
    function userClubProjectionMatchesMembership(userId, clubId) {
      let memberPath = /databases/$(database)/documents/clubs/$(clubId)/members/$(userId);
      return request.resource.data.keys().hasOnly([
            'clubId', 'name', 'avatarUrl', 'role', 'joinedAt'
          ]) &&
          request.resource.data.keys().hasAll([
            'clubId', 'name', 'avatarUrl', 'role', 'joinedAt'
          ]) &&
          request.resource.data.clubId == clubId &&
          request.resource.data.name is string &&
          (
            request.resource.data.avatarUrl == null ||
            request.resource.data.avatarUrl is string
          ) &&
          existsAfter(memberPath) &&
          getAfter(memberPath).data.userId == userId &&
          request.resource.data.role == getAfter(memberPath).data.role &&
          request.resource.data.joinedAt ==
              getAfter(memberPath).data.joinedAt;
    }

    function clubJoinRootTransitionAllowed(beforeClub, afterClub) {
      return afterClub.diff(beforeClub).affectedKeys().hasOnly([
            'memberCount', 'onlineCount', 'updatedAt'
          ]) &&
          afterClub.memberCount == beforeClub.memberCount + 1 &&
          afterClub.onlineCount == beforeClub.onlineCount + 1 &&
          afterClub.updatedAt == request.time;
    }

    // Used while authorizing the membership create, where resource/request
    // refer to the member document rather than the root Club document.
    function clubJoinRootTransitionExists(clubId) {
      let clubPath = /databases/$(database)/documents/clubs/$(clubId);
      return get(clubPath).data.get('deletionInProgress', false) != true &&
          get(clubPath).data.status == 'active' &&
          clubJoinRootTransitionAllowed(
        get(clubPath).data,
        getAfter(clubPath).data
      );
    }

    function invitedClubMemberCreateAllowed(clubId, memberId) {
      let invitePath = /databases/$(database)/documents/clubs/$(clubId)/invites/$(memberId);
      let invite = get(invitePath).data;
      return invite.inviteeId == memberId &&
          invite.status == 'pending' &&
          request.resource.data.role == 'member' &&
          request.resource.data.invitedBy == invite.inviterId &&
          !existsAfter(invitePath) &&
          clubJoinRootTransitionExists(clubId);
    }

    function ownerClubMemberCreateAllowed(clubId) {
      return request.resource.data.role == 'owner' &&
          request.resource.data.invitedBy == null &&
          isClubOwnerAfter(clubId);
    }

    function hasPendingClubInvite(clubId, userId) {
      let clubPath = /databases/$(database)/documents/clubs/$(clubId);
      return isActiveAccount() &&
          userId == request.auth.uid &&
          exists(clubPath) &&
          get(clubPath).data.status == 'active' &&
          get(clubPath).data.get('deletionInProgress', false) != true &&
          exists(
        /databases/$(database)/documents/clubs/$(clubId)/invites/$(userId)
      ) && get(
        /databases/$(database)/documents/clubs/$(clubId)/invites/$(userId)
      ).data.inviteeId == userId;
    }

    // The invitee may bump Club counters only as one atomic acceptance
    // transition. A pending invite alone is not a reusable update token:
    // the membership must be newly created as a plain member and the invite
    // must be consumed in the same batch. The root Club write is limited to
    // the exact fields written by ClubService.acceptClubInvite().
    function invitedClubJoinUpdateAllowed(clubId) {
      let memberPath = /databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid);
      let invitePath = /databases/$(database)/documents/clubs/$(clubId)/invites/$(request.auth.uid);
      return hasPendingClubInvite(clubId, request.auth.uid) &&
          resource.data.get('deletionInProgress', false) != true &&
          resource.data.get('status', 'active') == 'active' &&
          !exists(memberPath) &&
          existsAfter(memberPath) &&
          getAfter(memberPath).data.userId == request.auth.uid &&
          getAfter(memberPath).data.role == 'member' &&
          !existsAfter(invitePath) &&
          clubJoinRootTransitionAllowed(
            resource.data,
            request.resource.data
          );
    }

    // Club managers used to inherit an unrestricted root update, which made
    // denormalized counters, default channel ids and other authority-adjacent
    // fields client-controlled. The product exposes metadata editing only to
    // owner/co-owner, and ClubService writes exactly these five fields.
    function canEditClubMetadata(clubId) {
      return isClubMember(clubId) &&
          clubRole(clubId) in ['owner', 'coOwner'];
    }

    function clubMetadataUpdateAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'description', 'defaultLanguage', 'privacy', 'updatedAt'
          ]) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() >= 3 &&
          request.resource.data.name.size() <= 40 &&
          request.resource.data.description is string &&
          request.resource.data.description.size() <= 220 &&
          request.resource.data.defaultLanguage is string &&
          request.resource.data.defaultLanguage.size() > 0 &&
          request.resource.data.defaultLanguage.size() <= 64 &&
          request.resource.data.privacy in ['public', 'private', 'inviteOnly'] &&
          request.resource.data.updatedAt == request.time;
    }

    function familyClubCreateAllowed(clubId) {
      let data = request.resource.data;
      let ownerMemberPath = /databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid);
      let ownerProjectionPath = /databases/$(database)/documents/users/$(request.auth.uid)/clubs/$(clubId);
      let chatChannelPath = /databases/$(database)/documents/clubs/$(clubId)/channels/$(data.defaultChatChannelId);
      let announcementChannelPath = /databases/$(database)/documents/clubs/$(clubId)/channels/$(data.announcementChannelId);
      let voiceChannelPath = /databases/$(database)/documents/clubs/$(clubId)/channels/$(data.defaultVoiceChannelId);
      let loungeRoomPath = /databases/$(database)/documents/rooms/$(data.loungeRoomId);
      return data.keys().hasOnly([
            'name', 'description', 'ownerId', 'ownerName', 'avatarUrl',
            'bannerUrl', 'privacy', 'type', 'status', 'defaultLanguage',
            'memberCount', 'onlineCount', 'defaultChatChannelId',
            'defaultVoiceChannelId', 'loungeRoomId',
            'announcementChannelId', 'createdAt', 'updatedAt'
          ]) &&
          data.keys().hasAll([
            'name', 'description', 'ownerId', 'ownerName', 'avatarUrl',
            'bannerUrl', 'privacy', 'type', 'status', 'defaultLanguage',
            'memberCount', 'onlineCount', 'defaultChatChannelId',
            'defaultVoiceChannelId', 'loungeRoomId',
            'announcementChannelId', 'createdAt', 'updatedAt'
          ]) &&
          data.ownerId == request.auth.uid &&
          data.type == 'family' &&
          data.status == 'active' &&
          data.privacy == 'inviteOnly' &&
          data.name is string &&
          data.name.size() >= 3 &&
          data.name.size() <= 40 &&
          data.description is string &&
          data.description.size() <= 220 &&
          data.ownerName is string &&
          data.ownerName.size() > 0 &&
          displayNameMatchesCanonical(request.auth.uid, data.ownerName) &&
          data.defaultLanguage is string &&
          data.defaultLanguage.size() > 0 &&
          data.defaultLanguage.size() <= 64 &&
          data.avatarUrl == null &&
          data.bannerUrl == null &&
          data.memberCount == 1 &&
          data.onlineCount == 1 &&
          data.defaultChatChannelId is string &&
          data.defaultChatChannelId.size() > 0 &&
          data.defaultVoiceChannelId is string &&
          data.defaultVoiceChannelId.size() > 0 &&
          data.announcementChannelId is string &&
          data.announcementChannelId.size() > 0 &&
          data.loungeRoomId == 'club_lounge_' + clubId &&
          data.createdAt == request.time &&
          data.updatedAt == request.time &&
          // A canonical Family root without its ownership and navigation
          // graph cannot be repaired by the client: every later create sees
          // an existing deterministic root. Require the entire production
          // graph in this same atomic batch so a modified or interrupted
          // client cannot permanently reserve the one allowed id.
          existsAfter(ownerMemberPath) &&
          getAfter(ownerMemberPath).data.userId == request.auth.uid &&
          getAfter(ownerMemberPath).data.role == 'owner' &&
          existsAfter(ownerProjectionPath) &&
          getAfter(ownerProjectionPath).data.clubId == clubId &&
          getAfter(ownerProjectionPath).data.role == 'owner' &&
          getAfter(ownerProjectionPath).data.avatarUrl == null &&
          existsAfter(chatChannelPath) &&
          getAfter(chatChannelPath).data.type == 'chat' &&
          getAfter(chatChannelPath).data.createdBy == request.auth.uid &&
          existsAfter(announcementChannelPath) &&
          getAfter(announcementChannelPath).data.type == 'announcement' &&
          getAfter(announcementChannelPath).data.createdBy == request.auth.uid &&
          existsAfter(voiceChannelPath) &&
          getAfter(voiceChannelPath).data.type == 'voice' &&
          getAfter(voiceChannelPath).data.createdBy == request.auth.uid &&
          getAfter(voiceChannelPath).data.roomId == data.loungeRoomId &&
          existsAfter(loungeRoomPath) &&
          getAfter(loungeRoomPath).data.clubId == clubId &&
          getAfter(loungeRoomPath).data.hostId == request.auth.uid &&
          getAfter(loungeRoomPath).data.imageUrl == null &&
          getAfter(loungeRoomPath).data.roomKind == 'clubLounge';
    }

    function clubRole(clubId) {
      return get(
        /databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid)
      ).data.role;
    }

    function canManageClub(clubId) {
      return isClubMember(clubId) &&
          clubRole(clubId) in ['owner', 'coOwner', 'admin'];
    }

    function publicProfileSchemaIsExact(userId) {
      let data = resource.data;
      return data.keys().hasAll([
            'uid', 'displayName', 'username', 'displayNameSearch',
            'usernameSearch', 'photoUrl', 'bannerUrl', 'bio', 'country',
            'nativeLanguage', 'spokenLanguages', 'learningLanguages',
            'website', 'statusMessage', 'accountType', 'premiumIdentity',
            'friendCount', 'followerCount', 'followingCount',
            'schemaVersion', 'updatedAt'
          ]) &&
          data.keys().hasOnly([
            'uid', 'displayName', 'username', 'displayNameSearch',
            'usernameSearch', 'photoUrl', 'bannerUrl', 'bio', 'country',
            'nativeLanguage', 'spokenLanguages', 'learningLanguages',
            'website', 'statusMessage', 'accountType', 'premiumIdentity',
            'friendCount', 'followerCount', 'followingCount',
            'schemaVersion', 'updatedAt'
          ]) &&
          data.uid == userId &&
          data.displayName is string &&
          data.username is string &&
          data.displayNameSearch is string &&
          data.usernameSearch is string &&
          (data.photoUrl == null || data.photoUrl is string) &&
          (data.bannerUrl == null || data.bannerUrl is string) &&
          data.bio is string &&
          data.country is string &&
          data.nativeLanguage is string &&
          data.spokenLanguages is list &&
          data.learningLanguages is list &&
          (data.website == null || data.website is string) &&
          data.statusMessage is string &&
          data.accountType in ['personal', 'creator', 'official'] &&
          data.premiumIdentity is bool &&
          data.friendCount is int && data.friendCount >= 0 &&
          data.followerCount is int && data.followerCount >= 0 &&
          data.followingCount is int && data.followingCount >= 0 &&
          data.schemaVersion == 1 &&
          data.updatedAt is timestamp;
    }

    function socialPresenceSchemaIsExact(userId) {
      let data = resource.data;
      return data.keys().hasAll([
            'uid', 'isOnline', 'lastSeen', 'schemaVersion', 'updatedAt'
          ]) &&
          data.keys().hasOnly([
            'uid', 'isOnline', 'lastSeen', 'schemaVersion', 'updatedAt'
          ]) &&
          data.uid == userId &&
          data.isOnline is bool &&
          (data.lastSeen == null || data.lastSeen is timestamp) &&
          data.schemaVersion == 1 &&
          data.updatedAt is timestamp;
    }

    function canonicalFriendshipGuard(ownerId, friendId) {
      let guardPath = /databases/$(database)/documents/friendshipGuards/$(ownerId)/friends/$(friendId);
      return exists(guardPath) &&
          get(guardPath).data.keys().hasAll([
            'ownerId', 'friendId', 'schemaVersion', 'establishedAt'
          ]) &&
          get(guardPath).data.keys().hasOnly([
            'ownerId', 'friendId', 'schemaVersion', 'establishedAt'
          ]) &&
          get(guardPath).data.ownerId == ownerId &&
          get(guardPath).data.friendId == friendId &&
          get(guardPath).data.schemaVersion == 1 &&
          get(guardPath).data.establishedAt is timestamp;
    }

    // A manager's role change is ONE update carrying role + roleUpdatedAt +
    // roleUpdatedBy — that is what ClubService.updateMemberRole() writes in
    // the deployed client and in this tree's client alike. An allowlist that
    // named only ['role','updatedAt'] denied every promotion and demotion in
    // the product, so the field list has to match the real write.
    //
    // Widening the FIELD set is not widening PRIVILEGE, and this function is
    // where that stays true: the two new fields are attribution, so each is
    // pinned to a value the caller cannot choose — the acting uid and the
    // server clock. A manager can change someone's role (the surrounding
    // power checks decide whether), but cannot sign that change as another
    // moderator or date it to a time that suits them.
    //
    // Those two checks are deliberately NOT gated on affectedKeys(), and
    // that distinction is the whole security of this function: diff()
    // reports only fields whose VALUE changed, so a guard hanging off
    // hasAny() is skipped exactly when it matters. A manager resending the
    // PREVIOUS manager's uid unchanged, or omitting attribution entirely,
    // changes a role while the audit trail keeps naming somebody else —
    // both were live until this comment was written. Whenever `role`
    // moves, the post-write document itself must carry this caller's uid
    // and this request's timestamp, present or not, changed or not.
    // `updatedAt` stays accepted for the plain profile-sync path that
    // shares this document.
    function clubRoleChangeFieldsAllowed() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
            'role', 'roleUpdatedAt', 'roleUpdatedBy', 'updatedAt'
          ]) &&
          (
            !changed.hasAny(['role']) ||
            (
              request.resource.data.roleUpdatedBy == request.auth.uid &&
              request.resource.data.roleUpdatedAt == request.time
            )
          ) &&
          (
            !changed.hasAny(['roleUpdatedBy']) ||
            request.resource.data.roleUpdatedBy == request.auth.uid
          ) &&
          (
            !changed.hasAny(['roleUpdatedAt']) ||
            request.resource.data.roleUpdatedAt == request.time
          ) &&
          (
            !changed.hasAny(['updatedAt']) ||
            request.resource.data.updatedAt == request.time
          );
    }

    function clubRolePower(role) {
      return role == 'owner' ? 60 :
          role == 'coOwner' ? 50 :
          role == 'admin' ? 40 :
          role == 'moderator' ? 30 :
          role == 'member' ? 20 : 10;
    }

    // Explicit, revocable permission for the marketing site to publish a
    // minimal account label. This document contains no profile data itself;
    // the Admin-only scheduler revalidates the active public projection and
    // private account status before copying displayName/accountType. Activity
    // is a separate opt-in and cannot be enabled without profile publication.
    function marketingConsentSchemaIsExact() {
      return request.resource.data.keys().hasOnly([
            'schemaVersion', 'showProfileOnWebsite',
            'showActivityOnWebsite', 'updatedAt'
          ]) &&
          request.resource.data.keys().hasAll([
            'schemaVersion', 'showProfileOnWebsite',
            'showActivityOnWebsite', 'updatedAt'
          ]) &&
          request.resource.data.schemaVersion == 1 &&
          request.resource.data.showProfileOnWebsite is bool &&
          request.resource.data.showActivityOnWebsite is bool &&
          (
            request.resource.data.showActivityOnWebsite == false ||
            request.resource.data.showProfileOnWebsite == true
          ) &&
          request.resource.data.updatedAt == request.time;
    }

    // Club publication is bound to the owner who granted it. Requiring both
    // ids in the exact consent shape means an ownership transfer invalidates
    // the old grant in the publisher instead of silently inheriting consent.
    function clubMarketingConsentSchemaIsExact(clubId) {
      return request.resource.data.keys().hasOnly([
            'schemaVersion', 'clubId', 'ownerId', 'showOnWebsite',
            'updatedAt'
          ]) &&
          request.resource.data.keys().hasAll([
            'schemaVersion', 'clubId', 'ownerId', 'showOnWebsite',
            'updatedAt'
          ]) &&
          request.resource.data.schemaVersion == 1 &&
          request.resource.data.clubId == clubId &&
          request.resource.data.ownerId == request.auth.uid &&
          request.resource.data.showOnWebsite is bool &&
          request.resource.data.updatedAt == request.time;
    }

    function ownsMarketingClub(clubId) {
      return isSignedIn() &&
          exists(/databases/$(database)/documents/clubs/$(clubId)) &&
          get(/databases/$(database)/documents/clubs/$(clubId))
            .data.ownerId == request.auth.uid;
    }

    match /marketingConsents/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update: if isOwner(userId) &&
          marketingConsentSchemaIsExact();
      // Withdrawal stays available even if the account has since been
      // restricted. Publication still independently rejects inactive users.
      allow delete: if isOwner(userId);
    }

    match /clubMarketingConsents/{clubId} {
      allow get: if ownsMarketingClub(clubId);
      allow list: if false;
      allow create, update: if ownsMarketingClub(clubId) &&
          clubMarketingConsentSchemaIsExact(clubId);
      allow delete: if ownsMarketingClub(clubId);
    }

    // A second pinned, server-owned document for the consent-backed marketing
    // showcase. The payload is deliberately not merged with publicStats/live:
    // it has a different privacy contract and a much shorter validity window.
    // Anonymous callers may fetch this exact id but cannot enumerate siblings,
    // reach subcollections or write any part of the projection.
    match /publicShowcase/live {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Monotonic privacy generation used by the server publisher to reject a
    // stale showcase build after somebody hides their profile. It is neither
    // public product data nor owner configuration; Admin SDK only.
    match /privateShowcaseControl/{controlId} {
      allow read, write: if false;
    }

    // ONE OF THE TWO PINNED DOCUMENTS A STRANGER CAN READ.
    //
    // `publicStats/live` is a server-owned aggregate written by
    // publishPublicStatsSchedule (functions/stats/public_stats.js) through the
    // Admin SDK, which bypasses security rules entirely. The `if false` writes
    // below constrain every CLIENT; they are not a constraint on the writer.
    //
    // THE PINNED ID IS THE CONTAINMENT, AND THAT IS MEASURED, NOT ASSUMED.
    // The proposal for this block was `match /publicStats/{statsId} { allow
    // read: if true; }`. That variant was compiled and run against the
    // emulator: an anonymous stranger's `getDocs(collection('publicStats'))`
    // SUCCEEDS under it and returns every sibling document, not just this one.
    // Pinning the id is what refuses that — the same variant with `allow read`
    // but a pinned `live` still denies the list. Both runs are pinned as
    // executable cases in firestore-tests/rules.test.js (ADR-007, ADR-060).
    // Consequence: a future public statistic is a deliberate edit to this
    // file, and `publicStats/anythingElse` matches no rule at all.
    //
    // `get` rather than `read` is therefore the narrower grant, not the
    // mechanism: `read` is `get` + `list`, the only consumer (the marketing
    // site's LiveStats component) reads this document by id, and nothing in
    // the product ever needs to enumerate this collection. `allow list: if
    // false` is likewise inert against the shipped pinned match — it earns its
    // place by becoming load-bearing the moment somebody widens `live` to a
    // wildcard, which is precisely the edit that would otherwise leak.
    //
    // The real boundary is NOT this rule, it is the payload. Everything the
    // scheduled function writes here is world-readable, unauthenticated,
    // forever. The document must therefore stay aggregate-only: integers and a
    // server timestamp, with no uid, room id, display name or any other value
    // that could be joined back to a person. Adding a field here is a
    // publication decision; functions/test/public_stats.test.js pins the exact
    // key set so one cannot be added by accident.
    //
    // Narrowing this further is possible only once Firebase App Check is
    // enforced (ADR-004 keeps enforcement deliberately off). Until then an
    // anonymous marketing-site visitor and an arbitrary script are the same
    // caller, and any auth condition here would break the feature rather than
    // protect it.
    match /publicStats/live {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Public identity is an exact, server-owned projection. Ordinary clients
    // may fetch one known profile id, but may never enumerate the collection;
    // discovery goes through the bounded searchPublicProfiles callable, which
    // also filters both directions of the private block graph. No client can
    // create, extend or overwrite this schema.
    match /publicProfiles/{userId} {
      // Checking the private source as well as the projection closes the
      // trigger's eventual-consistency window after a ban/disable/delete.
      allow get: if canReadFullProfile(userId) &&
          publicProfileSchemaIsExact(userId);
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Presence is not public profile data. It is projected separately and is
    // visible only to the account itself or a fully mirrored friendship. A
    // missing half of the server-owned friendship fails closed.
    match /socialPresence/{userId} {
      allow get: if isActiveAccount() && accountIsActive(userId) &&
          socialPresenceSchemaIsExact(userId) &&
          (
            isOwner(userId) ||
            (
              canonicalFriendshipGuard(request.auth.uid, userId) &&
              canonicalFriendshipGuard(userId, request.auth.uid)
            )
          );
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Per-account Cloud Function abuse budgets. The Admin SDK is the only
    // reader/writer; exposing counters or reset times would help attackers
    // tune enumeration and would let clients reset their own quota.
    match /privateRateLimits/{limitId} {
      allow read, write: if false;
    }

    // Canonical friendship authority. Legacy users/*/friends mirrors remain
    // private list data, but only the Admin-SDK social callables can create
    // these exact guards after accepting a real pending request. No client
    // can forge or inspect them, and there is intentionally no blind backfill.
    match /friendshipGuards/{ownerId} {
      allow read, write: if false;

      match /friends/{friendId} {
        allow read, write: if false;
      }
    }

    match /users/{userId} {
      // The root user document is private account state. Owners retain their
      // own profile/settings/presence flow. Staff account-management uses
      // protected, field-picking callables; even a moderator or owner client
      // may not fetch a foreign raw record or enumerate this collection.
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if userCreateAllowed(userId);

      // Social graph counts are server authority. The callables in
      // functions/friends/social_graph.js update both edge mirrors and both
      // counters in one Admin transaction; allowing either party to update a
      // count directly would make profile numbers forgeable and let a partial
      // client batch drift from the graph.
      // NB: premiumIdentity is deliberately NOT in this allowlist — it is
      // the public mirror of the server-managed entitlement and may only
      // be written by Cloud Functions (Admin SDK bypasses rules).
      allow update: if isSignedIn() &&
          (
            isOwner(userId)
              ? (request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly([
                    'uid', 'email', 'displayName', 'username', 'photoUrl',
                    'bannerUrl', 'bio', 'country', 'nativeLanguage',
                    'spokenLanguages', 'learningLanguages', 'website',
                    'statusMessage',
                    'accountType', 'profileUpdatedAt',
                    'isOnline', 'lastSeen', 'presenceUpdatedAt',
                    'messageCount',
                    'roomCount', 'communityCount', 'voiceMinutes',
                    'reactionCount', 'hostMinutes', 'activeDays',
                    'momentCount', 'unlockedTitleIds',
                    'unlockedTitleTimestamps', 'selectedTitleId',
                    'achievementsUpdatedAt',
                    'notificationPreferences', 'messagePrivacy',
                  ]) && accountTypeChangeAllowed())
                  && displayNameChangeAllowed()
                  && messagePrivacyChangeAllowed()
              : false
          );

      allow delete: if false;

      match /friendRequests/{senderId} {
        // getRelationshipStatus() (friend_service.dart) checks whether the
        // CALLER previously sent a request by reading
        // users/{otherUserId}/friendRequests/{callerUid} — i.e. the sender
        // reading a doc that lives under the *recipient's* subcollection.
        // Recipient-only read left that permanently denied for the sender's
        // own outgoing-request check.
        allow read: if isActiveAccount() &&
            request.auth.uid in [userId, senderId] &&
            accountIsActive(userId) &&
            accountIsActive(senderId);
        allow create, update, delete: if false;
      }

      match /blocked/{blockedUserId} {
        // Deliberately owner-only in both directions — nobody, including
        // the blocked user, can read who's on this list. The friendRequests
        // create rule above enforces the block via exists() checks, which
        // don't require this rule to grant any read access.
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }

      // Mirror of friendRequests, keyed from the sender's side
      // (friend_service.dart writes both so each party can see their own
      // pending list without a collection-group query). Missing from the
      // rules entirely before this — every sendFriendRequest() call failed.
      match /sentFriendRequests/{receiverId} {
        allow read: if isActiveAccount() && isOwner(userId) &&
            accountIsActive(receiverId);
        allow create, update, delete: if false;
      }

      match /friends/{friendId} {
        allow read: if isActiveAccount() && isOwner(userId) &&
            accountIsActive(friendId);
        allow create, update, delete: if false;
      }

      // follow_service.dart — no rules existed for either subcollection
      // before this, so follow()/unfollow() failed outright.
      match /following/{targetUserId} {
        allow read: if isActiveAccount() && accountIsActive(userId) &&
            accountIsActive(targetUserId) &&
            resource.data.keys().hasAll(['uid', 'followedAt']) &&
            resource.data.keys().hasOnly(['uid', 'followedAt']) &&
            resource.data.uid == targetUserId &&
            resource.data.followedAt is timestamp;
        allow create, update, delete: if false;
      }

      match /followers/{followerId} {
        allow read: if isActiveAccount() && accountIsActive(userId) &&
            accountIsActive(followerId) &&
            resource.data.keys().hasAll(['uid', 'followedAt']) &&
            resource.data.keys().hasOnly(['uid', 'followedAt']) &&
            resource.data.uid == followerId &&
            resource.data.followedAt is timestamp;
        allow create, update, delete: if false;
      }

      // The personal mute list: hides that user's content for THIS
      // account only. A preference, never a sanction — the muted person
      // is unaffected and unaware.
      match /muted/{mutedId} {
        allow read, write: if isOwner(userId);
      }

      match /clubs/{clubId} {
        allow read: if isOwner(userId);
        allow create, update: if
            (isOwner(userId) || canManageClub(clubId)) &&
            userClubProjectionMatchesMembership(userId, clubId);
        // Membership removal is an Admin transaction now. Denying direct
        // deletion keeps the canonical member, root counters and this private
        // projection from being split across partially authorized writes.
        allow delete: if false;
      }

      // Every notification is server-derived from an authoritative source
      // document or written inside its owning callable transaction. Clients
      // can acknowledge/delete their own rows, but can never create one —
      // including Club/room invites and mentions.
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create: if false;
        // bellSuppressed in the owner-update set exists for the legacy
        // backfill (stamping `false` onto pre-field docs so the indexed
        // bell query covers them). Owner-only and bool-only; an owner
        // "suppressing" their own record is self-harm, not an attack.
        allow update: if isOwner(userId) &&
            request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['isRead', 'readAt', 'bellSuppressed']) &&
            (!('bellSuppressed' in request.resource.data) ||
              request.resource.data.bellSuppressed is bool);
        allow delete: if isOwner(userId);
      }

      // One doc per registered device. Only the Admin SDK (push-send Cloud
      // Function) ever reads across users' tokens; clients only manage
      // their own.
      match /fcmTokens/{token} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
            isActiveAccount() &&
            request.resource.data.keys().hasOnly(['platform', 'updatedAt']) &&
            request.resource.data.keys().hasAll(['platform', 'updatedAt']) &&
            request.resource.data.platform in ['ios', 'android', 'web', 'other'] &&
            request.resource.data.updatedAt == request.time;
        allow delete: if isOwner(userId);
      }
    }

    match /conversations/{conversationId} {
      // get is split from list to keep the missing-doc read working for
      // INSTALLS ALREADY IN THE WILD. Current clients never take this
      // path — openOrCreateConversation now always goes through
      // `openDirectConversation` (ADR-062) — but older builds still run a
      // transaction.get() on `uidA_uidB` before attempting the create.
      // A single read rule that dereferenced resource.data on that
      // missing doc was a rule EVALUATION ERROR, and those surfaced on
      // web as the boxed "Dart exception thrown from converted Future"
      // text rather than anything a user could act on. Letting the get
      // succeed and the create below fail gives those old installs a
      // clean, mappable `permission-denied` instead. For missing docs the
      // get is allowed only when the deterministic id (uidA_uidB, sorted)
      // contains the caller's own uid — so nobody can probe whether two
      // OTHER users have ever talked.
      allow get: if isSignedIn() &&
          (
            resource == null
              ? conversationId.matches(
                  '(^' + request.auth.uid + '_.*)|(.*_' + request.auth.uid + '$)'
                )
              : request.auth.uid in resource.data.participantIds
          );
      allow list: if isSignedIn() &&
          request.auth.uid in resource.data.participantIds;

      // Server-only, permanently. A conversation ROOT asserts three
      // things the client does not own and cannot be trusted to state:
      //   1. the OTHER participant's display name and photo, which are
      //      server-derived from their public profile
      //      (`canonicalPublicProfile`, ADR-054) — a client-authored root
      //      would put up to 80 characters of attacker-chosen text into
      //      `participantNames[victim]`, rendered in the victim's own chat
      //      list, reopening exactly the boundary ADR-054 closed;
      //   2. BOTH participants' `unreadCounts` and `readSequences`
      //      cursors, including the other party's;
      //   3. which document id is THE thread for that pair, forever, via
      //      `directConversationPairs/{pairKey}`.
      // `openDirectConversation` (functions/messaging/direct_integrity.js:
      // 421-453) is the sole writer of the root AND of its
      // `directConversationPairs` twin, creating both in one transaction.
      // They are two halves of one atomic binding, which is why one cannot
      // be client-writable while the other is default-denied: a root
      // without its guard is a thread the server refuses forever
      // (`data-loss`, "The canonical conversation is missing."). Legacy
      // roots predating the guard are adopted IN PLACE at their existing
      // id by `migrateDirectIntegrityConversation`, never forked. See
      // ADR-062.
      allow create: if false;

      allow update: if isSignedIn() &&
          request.auth.uid in resource.data.participantIds &&
          request.resource.data.participantIds == resource.data.participantIds;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isConversationParticipant(conversationId);
        allow create: if isVerified() &&
            isConversationParticipant(conversationId) &&
            request.resource.data.senderId == request.auth.uid &&
            !conversationBlocked(conversationId) &&
            canDirectMessage(
              request.auth.uid,
              get(
                /databases/$(database)/documents/conversations/$(conversationId)
              ).data.participantIds[0] == request.auth.uid
                ? get(
                    /databases/$(database)/documents/conversations/$(conversationId)
                  ).data.participantIds[1]
                : get(
                    /databases/$(database)/documents/conversations/$(conversationId)
                  ).data.participantIds[0]
            );

        // message_service.dart's editMessage/deleteMessage/toggleReaction/
        // markConversationRead all call update() on this path — this was
        // `if false` before, meaning all four were silently broken in
        // production despite the Dart implementation being correct. Three
        // distinct, narrowly-scoped update shapes, matching exactly what
        // those four methods actually write:
        allow update: if isConversationParticipant(conversationId) &&
            (
              // sender edits or soft-deletes (deleteMessage clears content/
              // mediaUrl/reactions and sets isDeleted, rather than an
              // actual delete, hence this being an update not a delete).
              (
                resource.data.senderId == request.auth.uid &&
                request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['content', 'editedAt', 'mediaUrl', 'isDeleted', 'reactions'])
              ) ||
              // any participant toggles only their OWN reaction key.
              (
                request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['reactions']) &&
                request.resource.data.reactions.diff(resource.data.reactions)
                    .affectedKeys().hasOnly([request.auth.uid])
              ) ||
              // any participant marks the message read by adding only
              // themselves to readBy — never removing entries, never
              // adding on someone else's behalf.
              (
                request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['readBy']) &&
                request.resource.data.readBy.hasAll(resource.data.readBy) &&
                request.resource.data.readBy.hasOnly(
                  resource.data.readBy.concat([request.auth.uid])
                )
              )
            );

        allow delete: if false;
      }
    }

    // Trusted subscription state. Written exclusively by Cloud Functions
    // (premium/entitlements.js); a client can read only its own document
    // and can never write, so premium cannot be self-granted.
    match /entitlements/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Stripe customer/subscription identifiers, anti-replay event receipts,
    // rate-limit counters and checkout serialization leases are backend-only.
    // Entitlements are the deliberately minimal owner-readable projection;
    // no client needs these operational billing records.
    match /billingAccounts/{userId} {
      allow read, write: if false;
    }
    match /billingRateLimits/{limitId} {
      allow read, write: if false;
    }
    match /billingCheckoutLocks/{userId} {
      allow read, write: if false;
    }
    match /stripeWebhookEvents/{eventId} {
      allow read, write: if false;
    }

    // One server-owned pointer to a creator's canonical published Voice
    // Moment. Public profile surfaces know the creator uid and may fetch that
    // exact document; collection scans would expose an unnecessary global
    // creator activity directory. setCreatorPinnedPost revalidates Premium,
    // Creator identity and Moment ownership in one Admin transaction.
    match /creatorPinnedPosts/{creatorId} {
      allow get: if isActiveAccount() && accountIsActive(creatorId) &&
          get(/databases/$(database)/documents/users/$(creatorId))
            .data.get('accountType', 'personal') in ['creator', 'official'] &&
          get(/databases/$(database)/documents/users/$(creatorId))
            .data.get('deleted', false) != true &&
          get(/databases/$(database)/documents/users/$(creatorId))
            .data.get('status', '') != 'deleted' &&
          userHasCreatorPremium(creatorId) &&
          resource.data.keys().hasAll([
            'schemaVersion', 'creatorId', 'momentId', 'pinnedAt',
            'updatedAt'
          ]) &&
          resource.data.keys().hasOnly([
            'schemaVersion', 'creatorId', 'momentId', 'pinnedAt',
            'updatedAt'
          ]) &&
          resource.data.schemaVersion == 1 &&
          resource.data.creatorId == creatorId &&
          resource.data.momentId is string &&
          resource.data.momentId.matches('^[A-Za-z0-9_-]{1,128}$') &&
          resource.data.pinnedAt is timestamp &&
          resource.data.updatedAt is timestamp;
      allow list: if false;
      allow write: if false;
    }

    // Server-only serialization locks for community Club ownership changes.
    // createCommunityClub and ownership-transfer callables touch these while
    // counting canonical Club roots in a transaction; no client value is an
    // input to the Premium quota decision.
    match /clubOwnershipGuards/{userId} {
      allow read, write: if false;
    }

    // The holder may see WHAT restricts them and until when; nobody may
    // write from a client. See isCommunicationMuted above.
    match /restrictions/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Complimentary VIP grants. Server-owned in exactly the same way
    // `entitlements` is: a client that could write here could grant
    // itself VIP, so no client writes at all. Readable by the holder so
    // the app can show WHY they have it (a complimentary grant is not a
    // paid subscription and must stay distinguishable).
    //
    // No production grants exist yet — this pass adds the boundary, not
    // the data.
    match /vipGrants/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // The public badge mirror: what everyone else is allowed to see about
    // someone's role and VIP status, written only by Cloud Functions.
    // Separate from `users/{uid}` so that making a badge public never
    // means making the rest of an account public, and readable by any
    // signed-in account because that is the point of a badge.
    match /publicBadges/{userId} {
      // GET only — a badge is looked up for a name already on screen.
      // Listing is refused so the collection cannot be used to enumerate
      // which accounts are staff or VIP; the batch path is the
      // getPublicBadges callable, which is bounded and authenticated.
      allow get: if isSignedIn();
      allow list: if false;
      allow write: if false;
    }

    // The staff user directory: a SERVER-ONLY search index (normalized
    // usernames/display names, emails, filter flags) written by Cloud
    // Functions and queried exclusively through the owner-only
    // searchUserDirectory callable. Any client read here would be a
    // user-enumeration oracle carrying emails, so there is none — not
    // even for the owner's own session.
    match /userDirectory/{userId} {
      allow read: if false;
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // GLOBAL CHAT — the single public channel shared by the whole
    // authenticated community. Deliberately a separate top-level
    // collection from `conversations` (private DMs) and from
    // clubs/*/channels/* (member-only), so a public message can never be
    // confused with, or queried alongside, a private one.
    //
    // There is exactly one channel, `main`, pinned by these rules rather
    // than left open, so nobody can create a parallel "global" channel
    // and pass it off as the real one. The `globalChat/main` PARENT
    // DOCUMENT is never required to exist: Firestore addresses a
    // subcollection independently of its parent, and nothing here reads
    // channel metadata. There is no manual provisioning step.
    // ---------------------------------------------------------------
    match /globalChat/{channelId} {
      // Global Chat has been retired from every production client. Keep the
      // historical collection available to Admin SDK moderation/export only;
      // no signed-in client, including staff or an old app build, may read or
      // mutate the parent, sender state, or message history.
      // The channel document holds nothing and is never written. Reading
      // it is harmless; creating one is not, because a second channel id
      // would be indistinguishable from the canonical one in a URL or a
      // screenshot.
      allow read: if false;
      allow write: if false;

      // Per-sender rate-limit state. This is the ONLY document a sender
      // may write besides the message itself, both must land in the same
      // commit, and the message rule verifies this document's
      // post-commit contents with getAfter(). Sending therefore REQUIRES
      // advancing this document, and advancing it requires both limits
      // below to allow it — every comparison against request.time, the
      // server's clock, never a client-supplied value.
      //
      //   floor    3s between messages   — stops flooding
      //   window   200 messages per FIXED one-hour window — stops a
      //            valid account sustaining 1,200/h (the floor's
      //            theoretical max)
      //
      // The window is FIXED (tumbling), not rolling: `windowStartAt` is
      // pinned at the first message of a window and stays put until a
      // full hour has passed from THAT instant, at which point the next
      // message opens a fresh window at a count of one. Nothing decays
      // continuously. The honest consequence is a boundary case — an
      // account may send 200 late in one window and 200 early in the
      // next, i.e. up to 400 across two adjacent hours — which is still
      // a 3x reduction on the floor's 1,200/h and costs far less than
      // the per-message bookkeeping a true sliding window would need.
      //
      // 200/h is ~3.3 a minute sustained, far above real conversation
      // and far below a useful spam volume; a human hitting it is
      // extraordinary, a script hitting it is the point.
      match /senders/{senderId} {
        allow read: if false;

        allow create: if false && isOwner(senderId) &&
            isActiveAccount() &&
            channelId == 'main' &&
            request.resource.data.keys().hasOnly([
              'lastMessageAt', 'lastMessageId', 'windowStartAt', 'windowCount'
            ]) &&
            request.resource.data.lastMessageAt == request.time &&
            request.resource.data.lastMessageId is string &&
            // A first-ever send opens the window at exactly one message.
            request.resource.data.windowStartAt == request.time &&
            request.resource.data.windowCount == 1;

        allow update: if false && isOwner(senderId) &&
            isActiveAccount() &&
            channelId == 'main' &&
            request.resource.data.keys().hasOnly([
              'lastMessageAt', 'lastMessageId', 'windowStartAt', 'windowCount'
            ]) &&
            request.resource.data.lastMessageAt == request.time &&
            request.resource.data.lastMessageId is string &&
            // 1. the per-message floor
            request.time > resource.data.lastMessageAt +
                duration.value(3, 's') &&
            // 2. the fixed window: either it is still running, in
            //    which case the count advances by exactly one and stays
            //    within the cap, or the hour has fully elapsed and the
            //    next message opens a new window at one.
            (
              request.time < resource.data.windowStartAt +
                      duration.value(1, 'h')
                ? (
                    request.resource.data.windowStartAt ==
                        resource.data.windowStartAt &&
                    request.resource.data.windowCount ==
                        resource.data.windowCount + 1 &&
                    request.resource.data.windowCount <= 200
                  )
                : (
                    request.resource.data.windowStartAt == request.time &&
                    request.resource.data.windowCount == 1
                  )
            );

        // Deleting would reset both limits, so it is never allowed.
        allow delete: if false;
      }

      match /messages/{messageId} {
        // Public to every ACTIVE signed-in account, and to nobody else.
        // Restriction is enforced on the account document rather than on
        // request.auth alone, because a banned user can still hold a
        // valid ID token for up to an hour.
        allow read: if false;

        // isVerified() reads request.auth.token.email_verified — the ID
        // token's own claim, which Firebase Auth sets and refreshes, so
        // it cannot be forged from a modified client the way a Firestore
        // profile field could. Publishing to the whole community is the
        // most outbound action in the product, so it follows the same
        // policy as DMs, rooms and Moments. READING stays open to
        // unverified accounts (see the read rule above): a new account
        // should be able to see the room it is joining.
        allow create: if false && isVerified() &&
            isActiveAccount() &&
            canCommunicate() &&
            channelId == 'main' &&
            // Exactly these fields, nothing smuggled alongside.
            request.resource.data.keys().hasOnly([
              'senderId', 'senderName', 'senderPhotoUrl', 'senderIsCreator',
              'senderIsStaff', 'content', 'sentAt', 'isDeleted', 'deletedBy',
              'deletedAt'
            ]) &&
            // Authorship and time are the server's, not the client's.
            request.resource.data.senderId == request.auth.uid &&
            request.resource.data.sentAt == request.time &&
            // Denormalised identity must match the sender's real profile
            // document, so a public feed cannot be used to impersonate
            // another member (or "YO Voice Support") by typing a name.
            request.resource.data.senderName ==
                get(/databases/$(database)/documents/users/$(request.auth.uid))
                  .data.displayName &&
            request.resource.data.senderIsCreator ==
                (get(/databases/$(database)/documents/users/$(request.auth.uid))
                  .data.get('accountType', 'personal') == 'creator') &&
            // Staff badge is the token claim, so it cannot be self-awarded.
            request.resource.data.senderIsStaff == isStaff() &&
            // Content: present, non-blank after trimming, bounded.
            request.resource.data.content is string &&
            request.resource.data.content.size() <= 500 &&
            request.resource.data.content.trim().size() > 0 &&
            // Nothing arrives pre-deleted.
            request.resource.data.isDeleted == false &&
            request.resource.data.deletedBy == null &&
            request.resource.data.deletedAt == null &&
            // Both rate limits: the sender's state must, after this same
            // commit, point at THIS message and THIS request's time. One
            // commit can only leave the document in one state, so a batch
            // of many messages can satisfy it for at most one of them.
            getAfter(
              /databases/$(database)/documents/globalChat/$(channelId)/senders/$(request.auth.uid)
            ).data.lastMessageAt == request.time &&
            getAfter(
              /databases/$(database)/documents/globalChat/$(channelId)/senders/$(request.auth.uid)
            ).data.lastMessageId == messageId;

        // Soft delete only, by the author or by platform staff. Content
        // and authorship are frozen: an author cannot rewrite history
        // after the fact, and a moderator cannot re-attribute a message.
        allow update: if false && isActiveAccount() &&
            (resource.data.senderId == request.auth.uid || isStaff()) &&
            request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['isDeleted', 'deletedBy', 'deletedAt', 'content']) &&
            request.resource.data.isDeleted == true &&
            request.resource.data.deletedBy == request.auth.uid &&
            request.resource.data.deletedAt == request.time &&
            request.resource.data.content == '' &&
            request.resource.data.senderId == resource.data.senderId &&
            request.resource.data.sentAt == resource.data.sentAt;

        // Hard delete is reserved for the Admin SDK (which bypasses
        // rules), so the public record always shows that something was
        // removed rather than silently losing it.
        allow delete: if false;
      }
    }

    // ---------------------------------------------------------------
    // ABUSE REPORTS. Write-only for members: you can file one, you can
    // never read, edit or withdraw one, and you cannot enumerate what
    // anyone else has reported. Staff read and triage them.
    //
    // UNIQUENESS is structural rather than checked: the document id must
    // be `{reporterId}_{targetType}_{targetId}`, so a second report of
    // the same thing by the same person is a create against an existing
    // document, which Firestore rejects on its own. No counter, no query,
    // nothing to race.
    //
    // Workflow fields (status, assignee, resolution) are NOT accepted on
    // create — staff add them later through the staff-only update rule,
    // so a reporter can never pre-close or self-assign a report.
    // ---------------------------------------------------------------
    match /reports/{reportId} {
      // Staff read the queue. Workflow mutations are NOT client writes:
      // triage is a privileged staff action, so it goes through the
      // `moderateReport` callable, which uses the Admin SDK and bypasses
      // these rules. Denying update/delete here means there is exactly
      // one path that can move a report's status, and it is the one that
      // checks the role, enforces transitions and writes the audit
      // record. Reporter-created evidence is immutable by construction.
      allow read: if isActiveStaff();
      allow update, delete: if false;

      // NOT gated on isVerified(), deliberately. isVerified() gates
      // outbound/spam-prone publishing (see its definition above);
      // reporting is a SAFETY action and sits with blocking, which that
      // policy explicitly leaves available to a freshly-registered
      // account. Someone being harassed on their first day must be able
      // to say so. Volume is bounded by the deterministic id, the 30s
      // cooldown and the 20-per-window cap instead.
      allow create: if isActiveAccount() &&
          // The id is the uniqueness mechanism.
          reportId == request.auth.uid + '_' +
              request.resource.data.targetType + '_' +
              request.resource.data.targetId &&
          request.resource.data.keys().hasOnly([
            'reporterId', 'targetType', 'targetId', 'reportedUserId',
            'contextPath', 'reason', 'note', 'createdAt', 'status'
          ]) &&
          request.resource.data.reporterId == request.auth.uid &&
          request.resource.data.createdAt == request.time &&
          // The ONLY workflow field a client may supply, pinned to the
          // one legal opening value. Assignment, resolution, the acting
          // moderator and every review timestamp are added later by
          // `moderateReport` through the Admin SDK — a reporter cannot
          // file something pre-claimed, pre-resolved or attributed to a
          // moderator who never touched it.
          request.resource.data.status == 'open' &&
          request.resource.data.reason in [
            'spam', 'harassment', 'hate', 'sexual', 'violence',
            'selfHarm', 'impersonation', 'other'
          ] &&
          request.resource.data.note is string &&
          request.resource.data.note.size() <= 300 &&
          request.resource.data.targetId is string &&
          request.resource.data.targetId.size() > 0 &&
          request.resource.data.targetId.size() <= 128 &&
          request.resource.data.reportedUserId is string &&
          request.resource.data.reportedUserId != request.auth.uid &&
          (
            request.resource.data.contextPath == null ||
            (
              request.resource.data.contextPath is string &&
              request.resource.data.contextPath.size() <= 300
            )
          ) &&
          // The target must EXIST, and reportedUserId must be the person
          // who actually owns it — otherwise the collection becomes a
          // free-text channel for naming arbitrary uids.
          (
            (
              request.resource.data.targetType == 'globalMessage' &&
              exists(/databases/$(database)/documents/globalChat/main/messages/$(request.resource.data.targetId)) &&
              request.resource.data.reportedUserId ==
                  get(/databases/$(database)/documents/globalChat/main/messages/$(request.resource.data.targetId))
                    .data.senderId
            ) ||
            (
              request.resource.data.targetType == 'user' &&
              exists(/databases/$(database)/documents/users/$(request.resource.data.targetId)) &&
              request.resource.data.reportedUserId ==
                  request.resource.data.targetId
            )
          ) &&
          // Rate limit, same shape as Global Chat's sender state.
          getAfter(
            /databases/$(database)/documents/reportLimits/$(request.auth.uid)
          ).data.lastReportAt == request.time &&
          getAfter(
            /databases/$(database)/documents/reportLimits/$(request.auth.uid)
          ).data.lastReportId == reportId;
    }

    // Reporter rate-limit state: 30s between reports, and at most 20
    // inside each FIXED 24-hour window. Owner-writable only through
    // these exact shapes, never readable by anyone else, never
    // deletable. Same tumbling-window semantics as the sender state —
    // see there for the boundary behaviour.
    match /reportLimits/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId) &&
          isActiveAccount() &&
          request.resource.data.keys().hasOnly([
            'lastReportAt', 'lastReportId', 'windowStartAt', 'windowCount'
          ]) &&
          request.resource.data.lastReportAt == request.time &&
          request.resource.data.lastReportId is string &&
          request.resource.data.windowStartAt == request.time &&
          request.resource.data.windowCount == 1;

      allow update: if isOwner(userId) &&
          isActiveAccount() &&
          request.resource.data.keys().hasOnly([
            'lastReportAt', 'lastReportId', 'windowStartAt', 'windowCount'
          ]) &&
          request.resource.data.lastReportAt == request.time &&
          request.resource.data.lastReportId is string &&
          request.time > resource.data.lastReportAt +
              duration.value(30, 's') &&
          (
            request.time < resource.data.windowStartAt +
                    duration.value(24, 'h')
              ? (
                  request.resource.data.windowStartAt ==
                      resource.data.windowStartAt &&
                  request.resource.data.windowCount ==
                      resource.data.windowCount + 1 &&
                  request.resource.data.windowCount <= 20
                )
              : (
                  request.resource.data.windowStartAt == request.time &&
                  request.resource.data.windowCount == 1
                )
          );

      allow delete: if false;
    }

    // Moderation history. Written only by Cloud Functions through the
    // Admin SDK (which bypasses rules); no client may read it, because
    // it records who moderated whom and quotes removed content.
    match /adminAuditLogs/{entryId} {
      allow read, write: if false;
    }

    match /clubs/{clubId} {
      // An ordinary club's metadata stays readable to any signed-in user
      // — unchanged. A Family Room's does not: its name, description and
      // member count are private to the people in it and to anyone
      // holding a live invitation. The `!= 'family'` test short-circuits
      // first, so ordinary club reads perform no extra document lookups.
      // createFamilyRoom() first probes the caller's ONE deterministic id so
      // retry/reopen can return the existing space without uploading media or
      // attempting a second batch. A missing document has no resource.data;
      // evaluating the ordinary branch against it used to throw a rules null
      // error and deny every first Family Room creation before it began. The
      // missing-doc exception is deliberately scoped to `family_{caller}`.
      // Once a document exists, the normal family membership/invite boundary
      // below applies, even at that id.
      allow get: if isSignedIn() && (
            (
              clubId == 'family_' + request.auth.uid &&
              !exists(/databases/$(database)/documents/clubs/$(clubId))
            ) ||
            resource.data.get('type', 'community') != 'family' ||
            isClubMember(clubId) ||
            hasPendingClubInvite(clubId, request.auth.uid)
          );

      // LIST is separate from GET on purpose, and this is not a
      // stylistic split. A per-document condition does not protect a
      // collection listing: during list evaluation `resource.data` is not
      // the document, so `resource.data.get('type', 'community')` fell
      // back to its default and a signed-in outsider could enumerate
      // `clubs` and read a family room's name straight out of it.
      // Verified against the emulator, not assumed.
      //
      // Nothing may list this collection. The one query that used to —
      // countOwnedClubs()'s owner-scoped count for the premium gate — now
      // counts `users/{uid}/clubs` where role == 'owner' instead, a
      // collection the caller already owns. With that gone there is no
      // legitimate listing left, so the honest rule is `false`: a family
      // room is undiscoverable because the query cannot run, not because
      // no screen happens to call it today.
      allow list: if false;

      // Community Clubs are created only by createCommunityClub through the
      // Admin SDK. The callable verifies capability + expiry and serializes a
      // live canonical owner count, which rules cannot express safely. The
      // one direct path left here is family: free for any verified account,
      // but pinned to the
      //    deterministic id `family_{uid}`. That id IS the per-account
      //    limit — rules cannot count documents, but they can refuse
      //    every id except the one this account owns, so a second Family
      //    Room has nowhere to be written. Being invited into someone
      //    else's family space is unaffected: that writes a member
      //    document, not a club.
      allow create: if isVerified() &&
          canCommunicate() &&
          clubId == 'family_' + request.auth.uid &&
          familyClubCreateAllowed(clubId);

      // Invite acceptance has one exact atomic counter transition. Ordinary
      // client editing is a narrow metadata allowlist; ownership, roles,
      // counters, default channel ids and every other root field are server
      // authority. This also prevents a manager from forging quota-relevant
      // owner changes or arbitrary defaults.
      allow update: if (
            invitedClubJoinUpdateAllowed(clubId) ||
            (canEditClubMetadata(clubId) && clubMetadataUpdateAllowed())
          ) &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.get('type', 'community') ==
              resource.data.get('type', 'community');
      // Firestore does not cascade subcollections. Club deletion is performed
      // only by the protected-owner callable, which recursively deletes rooms
      // and Club data and clears every private membership projection.
      allow delete: if false;

      match /members/{memberId} {
        // Club rosters are only ever read directly (per-club queries or
        // single-doc gets), never via collectionGroup — see
        // rooms/{roomId}/roomMembers below for why that distinction matters.
        // Members can browse the roster; anyone can always read their own
        // membership record (e.g. to check their own role).
        allow read: if isClubMember(clubId) ||
            (isSignedIn() && resource.data.userId == request.auth.uid);
        allow create: if isSignedIn() &&
            request.auth.uid == memberId &&
            clubMemberCreateShapeAllowed(memberId) &&
            (
              invitedClubMemberCreateAllowed(clubId, memberId) ||
              ownerClubMemberCreateAllowed(clubId)
            );
        allow update: if isClubMember(clubId) &&
            request.resource.data.userId == resource.data.userId &&
            request.resource.data.joinedAt == resource.data.joinedAt &&
            (
              (
                request.auth.uid == memberId &&
                request.resource.data.role == resource.data.role &&
                displayNameMatchesCanonical(
                  memberId,
                  request.resource.data.displayName
                ) &&
                request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly([
                    'displayName', 'photoUrl', 'isOnline', 'updatedAt'
                  ])
              ) ||
              (
                clubRole(clubId) in ['owner', 'coOwner'] &&
                memberId != request.auth.uid &&
                resource.data.role != 'owner' &&
                request.resource.data.role != 'owner' &&
                request.resource.data.role in [
                  'coOwner', 'admin', 'moderator', 'member', 'guest'
                ] &&
                clubRolePower(clubRole(clubId)) > clubRolePower(resource.data.role) &&
                clubRolePower(clubRole(clubId)) > clubRolePower(request.resource.data.role) &&
                clubRoleChangeFieldsAllowed()
              )
            );
        allow delete: if false;
      }

      match /invites/{inviteeId} {
        allow read: if isSignedIn() &&
            (
              (isActiveAccount() && request.auth.uid == inviteeId) ||
              canManageClub(clubId)
            );
        // sendClubInvite owns canonical inviter/Club snapshots and checks
        // both friendship mirrors, blocks, sanctions and account status.
        allow create: if false;
        allow update: if false;
        allow delete: if isSignedIn() &&
            (
              (isActiveAccount() && request.auth.uid == inviteeId) ||
              canManageClub(clubId)
            );
      }

      match /channels/{channelId} {
        allow read: if isClubMember(clubId);
        allow create: if isClubOwnerAfter(clubId) || canManageClub(clubId);
        allow update, delete: if canManageClub(clubId);

        match /messages/{messageId} {
          allow read: if isClubMember(clubId);
          allow create: if isVerified() &&
              canCommunicate() &&
              isClubMember(clubId) &&
              request.resource.data.senderId == request.auth.uid &&
              request.resource.data.clubId == clubId &&
              request.resource.data.channelId == channelId;
          allow update: if isClubMember(clubId) &&
              resource.data.senderId == request.auth.uid &&
              request.resource.data.senderId == resource.data.senderId;
          allow delete: if false;
        }
      }

      // Family Moments. Deliberately NOT in the global `voiceMoments`
      // collection: living under the club document means the private
      // boundary is the club membership check itself, and there is no
      // query anywhere that could sweep these into a public feed. Losing
      // membership — leaving, removal, a block, account deletion —
      // removes the member document and with it every read below.
      match /moments/{momentId} {
        allow read: if isClubMember(clubId);
        allow create: if isVerified() &&
            canCommunicate() &&
            isClubMember(clubId) &&
            request.resource.data.authorId == request.auth.uid &&
            request.resource.data.clubId == clubId;
        // Authors may edit their own caption; nobody may reassign one.
        allow update: if isClubMember(clubId) &&
            resource.data.authorId == request.auth.uid &&
            request.resource.data.authorId == resource.data.authorId;
        allow delete: if isClubMember(clubId) &&
            (
              resource.data.authorId == request.auth.uid ||
              canManageClub(clubId)
            );
      }

      // Quick check-ins: ordinary append-only status updates ("I'm home",
      // "On my way", ...). No location of any kind is accepted or stored,
      // and each row is scoped to the account that wrote it. Immutable
      // once written, so a check-in cannot be edited to say something the
      // person never said.
      match /checkIns/{checkInId} {
        allow read: if isClubMember(clubId);
        allow create: if isVerified() &&
            isClubMember(clubId) &&
            request.resource.data.keys().hasAll([
              'userId', 'clubId', 'displayName', 'photoUrl', 'status',
              'createdAt'
            ]) &&
            request.resource.data.keys().hasOnly([
              'userId', 'clubId', 'displayName', 'photoUrl', 'status',
              'createdAt'
            ]) &&
            request.resource.data.userId == request.auth.uid &&
            request.resource.data.clubId == clubId &&
            displayNameMatchesCanonical(
              request.auth.uid,
              request.resource.data.displayName
            ) &&
            request.resource.data.status in [
              'home', 'onMyWay', 'allGood', 'callMe'
            ] &&
            request.resource.data.createdAt == request.time &&
            !('latitude' in request.resource.data) &&
            !('longitude' in request.resource.data) &&
            !('location' in request.resource.data);
        allow update: if false;
        allow delete: if isClubMember(clubId) &&
            (
              resource.data.userId == request.auth.uid ||
              canManageClub(clubId)
            );
      }
    }

    // Descriptive room metadata, added with the three-step creation
    // wizard. NONE of it is authorization: targetAudience does not decide
    // who may join, and nothing below is consulted when granting access.
    // It is validated here so a client cannot invent a capability by
    // writing a value the app has never heard of.
    //
    // Every field is OPTIONAL. Rooms written before these existed carry
    // none of them and must keep loading, so each check is guarded by
    // presence rather than required outright.
    function roomMetadataValid(data) {
      return (
        !('targetAudience' in data) ||
        data.targetAudience in
            ['everyone', 'newcomers', 'enthusiasts', 'professionals']
      ) && (
        !('topicTags' in data) ||
        (data.topicTags is list && data.topicTags.size() <= 3)
      ) && (
        !('roomGuidelines' in data) ||
        (data.roomGuidelines is string && data.roomGuidelines.size() <= 280)
      ) && (
        !('conversationStyle' in data) ||
        data.conversationStyle in
            ['casual', 'focused', 'networking', 'supportive']
      ) && (
        !('newcomerFriendly' in data) || data.newcomerFriendly is bool
      ) && (
        !('showFormat' in data) ||
        data.showFormat in
            ['solo', 'interview', 'panel', 'qAndA', 'openDiscussion']
      );
    }

    // A room may not wear the other type's clothes. A community room
    // carrying showFormat would present itself as a podcast wherever that
    // field is read; a broadcast room carrying conversationStyle does the
    // reverse. The experience field decides, and it is the same one the
    // stage screens branch on.
    function roomTypeFieldsScoped(data) {
      return data.get('experience', 'community') == 'broadcast'
          ? (!('conversationStyle' in data) && !('newcomerFriendly' in data))
          : !('showFormat' in data);
    }

    // Issued-token discovery is server authority. Clients cannot forge,
    // replay, hide or delete these mirrors to influence moderation revocation.
    match /activeVoiceSessions/{userId} {
      allow read, write: if false;

      match /rooms/{roomId} {
        allow read, write: if false;
      }
    }

    match /rooms/{roomId} {
      // Public discovery remains queryable only when the query itself pins
      // visibility=public. Private room metadata is available solely to the
      // host, a host-admitted participant, or an active canonical Club member.
      allow get: if canAccessRoom(roomId);
      allow list: if isSignedIn() &&
          (resource.data.visibility == 'public' ||
           resource.data.hostId == request.auth.uid);

      allow create: if isVerified() &&
          isActiveAccount() &&
          request.resource.data.hostId == request.auth.uid &&
          roomCreateShapeAllowed() &&
          roomMetadataValid(request.resource.data) &&
          roomTypeFieldsScoped(request.resource.data) &&
          roomCreateAuthorityAllowed(roomId);

      // Every non-host root transition is tied to the exact member/participant
      // write in the same atomic operation. A signed-in outsider can no longer
      // forge counters or start/stop a room by updating the root alone.
      //
      // The ternary SELECTOR stays `resource.data.hostId == request.auth.uid`
      // on purpose; the account-status check belongs inside
      // hostRoomUpdateAllowed(), not here.
      //
      // CORRECTED 2026-08-16 — an earlier version of this comment claimed
      // that moving isActiveAccount() into the selector would be LOOSER,
      // because a suspended host would fall through to the non-host
      // transition set and gain a self-join path. That was measured and is
      // false as this file now stands: an audit built the variant and it is
      // exactly as tight, denial for denial. The fall-through it described
      // was real only against the PREVIOUS roomMembers create rule, and the
      // same commit closed that by requiring isActiveAccount() there — so
      // the comment was justifying this shape with a mechanism its own
      // commit had already removed. Left as written because a closed host
      // branch does not depend on roomMembers create staying tight, which
      // is the more durable property; not because the selector form is
      // unsafe. If you move it, prove the variant rather than trusting
      // either version of this paragraph.
      allow update: if isSignedIn() &&
          roomMetadataValid(request.resource.data) &&
          roomTypeFieldsScoped(request.resource.data) &&
          (
            resource.data.hostId == request.auth.uid
              ? hostRoomUpdateAllowed(roomId)
              : (
                  roomActivityTouchAllowed(roomId) ||
                  roomParticipantJoinTransitionAllowed(roomId) ||
                  roomParticipantLeaveTransitionAllowed(roomId) ||
                  roomMemberJoinTransitionAllowed(roomId) ||
                  roomMemberLeaveTransitionAllowed(roomId) ||
                  roomVoiceStartAllowed(roomId)
                )
          );

      // Deletes are recursive lifecycle operations (participants, members,
      // chat, queue and LiveKit control-plane), so clients cannot delete only
      // the root and leave an orphaned authority graph.
      allow delete: if false;

      match /participants/{participantId} {
        allow read: if canAccessRoom(roomId) ||
            (isSignedIn() && resource.data.userId == request.auth.uid);

        // Self-service creation must mirror what joinRoom()/createRoom()
        // actually write: the room's real host joins as host+speaker,
        // everyone else joins as a plain listener. Promoting to speaker
        // or moderator status only ever happens through a host-driven
        // update below.
        //
        // createRoom() writes the room doc and this participant doc in the
        // same batch, so a plain get()/isRoomHost() wouldn't see the room's
        // hostId yet — getAfter() resolves against the state once the whole
        // transaction/batch has applied, which is what we need here.
        allow create: if isSignedIn() &&
            canCommunicate() &&
            !isRestrictedAccount(request.auth.uid) &&
            (
              // Initial host membership, including the room-create batch.
              (
                request.auth.uid == participantId &&
                selfRoomParticipantShape(
                  request.resource.data, 'host', true
                ) &&
                getAfter(
                  /databases/$(database)/documents/rooms/$(roomId)
                ).data.hostId == request.auth.uid
              ) ||
              // Self-service join is public, except a Club lounge where
              // canonical active Club membership is the admission grant.
              (
                request.auth.uid == participantId &&
                selfRoomParticipantShape(
                  request.resource.data, 'listener', false
                ) &&
                getAfter(
                  /databases/$(database)/documents/rooms/$(roomId)
                ).data.hostId != request.auth.uid &&
                get(
                  /databases/$(database)/documents/rooms/$(roomId)
                ).data.get('status', 'active') == 'active' &&
                get(
                  /databases/$(database)/documents/rooms/$(roomId)
                ).data.get('isLive', false) == true &&
                (
                  get(
                    /databases/$(database)/documents/rooms/$(roomId)
                  ).data.visibility == 'public' ||
                  isActiveClubRoomMember(roomId)
                ) &&
                getAfter(
                  /databases/$(database)/documents/rooms/$(roomId)
                ).data.participantCount ==
                  get(
                    /databases/$(database)/documents/rooms/$(roomId)
                  ).data.participantCount + 1
              ) ||
              // A host may explicitly admit another identity. The token
              // callable requires this durable marker for non-Club private
              // rooms, so legacy/self-forged rows never become authority.
              (
                isRoomHost(roomId) &&
                participantId != request.auth.uid &&
                hostAdmittedParticipantShape(
                  request.resource.data, participantId
                )
              )
            );

        // A participant may only mute themselves or raise/lower their own
        // hand. Promotion to speaker, moderator mute-of-others, and role
        // changes are host-only.
        allow update: if isSignedIn() &&
            request.auth.uid == participantId &&
            request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['isMuted', 'isHandRaised', 'updatedAt']) &&
            request.resource.data.get('serverMuted', false) ==
              resource.data.get('serverMuted', false) &&
            request.resource.data.get('hostMuted', false) ==
              resource.data.get('hostMuted', false) &&
            request.resource.data.updatedAt == request.time;

        // Leaving also revokes the already-issued LiveKit identity and clears
        // the server-only session mirror, so every delete goes through the
        // leaveRoomSelf/host/staff callable lifecycle.
        allow delete: if false;
      }

      match /roomMembers/{memberId} {
        // Named distinctly from clubs/{clubId}/members on purpose (ADR-005):
        // watchMyCommunities() (room_service.dart) runs a
        // collectionGroup('roomMembers') query filtered to `userId == caller`.
        //
        // What authorizes that query is the top-level
        // `match /{path=**}/roomMembers/{memberId}` block at the head of this
        // file, and only that block. A nested, parent-scoped match block does
        // not take part in authorizing a collectionGroup query at all, so the
        // get()-bearing clause below cannot endanger it.
        //
        // The experiment that shows this is NOT "set the nested rule to
        // `if false` and watch the query survive" — an earlier version of
        // this comment cited exactly that, and it proves nothing, because
        // Firestore unions allow rules and `false OR <top-level provable>`
        // is allowed under either hypothesis. The discriminating run is the
        // opposite one: make the NESTED rule `if true` and the TOP-LEVEL
        // rule deny. If a nested block could carry a collectionGroup query,
        // the most permissive rule expressible would carry it. The query is
        // still rejected. Both runs are pinned as executable cases at the
        // end of firestore-tests/rules.test.js rather than left as a claim
        // in a comment; the `if false` one is kept only as the control that
        // shows the deny is caused by the top-level rule and nothing else.
        //
        // The constraint that does bind is on the TOP-LEVEL rule: it has to
        // stay provable from the query's own filter, which is why it is kept
        // to `resource.data.userId == request.auth.uid` and nothing broader
        // (ADR-006). Keeping room membership under its own collection name is
        // what lets that rule stay that narrow without having to serve
        // clubs/{clubId}/members' roster browsing as well. Either rule
        // changing needs a real collectionGroup() check, never a direct-path
        // one — ADR-007, and the cases at the end of
        // firestore-tests/rules.test.js.
        allow read: if resource.data.userId == request.auth.uid ||
            canAccessRoom(roomId);
        // isActiveAccount(), not just !isRestrictedAccount(): the old test
        // read `banned` alone and passed outright when the account document
        // was absent, so a DISABLED account could still mint a membership
        // row and move the room's memberCount. The row it minted was inert
        // — isRoomMember() requires an active account — but a suspended
        // account writing into another member's roster is the gap, not what
        // the row later buys. Room create already requires isActiveAccount()
        // and the paired participants create already requires
        // canCommunicate(), so this is the shape the rest of the room
        // surface already holds; users/{uid} is `allow delete: if false`, so
        // requiring the document to exist cannot strand a real account.
        allow create: if isActiveAccount() &&
            request.auth.uid == memberId &&
            (
              (
                initialRoomOwnerMemberShape(
                  request.resource.data, memberId
                ) &&
                getAfter(
                  /databases/$(database)/documents/rooms/$(roomId)
                ).data.hostId == request.auth.uid &&
                getAfter(
                  /databases/$(database)/documents/rooms/$(roomId)
                ).data.roomType == 'community'
              ) ||
              (
                request.resource.data.userId == request.auth.uid &&
                displayNameMatchesCanonical(
                  memberId,
                  request.resource.data.displayName
                ) &&
                request.resource.data.role == 'member' &&
                get(
                  /databases/$(database)/documents/rooms/$(roomId)
                ).data.visibility == 'public' &&
                get(
                  /databases/$(database)/documents/rooms/$(roomId)
                ).data.get('approvalRequired', false) == false &&
                getAfter(
                  /databases/$(database)/documents/rooms/$(roomId)
                ).data.memberCount ==
                  get(
                    /databases/$(database)/documents/rooms/$(roomId)
                  ).data.memberCount + 1
              )
            );
        // `userId` is the field watchMyCommunities() filters its
        // collectionGroup query on, which makes an unpinned membership row a
        // REMOTE weapon: a host who repoints their own row at somebody
        // else's uid puts a row that person's query returns into a room that
        // person cannot read, and Future.wait in room_service.dart rejects
        // their whole Communities list. The victim cannot delete the row and
        // never consented to it. The host branch used to carry no invariants
        // at all — not even that — so it could also inject any field it
        // liked into a membership document.
        //
        // Both branches now write the same thing: display identity. That is
        // the only mutation either client has ever issued against these rows
        // (room_service.dart creates them and reads them; nothing updates
        // them), so the allowlist is the real write surface, not a guess.
        // Identity, role and join time are all fixed once the row exists.
        allow update: if isSignedIn() &&
            request.resource.data.userId == resource.data.userId &&
            request.resource.data.role == resource.data.role &&
            request.resource.data.get('joinedAt', null) ==
              resource.data.get('joinedAt', null) &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['displayName', 'photoUrl', 'updatedAt']) &&
            displayNameMatchesCanonical(
              memberId,
              request.resource.data.displayName
            ) &&
            (
              isRoomHost(roomId) ||
              request.auth.uid == memberId
            );

        // SELF-LEAVE ONLY, and gated on nothing but who you are.
        //
        // Two things this rule deliberately does NOT do, both learned from
        // the version that shipped before it:
        //
        // It does not require the room's memberCount to move. Pairing the
        // two made a derived counter the gate on an exit: any room whose
        // stored count had drifted below its real row count — a legacy room
        // from before the field existed, a half-applied join, a host who
        // could still edit the number — became a room nobody could leave and
        // nobody could be removed from, silently and permanently. A counter
        // that disagrees with reality is a cosmetic defect; a member who
        // cannot get out is not. roomMemberLeaveTransitionAllowed still
        // exists to keep the count honest when the client pairs the writes,
        // and it is the ONLY way memberCount can move down, so leaving
        // cannot be turned into a way to forge one.
        //
        // It does not authorize eviction. A host removing somebody is a
        // moderation action, and doing it here would delete a roster row
        // while leaving the evicted account connected to the live audio,
        // still able to read chat as a participant, and free to rejoin a
        // public room immediately — a button that looks like removal and
        // is not. removeRoomParticipantSelf already does the whole job
        // (roster row, session mirror, LiveKit revocation) and is where a
        // roomMembers eviction belongs; no client calls a rules-level one
        // today. Rules also cannot bind a host's delete to a specific
        // named row the way this rule binds a member to their own, so a
        // counter-paired host branch let a single decrement carry an
        // unbounded batch of deletes.
        //
        // The owner row stays undeletable so a Community room can never be
        // left without its owner; disposing of a whole room is still the
        // deleteRoomSelf callable's recursive job.
        allow delete: if isSignedIn() &&
            request.auth.uid == memberId &&
            resource.data.get('role', 'member') != 'owner';
      }

      match /messages/{messageId} {
        // Public rooms keep their chat readable without having joined yet
        // (matches how Discover lets you preview a room before entering).
        // Private/club-lounge rooms require an actual participant, member,
        // or host relationship — previously any signed-in user could read
        // any room's chat regardless of visibility.
        allow read: if isSignedIn() &&
            (
              roomExists(roomId) &&
              (
                get(
                  /databases/$(database)/documents/rooms/$(roomId)
                ).data.visibility == 'public' ||
                canAccessRoom(roomId) ||
                isRoomMember(roomId) ||
                isRoomHost(roomId)
              )
            );
        allow create: if isVerified() &&
            canCommunicate() &&
            request.resource.data.senderId == request.auth.uid &&
            (
              (isRoomParticipant(roomId) && canAccessRoom(roomId)) ||
              isRoomMember(roomId) ||
              isRoomHost(roomId)
            );
        // Room chat reactions (Rooms 2.0): people in the room may toggle
        // the reactions map and NOTHING else — sender, text and
        // timestamps stay immutable. Deletes are host moderation only.
        //
        // isActiveAccount() matches the create rule directly above, which
        // already requires canCommunicate(). Without it a suspended account
        // could not POST in a room but could still write into every message
        // document in it, through the isRoomParticipant()/canAccessRoom()
        // branch — a participant row plus a public room, which is exactly
        // what a host who was banned mid-session still holds. Reacting is
        // not an exit, so gating it traps nobody.
        allow update: if isActiveAccount() &&
            (
              (isRoomParticipant(roomId) && canAccessRoom(roomId)) ||
              isRoomMember(roomId) ||
              isRoomHost(roomId)
            ) &&
            request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['reactions']);
        allow delete: if isRoomHost(roomId);
      }

      // Broadcast Room raise-hand queue (room_experience_service.dart,
      // used by podcast_room_screen.dart) — had no rules at all, so every
      // hand-raise request was silently rejected.
      match /handRequests/{requesterId} {
        allow read: if isSignedIn() &&
            (
              isRoomHost(roomId) ||
              request.auth.uid == requesterId ||
              (isRoomParticipant(roomId) && canAccessRoom(roomId))
            );
        allow create: if isVerified() &&
            canCommunicate() &&
            !isRestrictedAccount(request.auth.uid) &&
            request.auth.uid == requesterId &&
            roomExists(roomId) &&
            isRoomParticipant(roomId) &&
            canAccessRoom(roomId) &&
            request.resource.data.keys().hasAll([
              'displayName', 'photoUrl', 'createdAt'
            ]) &&
            request.resource.data.keys().hasOnly([
              'displayName', 'photoUrl', 'createdAt'
            ]) &&
            request.resource.data.createdAt == request.time &&
            displayNameMatchesCanonical(
              request.auth.uid,
              request.resource.data.displayName
            ) &&
            get(
              /databases/$(database)/documents/rooms/$(roomId)
            ).data.experience == 'broadcast' &&
            get(
              /databases/$(database)/documents/rooms/$(roomId)
            ).data.get('status', 'active') == 'active' &&
            get(
              /databases/$(database)/documents/rooms/$(roomId)
            ).data.get('isLive', false) == true &&
            get(
              /databases/$(database)/documents/rooms/$(roomId)
            ).data.get('handRaisingEnabled', true) == true;
        allow update: if false;
        allow delete: if isSignedIn() &&
            (request.auth.uid == requesterId || isRoomHost(roomId));
      }
    }
    match /voiceMoments/{momentId} {
      allow read: if isSignedIn();
      allow create: if isVerified() &&
          canCommunicate() &&
          request.resource.data.authorId == request.auth.uid;
      // Non-author updates used to allow likeCount/commentCount to be set to
      // any value at all — now each write must actually correspond to the
      // caller's own like being added/removed (toggleLike() in
      // home_feed_service.dart runs both writes in one transaction, so
      // existsAfter() correctly reflects the like doc's post-write state),
      // or a plain +1 for a new comment.
      allow update: if isSignedIn() &&
          (
            (
              resource.data.authorId == request.auth.uid &&
              request.resource.data.authorId == resource.data.authorId
            ) ||
            (
              request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['likeCount', 'updatedAt']) &&
              (
                (
                  request.resource.data.likeCount ==
                      resource.data.likeCount + 1 &&
                  existsAfter(
                    /databases/$(database)/documents/voiceMoments/$(momentId)/likes/$(request.auth.uid)
                  )
                ) ||
                (
                  request.resource.data.likeCount ==
                      resource.data.likeCount - 1 &&
                  !existsAfter(
                    /databases/$(database)/documents/voiceMoments/$(momentId)/likes/$(request.auth.uid)
                  )
                )
              )
            ) ||
            (
              request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['commentCount', 'updatedAt']) &&
              request.resource.data.commentCount ==
                  resource.data.commentCount + 1
            )
          );
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;

      match /likes/{userId} {
        allow read: if isSignedIn();
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isVerified() &&
            request.resource.data.authorId == request.auth.uid &&
            (
              (
                request.resource.data.type == 'text' &&
                request.resource.data.text is string &&
                request.resource.data.text.size() > 0 &&
                request.resource.data.text.size() <= 1000
              ) ||
              (
                request.resource.data.type == 'voice' &&
                request.resource.data.text is string &&
                request.resource.data.text.size() <= 140 &&
                request.resource.data.audioUrl is string &&
                request.resource.data.audioUrl.size() > 0 &&
                request.resource.data.storagePath is string &&
                request.resource.data.durationSeconds is int &&
                request.resource.data.durationSeconds >= 1 &&
                request.resource.data.durationSeconds <= 60
              )
            );
        allow update: if false;
        allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
      }
    }

  }
}
