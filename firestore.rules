rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Nested `match /parent/{id}/collection/{doc}` rules only ever apply to
    // reads/writes scoped to one specific parent — they do NOT authorize a
    // collectionGroup() query, which scans the named collection across every
    // parent at once. Firestore requires a separate, top-level
    // `match /{path=**}/collection/{doc}` rule for that (verified against
    // the emulator: without it, the query is rejected as permission-denied
    // regardless of how permissive the nested rule is). These two mirror the
    // narrowest read case the app's actual collectionGroup() queries need —
    // full create/update/delete authorization still lives on the nested
    // rules below, since writes always go through a specific parent path.
    match /{path=**}/roomMembers/{memberId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /{path=**}/invites/{inviteId} {
      allow read: if isSignedIn() && resource.data.inviteeId == request.auth.uid;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // request.auth.token.email_verified mirrors the ID token's claim —
    // Firebase Auth sets it automatically and it refreshes the next time
    // the client gets a new token after verifying, so this can't be
    // spoofed from the client the way a Firestore-stored flag could be.
    // Gates outbound/spam-prone actions (sending messages, starting
    // conversations, friend requests, club/room/moment creation, club
    // invites) — NOT passive actions (reading, joining, reacting,
    // blocking), which stay available to a freshly-registered account.
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Kept as the name the rest of this file uses for "is this account
    // staff right now". See isActiveStaff() below for why it is both the
    // signed claim and the server-written mirror.
    function isStaff() {
      return isActiveStaff();
    }

    // AUTHORITATIVE ACCOUNT STATUS.
    //
    // `users/{uid}.banned` is written only by functions/admin/users.js's
    // setUserBan through the Admin SDK. It is deliberately absent from
    // the self-write allowlist on users/{userId} below, so the affected
    // account can neither set nor clear it.
    //
    // Why rules check a DOCUMENT and not just request.auth: disabling an
    // account in Firebase Auth stops it minting NEW ID tokens, but an ID
    // token already in the client's hands stays cryptographically valid
    // until it expires (up to one hour). For that window `request.auth`
    // is still populated and `isSignedIn()` is still true. Reading the
    // status document makes a ban effective on the very next request
    // instead. setUserBan also revokes refresh tokens, which shortens the
    // token's own remaining life — see docs/SECURITY.md.
    //
    // `bannedUntil` records the INTENDED duration; nothing expires it
    // automatically today, so `banned` staying true is what gates access
    // until an administrator lifts it.
    function isRestrictedAccount(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
          get(/databases/$(database)/documents/users/$(userId))
            .data.get('banned', false) == true;
    }

    function isActiveAccount() {
      return isSignedIn() && !isRestrictedAccount(request.auth.uid);
    }

    // STAFF AUTHORITY — the token claim AND the server-written mirror.
    //
    // `assignUserRole` (functions/admin/users.js) does two things: it
    // sets the `role` custom claim, and it writes the same value to
    // `users/{uid}.role` through the Admin SDK. `role` is absent from
    // the self-write allowlist on users/{userId}, so the affected
    // account cannot grant itself one.
    //
    // Requiring BOTH closes the staleness hole in each direction:
    //  - the claim is signed, so a client cannot forge staff access even
    //    by writing its own profile document;
    //  - the document is written synchronously when a role changes, so a
    //    REVOKED role stops working on the very next request instead of
    //    surviving up to an hour inside an already-issued ID token.
    // A freshly promoted moderator whose token has not refreshed yet
    // fails closed (no access) rather than open.
    function isStaffClaim() {
      return isSignedIn() &&
          request.auth.token.get('role', 'user') in
              ['moderator', 'admin', 'superAdmin'];
    }

    function staffRoleOf(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
          ? get(/databases/$(database)/documents/users/$(userId))
              .data.get('role', 'user')
          : 'user';
    }

    function isActiveStaff() {
      return isStaffClaim() &&
          !isRestrictedAccount(request.auth.uid) &&
          staffRoleOf(request.auth.uid) in
              ['moderator', 'admin', 'superAdmin'];
    }

    function isBlockedPair(userA, userB) {
      return exists(
        /databases/$(database)/documents/users/$(userA)/blocked/$(userB)
      ) ||
      exists(
        /databases/$(database)/documents/users/$(userB)/blocked/$(userA)
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Premium entitlement check. entitlements/{uid} is written ONLY by
    // Cloud Functions (client writes are denied below), so this cannot be
    // self-granted from a modified client. Validity is time-based —
    // request.time vs currentPeriodEnd — so expiry enforces itself with
    // no scheduled job in the authorization path. "grace" covers billing
    // retry so a failed card doesn't strip capabilities mid-cycle.
    function hasActivePremium() {
      return isSignedIn() &&
          exists(/databases/$(database)/documents/entitlements/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/entitlements/$(request.auth.uid))
            .data.status in ['active', 'trialing', 'grace'] &&
          request.time < get(/databases/$(database)/documents/entitlements/$(request.auth.uid))
            .data.currentPeriodEnd;
    }

    // accountType is client-writable ONLY within these transitions:
    // keeping it unchanged, or setting 'personal' (always allowed), or
    // setting 'creator' with active Premium. 'official' is never
    // client-settable. Before this rule ANY client could write
    // accountType: 'creator' — Creator gating was UI-only.
    function accountTypeChangeAllowed() {
      return !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['accountType']) ||
          request.resource.data.accountType == 'personal' ||
          (request.resource.data.accountType == 'creator' && hasActivePremium());
    }

    function isOneOfUsers(firstUserId, secondUserId) {
      return isSignedIn() &&
          (request.auth.uid == firstUserId ||
           request.auth.uid == secondUserId);
    }

    function conversationExists(conversationId) {
      return exists(
        /databases/$(database)/documents/conversations/$(conversationId)
      );
    }

    function isConversationParticipant(conversationId) {
      return isSignedIn() &&
          conversationExists(conversationId) &&
          request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participantIds;
    }

    function conversationBlocked(conversationId) {
      let participants = get(
        /databases/$(database)/documents/conversations/$(conversationId)
      ).data.participantIds;
      return isBlockedPair(participants[0], participants[1]);
    }

    function roomExists(roomId) {
      return exists(
        /databases/$(database)/documents/rooms/$(roomId)
      );
    }

    function isRoomHost(roomId) {
      return isSignedIn() &&
          roomExists(roomId) &&
          get(
            /databases/$(database)/documents/rooms/$(roomId)
          ).data.hostId == request.auth.uid;
    }

    function isRoomParticipant(roomId) {
      return isSignedIn() && exists(
        /databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid)
      );
    }

    function isRoomMember(roomId) {
      return isSignedIn() && exists(
        /databases/$(database)/documents/rooms/$(roomId)/roomMembers/$(request.auth.uid)
      );
    }


    function clubExists(clubId) {
      return exists(
        /databases/$(database)/documents/clubs/$(clubId)
      );
    }

    function isClubMember(clubId) {
      return isSignedIn() && exists(
        /databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid)
      );
    }

    function isClubOwner(clubId) {
      return isSignedIn() && clubExists(clubId) &&
          get(
            /databases/$(database)/documents/clubs/$(clubId)
          ).data.ownerId == request.auth.uid;
    }

    function hasPendingClubInvite(clubId, userId) {
      return isSignedIn() && exists(
        /databases/$(database)/documents/clubs/$(clubId)/invites/$(userId)
      ) && get(
        /databases/$(database)/documents/clubs/$(clubId)/invites/$(userId)
      ).data.inviteeId == userId;
    }

    function clubRole(clubId) {
      return get(
        /databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid)
      ).data.role;
    }

    function canManageClub(clubId) {
      return isClubMember(clubId) &&
          clubRole(clubId) in ['owner', 'coOwner', 'admin'];
    }

    // A Family Room is a Club with type == 'family': same members, roles,
    // invites, channels and lounge, but a private data boundary. Written
    // once at creation and immutable thereafter, so a club can never be
    // converted into a family space or back.
    function isFamilySpace(clubId) {
      return get(
        /databases/$(database)/documents/clubs/$(clubId)
      ).data.get('type', 'community') == 'family';
    }

    function clubRolePower(role) {
      return role == 'owner' ? 60 :
          role == 'coOwner' ? 50 :
          role == 'admin' ? 40 :
          role == 'moderator' ? 30 :
          role == 'member' ? 20 : 10;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);

      // Self-writes cover profile fields, presence, and the client-side
      // achievement/vanity counters (achievement_service.dart) — these can
      // still be self-inflated by a motivated user (same caveat the audit
      // calls out: not a security hole, just not authoritative without a
      // Cloud Function trigger doing the counting instead).
      //
      // Non-owner writes exist ONLY because follow_service.dart and
      // friend_service.dart increment/decrement the OTHER person's
      // followerCount/friendCount in the same transaction that creates the
      // follow/friend edge — that's a real, currently-used write path, not
      // a hypothetical one. followingCount joined this list for the same
      // reason: blockUser() severs a following-edge THEY created (they
      // follow me, I block them) and must be able to correct their own
      // followingCount down by one in that same transaction. No other
      // field may move on someone else's doc.
      // NB: premiumIdentity is deliberately NOT in this allowlist — it is
      // the public mirror of the server-managed entitlement and may only
      // be written by Cloud Functions (Admin SDK bypasses rules).
      allow update: if isSignedIn() &&
          (
            isOwner(userId)
              ? (request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly([
                    'uid', 'email', 'displayName', 'username', 'photoUrl',
                    'bannerUrl', 'bio', 'country', 'nativeLanguage',
                    'spokenLanguages', 'learningLanguages', 'website',
                    'statusMessage',
                    'accountType', 'profileUpdatedAt',
                    'isOnline', 'lastSeen', 'presenceUpdatedAt',
                    'messageCount', 'followerCount', 'followingCount',
                    'roomCount', 'communityCount', 'voiceMinutes',
                    'reactionCount', 'hostMinutes', 'activeDays',
                    'momentCount', 'friendCount', 'unlockedTitleIds',
                    'selectedTitleId', 'achievementsUpdatedAt',
                    'notificationPreferences',
                  ]) && accountTypeChangeAllowed())
              : request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['friendCount', 'followerCount', 'followingCount'])
          );

      allow delete: if false;

      match /friendRequests/{senderId} {
        // getRelationshipStatus() (friend_service.dart) checks whether the
        // CALLER previously sent a request by reading
        // users/{otherUserId}/friendRequests/{callerUid} — i.e. the sender
        // reading a doc that lives under the *recipient's* subcollection.
        // Recipient-only read left that permanently denied for the sender's
        // own outgoing-request check.
        allow read: if isOneOfUsers(userId, senderId);
        // Neither party may create a request while either has blocked the
        // other. isBlockedPair() reads the target subcollections directly —
        // it isn't gated by their own read rule, so this works without
        // granting either user visibility into the other's block list
        // (blocked/{doc} stays owner-read-only below).
        allow create: if isVerified() &&
            request.auth.uid == senderId &&
            senderId != userId &&
            request.resource.data.senderId == senderId &&
            !isBlockedPair(userId, senderId);
        allow update: if false;
        allow delete: if isOneOfUsers(userId, senderId);
      }

      match /blocked/{blockedUserId} {
        // Deliberately owner-only in both directions — nobody, including
        // the blocked user, can read who's on this list. The friendRequests
        // create rule above enforces the block via exists() checks, which
        // don't require this rule to grant any read access.
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && blockedUserId != userId;
        allow update: if false;
        allow delete: if isOwner(userId);
      }

      // Mirror of friendRequests, keyed from the sender's side
      // (friend_service.dart writes both so each party can see their own
      // pending list without a collection-group query). Missing from the
      // rules entirely before this — every sendFriendRequest() call failed.
      match /sentFriendRequests/{receiverId} {
        allow read: if isOwner(userId);
        allow create: if isVerified() &&
            isOwner(userId) &&
            receiverId != userId &&
            request.resource.data.receiverId == receiverId;
        allow update: if false;
        allow delete: if isOneOfUsers(userId, receiverId);
      }

      match /friends/{friendId} {
        allow read: if isOwner(userId);
        // A friendship may only come into existence where a matching
        // friendRequests doc already existed on one side or the other —
        // otherwise anyone could force themselves into (or delete) a
        // friendship with a direct write, skipping the request flow
        // entirely.
        allow create: if isOneOfUsers(userId, friendId) &&
            userId != friendId &&
            (
              exists(
                /databases/$(database)/documents/users/$(userId)/friendRequests/$(friendId)
              ) ||
              exists(
                /databases/$(database)/documents/users/$(friendId)/friendRequests/$(userId)
              )
            );
        allow update, delete: if isOneOfUsers(userId, friendId) &&
            userId != friendId;
      }

      // follow_service.dart — no rules existed for either subcollection
      // before this, so follow()/unfollow() failed outright.
      match /following/{targetUserId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() &&
            isOwner(userId) &&
            targetUserId != userId &&
            !isBlockedPair(userId, targetUserId);
        allow update: if false;
        allow delete: if isOwner(userId);
      }

      match /followers/{followerId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() &&
            request.auth.uid == followerId &&
            followerId != userId;
        allow update: if false;
        allow delete: if isOneOfUsers(userId, followerId);
      }

      match /clubs/{clubId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) || canManageClub(clubId);
        allow update: if isOwner(userId) || canManageClub(clubId);
        allow delete: if isOwner(userId) || canManageClub(clubId);
      }

      // notification_service.dart writes directly into the recipient's
      // subcollection (no Cloud Function in the loop for the common cases),
      // so create is authorized purely on "the caller is the actor and
      // isn't notifying themselves." 'system' and 'moderation' are
      // deliberately left OUT of the client-creatable type list — those can
      // only be written by the Admin SDK (Cloud Functions bypass rules
      // entirely), which is what stops a client from forging a trusted
      // system notification. Client updates are limited to the read-state
      // fields; nothing else about a notification is editable after it's
      // created.
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create: if isSignedIn() &&
            request.auth.uid == request.resource.data.actorId &&
            request.resource.data.actorId != userId &&
            // friendRequest / friendAccepted / follow are NOT here any
            // more. They are derived from their authoritative source
            // documents by onFriendRequestCreated,
            // onFriendRequestResolved and onFollowerCreated, which write
            // through the Admin SDK and bypass these rules (ADR-041).
            // Leaving them client-creatable would mean a client could
            // still forge "X accepted your friend request" without any
            // friendship existing — the rules cannot check that, but the
            // trigger can, because it reads the friendship itself.
            //
            // DEPLOY ORDER MATTERS: ship the Functions before these
            // rules. Rules first would leave a window where the client
            // is denied and no trigger exists yet.
            request.resource.data.type in [
              'clubInvite', 'clubInviteAccepted',
              'roomInvite', 'broadcastInvite',
              'directMessage', 'mention', 'reply',
            ] &&
            request.resource.data.isRead == false &&
            // bellSuppressed routes a record away from the bell feed while
            // keeping the document (it still drives push). Optional (legacy
            // docs predate it), must be a bool — and suppression itself is
            // NOT client-trusted: it is only valid when the RECIPIENT's own
            // friends list contains the sender. That doc is written by the
            // acceptance flow and can never be forged by the sender, so a
            // malicious client cannot hide its message request from a
            // stranger's bell. (Denial costs the attacker nothing they
            // don't already have — a client can always skip writing the
            // notification entirely; the invariant is that a SUPPRESSED
            // record only ever exists between actual friends.)
            (!('bellSuppressed' in request.resource.data) ||
              request.resource.data.bellSuppressed is bool) &&
            (!(('bellSuppressed' in request.resource.data) &&
                request.resource.data.bellSuppressed == true) ||
              exists(/databases/$(database)/documents/users/$(userId)/friends/$(request.auth.uid))) &&
            request.resource.data.keys().hasOnly([
              'type', 'actorId', 'actorName', 'actorPhotoUrl',
              'targetId', 'targetLabel', 'isRead', 'createdAt', 'dedupeKey',
              'bellSuppressed',
            ]);
        // bellSuppressed in the owner-update set exists for the legacy
        // backfill (stamping `false` onto pre-field docs so the indexed
        // bell query covers them). Owner-only and bool-only; an owner
        // "suppressing" their own record is self-harm, not an attack.
        allow update: if isOwner(userId) &&
            request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['isRead', 'readAt', 'bellSuppressed']) &&
            (!('bellSuppressed' in request.resource.data) ||
              request.resource.data.bellSuppressed is bool);
        allow delete: if isOwner(userId);
      }

      // One doc per registered device. Only the Admin SDK (push-send Cloud
      // Function) ever reads across users' tokens; clients only manage
      // their own.
      match /fcmTokens/{token} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
            request.resource.data.keys().hasOnly(['platform', 'updatedAt']);
        allow delete: if isOwner(userId);
      }
    }

    match /conversations/{conversationId} {
      // get is split from list because openOrCreateConversation runs a
      // transaction.get() on a conversation that may not exist yet (the
      // first chat between two people). The old single read rule
      // dereferenced resource.data on that missing doc — a rule
      // evaluation error, so the get was DENIED and starting any brand
      // new chat failed (surfacing on web as the boxed "Dart exception
      // thrown from converted Future" text). For missing docs the get is
      // allowed only when the deterministic id (uidA_uidB, sorted)
      // contains the caller's own uid — so nobody can probe whether two
      // OTHER users have ever talked.
      allow get: if isSignedIn() &&
          (
            resource == null
              ? conversationId.matches(
                  '(^' + request.auth.uid + '_.*)|(.*_' + request.auth.uid + '$)'
                )
              : request.auth.uid in resource.data.participantIds
          );
      allow list: if isSignedIn() &&
          request.auth.uid in resource.data.participantIds;

      allow create: if isVerified() &&
          request.resource.data.participantIds is list &&
          request.resource.data.participantIds.size() == 2 &&
          request.auth.uid in request.resource.data.participantIds &&
          !isBlockedPair(
            request.resource.data.participantIds[0],
            request.resource.data.participantIds[1]
          );

      allow update: if isSignedIn() &&
          request.auth.uid in resource.data.participantIds &&
          request.resource.data.participantIds == resource.data.participantIds;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isConversationParticipant(conversationId);
        allow create: if isVerified() &&
            isConversationParticipant(conversationId) &&
            request.resource.data.senderId == request.auth.uid &&
            !conversationBlocked(conversationId);

        // message_service.dart's editMessage/deleteMessage/toggleReaction/
        // markConversationRead all call update() on this path — this was
        // `if false` before, meaning all four were silently broken in
        // production despite the Dart implementation being correct. Three
        // distinct, narrowly-scoped update shapes, matching exactly what
        // those four methods actually write:
        allow update: if isConversationParticipant(conversationId) &&
            (
              // sender edits or soft-deletes (deleteMessage clears content/
              // mediaUrl/reactions and sets isDeleted, rather than an
              // actual delete, hence this being an update not a delete).
              (
                resource.data.senderId == request.auth.uid &&
                request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['content', 'editedAt', 'mediaUrl', 'isDeleted', 'reactions'])
              ) ||
              // any participant toggles only their OWN reaction key.
              (
                request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['reactions']) &&
                request.resource.data.reactions.diff(resource.data.reactions)
                    .affectedKeys().hasOnly([request.auth.uid])
              ) ||
              // any participant marks the message read by adding only
              // themselves to readBy — never removing entries, never
              // adding on someone else's behalf.
              (
                request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['readBy']) &&
                request.resource.data.readBy.hasAll(resource.data.readBy) &&
                request.resource.data.readBy.hasOnly(
                  resource.data.readBy.concat([request.auth.uid])
                )
              )
            );

        allow delete: if false;
      }
    }

    // Trusted subscription state. Written exclusively by Cloud Functions
    // (premium/entitlements.js); a client can read only its own document
    // and can never write, so premium cannot be self-granted.
    match /entitlements/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // GLOBAL CHAT — the single public channel shared by the whole
    // authenticated community. Deliberately a separate top-level
    // collection from `conversations` (private DMs) and from
    // clubs/*/channels/* (member-only), so a public message can never be
    // confused with, or queried alongside, a private one.
    //
    // There is exactly one channel, `main`, pinned by these rules rather
    // than left open, so nobody can create a parallel "global" channel
    // and pass it off as the real one. The `globalChat/main` PARENT
    // DOCUMENT is never required to exist: Firestore addresses a
    // subcollection independently of its parent, and nothing here reads
    // channel metadata. There is no manual provisioning step.
    // ---------------------------------------------------------------
    match /globalChat/{channelId} {
      // The channel document holds nothing and is never written. Reading
      // it is harmless; creating one is not, because a second channel id
      // would be indistinguishable from the canonical one in a URL or a
      // screenshot.
      allow read: if isActiveAccount();
      allow write: if false;

      // Per-sender rate-limit state. This is the ONLY document a sender
      // may write besides the message itself, both must land in the same
      // commit, and the message rule verifies this document's
      // post-commit contents with getAfter(). Sending therefore REQUIRES
      // advancing this document, and advancing it requires both limits
      // below to allow it — every comparison against request.time, the
      // server's clock, never a client-supplied value.
      //
      //   floor    3s between messages   — stops flooding
      //   window   200 messages per FIXED one-hour window — stops a
      //            valid account sustaining 1,200/h (the floor's
      //            theoretical max)
      //
      // The window is FIXED (tumbling), not rolling: `windowStartAt` is
      // pinned at the first message of a window and stays put until a
      // full hour has passed from THAT instant, at which point the next
      // message opens a fresh window at a count of one. Nothing decays
      // continuously. The honest consequence is a boundary case — an
      // account may send 200 late in one window and 200 early in the
      // next, i.e. up to 400 across two adjacent hours — which is still
      // a 3x reduction on the floor's 1,200/h and costs far less than
      // the per-message bookkeeping a true sliding window would need.
      //
      // 200/h is ~3.3 a minute sustained, far above real conversation
      // and far below a useful spam volume; a human hitting it is
      // extraordinary, a script hitting it is the point.
      match /senders/{senderId} {
        allow read: if isOwner(senderId);

        allow create: if isOwner(senderId) &&
            isActiveAccount() &&
            channelId == 'main' &&
            request.resource.data.keys().hasOnly([
              'lastMessageAt', 'lastMessageId', 'windowStartAt', 'windowCount'
            ]) &&
            request.resource.data.lastMessageAt == request.time &&
            request.resource.data.lastMessageId is string &&
            // A first-ever send opens the window at exactly one message.
            request.resource.data.windowStartAt == request.time &&
            request.resource.data.windowCount == 1;

        allow update: if isOwner(senderId) &&
            isActiveAccount() &&
            channelId == 'main' &&
            request.resource.data.keys().hasOnly([
              'lastMessageAt', 'lastMessageId', 'windowStartAt', 'windowCount'
            ]) &&
            request.resource.data.lastMessageAt == request.time &&
            request.resource.data.lastMessageId is string &&
            // 1. the per-message floor
            request.time > resource.data.lastMessageAt +
                duration.value(3, 's') &&
            // 2. the fixed window: either it is still running, in
            //    which case the count advances by exactly one and stays
            //    within the cap, or the hour has fully elapsed and the
            //    next message opens a new window at one.
            (
              request.time < resource.data.windowStartAt +
                      duration.value(1, 'h')
                ? (
                    request.resource.data.windowStartAt ==
                        resource.data.windowStartAt &&
                    request.resource.data.windowCount ==
                        resource.data.windowCount + 1 &&
                    request.resource.data.windowCount <= 200
                  )
                : (
                    request.resource.data.windowStartAt == request.time &&
                    request.resource.data.windowCount == 1
                  )
            );

        // Deleting would reset both limits, so it is never allowed.
        allow delete: if false;
      }

      match /messages/{messageId} {
        // Public to every ACTIVE signed-in account, and to nobody else.
        // Restriction is enforced on the account document rather than on
        // request.auth alone, because a banned user can still hold a
        // valid ID token for up to an hour.
        allow read: if isActiveAccount();

        // isVerified() reads request.auth.token.email_verified — the ID
        // token's own claim, which Firebase Auth sets and refreshes, so
        // it cannot be forged from a modified client the way a Firestore
        // profile field could. Publishing to the whole community is the
        // most outbound action in the product, so it follows the same
        // policy as DMs, rooms and Moments. READING stays open to
        // unverified accounts (see the read rule above): a new account
        // should be able to see the room it is joining.
        allow create: if isVerified() &&
            isActiveAccount() &&
            channelId == 'main' &&
            // Exactly these fields, nothing smuggled alongside.
            request.resource.data.keys().hasOnly([
              'senderId', 'senderName', 'senderPhotoUrl', 'senderIsCreator',
              'senderIsStaff', 'content', 'sentAt', 'isDeleted', 'deletedBy',
              'deletedAt'
            ]) &&
            // Authorship and time are the server's, not the client's.
            request.resource.data.senderId == request.auth.uid &&
            request.resource.data.sentAt == request.time &&
            // Denormalised identity must match the sender's real profile
            // document, so a public feed cannot be used to impersonate
            // another member (or "YO Voice Support") by typing a name.
            request.resource.data.senderName ==
                get(/databases/$(database)/documents/users/$(request.auth.uid))
                  .data.displayName &&
            request.resource.data.senderIsCreator ==
                (get(/databases/$(database)/documents/users/$(request.auth.uid))
                  .data.get('accountType', 'personal') == 'creator') &&
            // Staff badge is the token claim, so it cannot be self-awarded.
            request.resource.data.senderIsStaff == isStaff() &&
            // Content: present, non-blank after trimming, bounded.
            request.resource.data.content is string &&
            request.resource.data.content.size() <= 500 &&
            request.resource.data.content.trim().size() > 0 &&
            // Nothing arrives pre-deleted.
            request.resource.data.isDeleted == false &&
            request.resource.data.deletedBy == null &&
            request.resource.data.deletedAt == null &&
            // Both rate limits: the sender's state must, after this same
            // commit, point at THIS message and THIS request's time. One
            // commit can only leave the document in one state, so a batch
            // of many messages can satisfy it for at most one of them.
            getAfter(
              /databases/$(database)/documents/globalChat/$(channelId)/senders/$(request.auth.uid)
            ).data.lastMessageAt == request.time &&
            getAfter(
              /databases/$(database)/documents/globalChat/$(channelId)/senders/$(request.auth.uid)
            ).data.lastMessageId == messageId;

        // Soft delete only, by the author or by platform staff. Content
        // and authorship are frozen: an author cannot rewrite history
        // after the fact, and a moderator cannot re-attribute a message.
        allow update: if isActiveAccount() &&
            (resource.data.senderId == request.auth.uid || isStaff()) &&
            request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['isDeleted', 'deletedBy', 'deletedAt', 'content']) &&
            request.resource.data.isDeleted == true &&
            request.resource.data.deletedBy == request.auth.uid &&
            request.resource.data.deletedAt == request.time &&
            request.resource.data.content == '' &&
            request.resource.data.senderId == resource.data.senderId &&
            request.resource.data.sentAt == resource.data.sentAt;

        // Hard delete is reserved for the Admin SDK (which bypasses
        // rules), so the public record always shows that something was
        // removed rather than silently losing it.
        allow delete: if false;
      }
    }

    // ---------------------------------------------------------------
    // ABUSE REPORTS. Write-only for members: you can file one, you can
    // never read, edit or withdraw one, and you cannot enumerate what
    // anyone else has reported. Staff read and triage them.
    //
    // UNIQUENESS is structural rather than checked: the document id must
    // be `{reporterId}_{targetType}_{targetId}`, so a second report of
    // the same thing by the same person is a create against an existing
    // document, which Firestore rejects on its own. No counter, no query,
    // nothing to race.
    //
    // Workflow fields (status, assignee, resolution) are NOT accepted on
    // create — staff add them later through the staff-only update rule,
    // so a reporter can never pre-close or self-assign a report.
    // ---------------------------------------------------------------
    match /reports/{reportId} {
      // Staff read the queue. Workflow mutations are NOT client writes:
      // triage is a privileged staff action, so it goes through the
      // `moderateReport` callable, which uses the Admin SDK and bypasses
      // these rules. Denying update/delete here means there is exactly
      // one path that can move a report's status, and it is the one that
      // checks the role, enforces transitions and writes the audit
      // record. Reporter-created evidence is immutable by construction.
      allow read: if isActiveStaff();
      allow update, delete: if false;

      // NOT gated on isVerified(), deliberately. isVerified() gates
      // outbound/spam-prone publishing (see its definition above);
      // reporting is a SAFETY action and sits with blocking, which that
      // policy explicitly leaves available to a freshly-registered
      // account. Someone being harassed on their first day must be able
      // to say so. Volume is bounded by the deterministic id, the 30s
      // cooldown and the 20-per-window cap instead.
      allow create: if isActiveAccount() &&
          // The id is the uniqueness mechanism.
          reportId == request.auth.uid + '_' +
              request.resource.data.targetType + '_' +
              request.resource.data.targetId &&
          request.resource.data.keys().hasOnly([
            'reporterId', 'targetType', 'targetId', 'reportedUserId',
            'contextPath', 'reason', 'note', 'createdAt', 'status'
          ]) &&
          request.resource.data.reporterId == request.auth.uid &&
          request.resource.data.createdAt == request.time &&
          // The ONLY workflow field a client may supply, pinned to the
          // one legal opening value. Assignment, resolution, the acting
          // moderator and every review timestamp are added later by
          // `moderateReport` through the Admin SDK — a reporter cannot
          // file something pre-claimed, pre-resolved or attributed to a
          // moderator who never touched it.
          request.resource.data.status == 'open' &&
          request.resource.data.reason in [
            'spam', 'harassment', 'hate', 'sexual', 'violence',
            'selfHarm', 'impersonation', 'other'
          ] &&
          request.resource.data.note is string &&
          request.resource.data.note.size() <= 300 &&
          request.resource.data.targetId is string &&
          request.resource.data.targetId.size() > 0 &&
          request.resource.data.targetId.size() <= 128 &&
          request.resource.data.reportedUserId is string &&
          request.resource.data.reportedUserId != request.auth.uid &&
          (
            request.resource.data.contextPath == null ||
            (
              request.resource.data.contextPath is string &&
              request.resource.data.contextPath.size() <= 300
            )
          ) &&
          // The target must EXIST, and reportedUserId must be the person
          // who actually owns it — otherwise the collection becomes a
          // free-text channel for naming arbitrary uids.
          (
            (
              request.resource.data.targetType == 'globalMessage' &&
              exists(/databases/$(database)/documents/globalChat/main/messages/$(request.resource.data.targetId)) &&
              request.resource.data.reportedUserId ==
                  get(/databases/$(database)/documents/globalChat/main/messages/$(request.resource.data.targetId))
                    .data.senderId
            ) ||
            (
              request.resource.data.targetType == 'user' &&
              exists(/databases/$(database)/documents/users/$(request.resource.data.targetId)) &&
              request.resource.data.reportedUserId ==
                  request.resource.data.targetId
            )
          ) &&
          // Rate limit, same shape as Global Chat's sender state.
          getAfter(
            /databases/$(database)/documents/reportLimits/$(request.auth.uid)
          ).data.lastReportAt == request.time &&
          getAfter(
            /databases/$(database)/documents/reportLimits/$(request.auth.uid)
          ).data.lastReportId == reportId;
    }

    // Reporter rate-limit state: 30s between reports, and at most 20
    // inside each FIXED 24-hour window. Owner-writable only through
    // these exact shapes, never readable by anyone else, never
    // deletable. Same tumbling-window semantics as the sender state —
    // see there for the boundary behaviour.
    match /reportLimits/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId) &&
          isActiveAccount() &&
          request.resource.data.keys().hasOnly([
            'lastReportAt', 'lastReportId', 'windowStartAt', 'windowCount'
          ]) &&
          request.resource.data.lastReportAt == request.time &&
          request.resource.data.lastReportId is string &&
          request.resource.data.windowStartAt == request.time &&
          request.resource.data.windowCount == 1;

      allow update: if isOwner(userId) &&
          isActiveAccount() &&
          request.resource.data.keys().hasOnly([
            'lastReportAt', 'lastReportId', 'windowStartAt', 'windowCount'
          ]) &&
          request.resource.data.lastReportAt == request.time &&
          request.resource.data.lastReportId is string &&
          request.time > resource.data.lastReportAt +
              duration.value(30, 's') &&
          (
            request.time < resource.data.windowStartAt +
                    duration.value(24, 'h')
              ? (
                  request.resource.data.windowStartAt ==
                      resource.data.windowStartAt &&
                  request.resource.data.windowCount ==
                      resource.data.windowCount + 1 &&
                  request.resource.data.windowCount <= 20
                )
              : (
                  request.resource.data.windowStartAt == request.time &&
                  request.resource.data.windowCount == 1
                )
          );

      allow delete: if false;
    }

    // Moderation history. Written only by Cloud Functions through the
    // Admin SDK (which bypasses rules); no client may read it, because
    // it records who moderated whom and quotes removed content.
    match /adminAuditLogs/{entryId} {
      allow read, write: if false;
    }

    match /clubs/{clubId} {
      // An ordinary club's metadata stays readable to any signed-in user
      // — unchanged. A Family Room's does not: its name, description and
      // member count are private to the people in it and to anyone
      // holding a live invitation. The `!= 'family'` test short-circuits
      // first, so ordinary club reads perform no extra document lookups.
      allow get: if isSignedIn() && (
            resource.data.get('type', 'community') != 'family' ||
            isClubMember(clubId) ||
            hasPendingClubInvite(clubId, request.auth.uid)
          );

      // LIST is separate from GET on purpose, and this is not a
      // stylistic split. A per-document condition does not protect a
      // collection listing: during list evaluation `resource.data` is not
      // the document, so `resource.data.get('type', 'community')` fell
      // back to its default and a signed-in outsider could enumerate
      // `clubs` and read a family room's name straight out of it.
      // Verified against the emulator, not assumed.
      //
      // Nothing may list this collection. The one query that used to —
      // countOwnedClubs()'s owner-scoped count for the premium gate — now
      // counts `users/{uid}/clubs` where role == 'owner' instead, a
      // collection the caller already owns. With that gone there is no
      // legitimate listing left, so the honest rule is `false`: a family
      // room is undiscoverable because the query cannot run, not because
      // no screen happens to call it today.
      allow list: if false;

      // Two creation paths, deliberately disjoint on `type`:
      //
      //  - community (the default, and every club that already exists):
      //    a Premium capability, exactly as ADR-024 specifies. Untouched.
      //  - family: free for any verified account, but pinned to the
      //    deterministic id `family_{uid}`. That id IS the per-account
      //    limit — rules cannot count documents, but they can refuse
      //    every id except the one this account owns, so a second Family
      //    Room has nowhere to be written. Being invited into someone
      //    else's family space is unaffected: that writes a member
      //    document, not a club.
      allow create: if isVerified() &&
          request.resource.data.ownerId == request.auth.uid &&
          (
            (
              request.resource.data.get('type', 'community') == 'community' &&
              hasActivePremium()
            ) ||
            (
              request.resource.data.get('type', 'community') == 'family' &&
              clubId == 'family_' + request.auth.uid
            )
          );

      // Ownership and type are immutable for every club. Without this a
      // family space could be relabelled 'community' and lose its
      // privacy boundary in one write.
      allow update: if (
            isClubOwner(clubId) ||
            canManageClub(clubId) ||
            (
              hasPendingClubInvite(clubId, request.auth.uid) &&
              request.resource.data.memberCount == resource.data.memberCount + 1 &&
              request.resource.data.ownerId == resource.data.ownerId
            )
          ) &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.get('type', 'community') ==
              resource.data.get('type', 'community');
      allow delete: if isClubOwner(clubId);

      match /members/{memberId} {
        // Club rosters are only ever read directly (per-club queries or
        // single-doc gets), never via collectionGroup — see
        // rooms/{roomId}/roomMembers below for why that distinction matters.
        // Members can browse the roster; anyone can always read their own
        // membership record (e.g. to check their own role).
        allow read: if isClubMember(clubId) ||
            (isSignedIn() && resource.data.userId == request.auth.uid);
        allow create: if isSignedIn() &&
            request.auth.uid == memberId &&
            (
              get(
                /databases/$(database)/documents/clubs/$(clubId)/invites/$(memberId)
              ).data.inviteeId == memberId ||
              (
                request.resource.data.role == 'owner' &&
                get(
                  /databases/$(database)/documents/clubs/$(clubId)
                ).data.ownerId == request.auth.uid
              )
            );
        allow update: if isSignedIn() &&
            request.resource.data.userId == resource.data.userId &&
            request.resource.data.joinedAt == resource.data.joinedAt &&
            (
              (
                request.auth.uid == memberId &&
                request.resource.data.role == resource.data.role
              ) ||
              (
                clubRole(clubId) in ['owner', 'coOwner'] &&
                memberId != request.auth.uid &&
                resource.data.role != 'owner' &&
                request.resource.data.role != 'owner' &&
                clubRolePower(clubRole(clubId)) > clubRolePower(resource.data.role) &&
                clubRolePower(clubRole(clubId)) > clubRolePower(request.resource.data.role)
              )
            );
        allow delete: if isSignedIn() &&
            canManageClub(clubId) &&
            memberId != request.auth.uid &&
            resource.data.role != 'owner' &&
            clubRolePower(clubRole(clubId)) > clubRolePower(resource.data.role);
      }

      match /invites/{inviteeId} {
        allow read: if isSignedIn() &&
            (
              request.auth.uid == inviteeId ||
              canManageClub(clubId)
            );
        allow create: if isVerified() &&
            canManageClub(clubId) &&
            request.resource.data.inviteeId == inviteeId &&
            request.resource.data.inviterId == request.auth.uid &&
            request.resource.data.status == 'pending' &&
            !exists(
              /databases/$(database)/documents/clubs/$(clubId)/members/$(inviteeId)
            );
        allow update: if false;
        allow delete: if isSignedIn() &&
            (
              request.auth.uid == inviteeId ||
              canManageClub(clubId)
            );
      }

      match /channels/{channelId} {
        allow read: if isClubMember(clubId);
        allow create, update, delete: if isClubOwner(clubId) || canManageClub(clubId);

        match /messages/{messageId} {
          allow read: if isClubMember(clubId);
          allow create: if isVerified() &&
              isClubMember(clubId) &&
              request.resource.data.senderId == request.auth.uid &&
              request.resource.data.clubId == clubId &&
              request.resource.data.channelId == channelId;
          allow update: if isClubMember(clubId) &&
              resource.data.senderId == request.auth.uid &&
              request.resource.data.senderId == resource.data.senderId;
          allow delete: if false;
        }
      }

      // Family Moments. Deliberately NOT in the global `voiceMoments`
      // collection: living under the club document means the private
      // boundary is the club membership check itself, and there is no
      // query anywhere that could sweep these into a public feed. Losing
      // membership — leaving, removal, a block, account deletion —
      // removes the member document and with it every read below.
      match /moments/{momentId} {
        allow read: if isClubMember(clubId);
        allow create: if isVerified() &&
            isClubMember(clubId) &&
            request.resource.data.authorId == request.auth.uid &&
            request.resource.data.clubId == clubId;
        // Authors may edit their own caption; nobody may reassign one.
        allow update: if isClubMember(clubId) &&
            resource.data.authorId == request.auth.uid &&
            request.resource.data.authorId == resource.data.authorId;
        allow delete: if isClubMember(clubId) &&
            (
              resource.data.authorId == request.auth.uid ||
              canManageClub(clubId)
            );
      }

      // Quick check-ins: ordinary append-only status updates ("I'm home",
      // "On my way", ...). No location of any kind is accepted or stored,
      // and each row is scoped to the account that wrote it. Immutable
      // once written, so a check-in cannot be edited to say something the
      // person never said.
      match /checkIns/{checkInId} {
        allow read: if isClubMember(clubId);
        allow create: if isVerified() &&
            isClubMember(clubId) &&
            request.resource.data.userId == request.auth.uid &&
            request.resource.data.clubId == clubId &&
            request.resource.data.status in [
              'home', 'onMyWay', 'allGood', 'callMe'
            ] &&
            !('latitude' in request.resource.data) &&
            !('longitude' in request.resource.data) &&
            !('location' in request.resource.data);
        allow update: if false;
        allow delete: if isClubMember(clubId) &&
            (
              resource.data.userId == request.auth.uid ||
              canManageClub(clubId)
            );
      }
    }

    match /rooms/{roomId} {
      allow read: if isSignedIn();

      allow create: if isVerified() &&
          request.resource.data.hostId == request.auth.uid;

      // Non-host writers (joining/leaving) are only ever trusted with this
      // narrow set of lifecycle/counter fields — never name, description,
      // visibility, imageUrl, or hostId itself. `exists()`-based membership
      // checks are deliberately NOT required here: joinRoom() writes the
      // participant doc and this counter update in the same transaction,
      // and a plain exists() check can't see the other pending write in
      // that same transaction (that's what getAfter() is for). Precise
      // value validation for these counters belongs in a Cloud Function
      // trigger, not here.
      allow update: if isSignedIn() &&
          (
            resource.data.hostId == request.auth.uid
              ? request.resource.data.hostId == resource.data.hostId
              : request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly([
                    'participantCount', 'memberCount', 'speakerCount',
                    'isLive', 'endedAt', 'updatedAt',
                  ])
          );

      allow delete: if isRoomHost(roomId);

      match /participants/{participantId} {
        allow read: if isSignedIn();

        // Self-service creation must mirror what joinRoom()/createRoom()
        // actually write: the room's real host joins as host+speaker,
        // everyone else joins as a plain listener. Promoting to speaker
        // or moderator status only ever happens through a host-driven
        // update below.
        //
        // createRoom() writes the room doc and this participant doc in the
        // same batch, so a plain get()/isRoomHost() wouldn't see the room's
        // hostId yet — getAfter() resolves against the state once the whole
        // transaction/batch has applied, which is what we need here.
        allow create: if isSignedIn() &&
            request.auth.uid == participantId &&
            request.resource.data.userId == request.auth.uid &&
            (
              (
                getAfter(
                  /databases/$(database)/documents/rooms/$(roomId)
                ).data.hostId == request.auth.uid &&
                request.resource.data.role == 'host' &&
                request.resource.data.isSpeaker == true
              ) ||
              (
                getAfter(
                  /databases/$(database)/documents/rooms/$(roomId)
                ).data.hostId != request.auth.uid &&
                request.resource.data.role == 'listener' &&
                request.resource.data.isSpeaker == false &&
                request.resource.data.isHandRaised == false
              )
            );

        // A participant may only mute themselves or raise/lower their own
        // hand. Promotion to speaker, moderator mute-of-others, and role
        // changes are host-only.
        allow update: if isSignedIn() &&
            (
              isRoomHost(roomId) ||
              (
                request.auth.uid == participantId &&
                request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['isMuted', 'isHandRaised', 'updatedAt'])
              )
            );

        allow delete: if isSignedIn() &&
            (request.auth.uid == participantId || isRoomHost(roomId));
      }

      match /roomMembers/{memberId} {
        // Named distinctly from clubs/{clubId}/members on purpose:
        // watchMyCommunities() (room_service.dart) runs a
        // collectionGroup('roomMembers') query filtered to `userId == caller`.
        // Firestore rejects a collectionGroup query outright unless EVERY
        // match block sharing that collection name — anywhere in the whole
        // ruleset — has a rule provable from the query's filter alone, with
        // no exists()/get(). clubs/{clubId}/members legitimately needs
        // exists() for its own (non-collectionGroup) roster-browsing reads,
        // and combining it via `||` with a provable clause does NOT satisfy
        // Firestore's provability check the way its docs suggest — verified
        // against the emulator, not just assumed. Keeping room membership
        // under its own collection name sidesteps that entirely: this rule
        // needs no exists()/get(), so the collectionGroup query it powers
        // stays valid regardless of what clubs/{clubId}/members does.
        allow read: if isSignedIn();
        allow create: if isSignedIn() &&
            request.auth.uid == memberId;
        allow update, delete: if isSignedIn() &&
            (
              request.auth.uid == memberId ||
              isRoomHost(roomId)
            );
      }

      match /messages/{messageId} {
        // Public rooms keep their chat readable without having joined yet
        // (matches how Discover lets you preview a room before entering).
        // Private/club-lounge rooms require an actual participant, member,
        // or host relationship — previously any signed-in user could read
        // any room's chat regardless of visibility.
        allow read: if isSignedIn() &&
            (
              roomExists(roomId) &&
              (
                get(
                  /databases/$(database)/documents/rooms/$(roomId)
                ).data.visibility == 'public' ||
                isRoomParticipant(roomId) ||
                isRoomMember(roomId) ||
                isRoomHost(roomId)
              )
            );
        allow create: if isVerified() &&
            request.resource.data.senderId == request.auth.uid &&
            (
              isRoomParticipant(roomId) ||
              isRoomMember(roomId) ||
              isRoomHost(roomId)
            );
        // Room chat reactions (Rooms 2.0): people in the room may toggle
        // the reactions map and NOTHING else — sender, text and
        // timestamps stay immutable. Deletes are host moderation only.
        allow update: if isSignedIn() &&
            (
              isRoomParticipant(roomId) ||
              isRoomMember(roomId) ||
              isRoomHost(roomId)
            ) &&
            request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['reactions']);
        allow delete: if isRoomHost(roomId);
      }

      // Broadcast Room raise-hand queue (room_experience_service.dart,
      // used by podcast_room_screen.dart) — had no rules at all, so every
      // hand-raise request was silently rejected.
      match /handRequests/{requesterId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() &&
            request.auth.uid == requesterId &&
            roomExists(roomId) &&
            get(
              /databases/$(database)/documents/rooms/$(roomId)
            ).data.experience == 'broadcast';
        allow update: if false;
        allow delete: if isSignedIn() &&
            (request.auth.uid == requesterId || isRoomHost(roomId));
      }
    }
    match /voiceMoments/{momentId} {
      allow read: if isSignedIn();
      allow create: if isVerified() &&
          request.resource.data.authorId == request.auth.uid;
      // Non-author updates used to allow likeCount/commentCount to be set to
      // any value at all — now each write must actually correspond to the
      // caller's own like being added/removed (toggleLike() in
      // home_feed_service.dart runs both writes in one transaction, so
      // existsAfter() correctly reflects the like doc's post-write state),
      // or a plain +1 for a new comment.
      allow update: if isSignedIn() &&
          (
            resource.data.authorId == request.auth.uid ||
            (
              request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['likeCount', 'updatedAt']) &&
              (
                (
                  request.resource.data.likeCount ==
                      resource.data.likeCount + 1 &&
                  existsAfter(
                    /databases/$(database)/documents/voiceMoments/$(momentId)/likes/$(request.auth.uid)
                  )
                ) ||
                (
                  request.resource.data.likeCount ==
                      resource.data.likeCount - 1 &&
                  !existsAfter(
                    /databases/$(database)/documents/voiceMoments/$(momentId)/likes/$(request.auth.uid)
                  )
                )
              )
            ) ||
            (
              request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['commentCount', 'updatedAt']) &&
              request.resource.data.commentCount ==
                  resource.data.commentCount + 1
            )
          );
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;

      match /likes/{userId} {
        allow read: if isSignedIn();
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isVerified() &&
            request.resource.data.authorId == request.auth.uid &&
            (
              (
                request.resource.data.type == 'text' &&
                request.resource.data.text is string &&
                request.resource.data.text.size() > 0 &&
                request.resource.data.text.size() <= 1000
              ) ||
              (
                request.resource.data.type == 'voice' &&
                request.resource.data.text is string &&
                request.resource.data.text.size() <= 140 &&
                request.resource.data.audioUrl is string &&
                request.resource.data.audioUrl.size() > 0 &&
                request.resource.data.storagePath is string &&
                request.resource.data.durationSeconds is int &&
                request.resource.data.durationSeconds >= 1 &&
                request.resource.data.durationSeconds <= 60
              )
            );
        allow update: if false;
        allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
      }
    }

  }
}
