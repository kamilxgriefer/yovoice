rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isOneOfUsers(firstUserId, secondUserId) {
      return isSignedIn() &&
          (request.auth.uid == firstUserId ||
           request.auth.uid == secondUserId);
    }

    function conversationExists(conversationId) {
      return exists(
        /databases/$(database)/documents/conversations/$(conversationId)
      );
    }

    function isConversationParticipant(conversationId) {
      return isSignedIn() &&
          conversationExists(conversationId) &&
          request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participantIds;
    }

    function roomExists(roomId) {
      return exists(
        /databases/$(database)/documents/rooms/$(roomId)
      );
    }

    function isRoomHost(roomId) {
      return isSignedIn() &&
          roomExists(roomId) &&
          get(
            /databases/$(database)/documents/rooms/$(roomId)
          ).data.hostId == request.auth.uid;
    }

    function isRoomParticipant(roomId) {
      return isSignedIn() && exists(
        /databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid)
      );
    }

    function isRoomMember(roomId) {
      return isSignedIn() && exists(
        /databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)
      );
    }


    function clubExists(clubId) {
      return exists(
        /databases/$(database)/documents/clubs/$(clubId)
      );
    }

    function isClubMember(clubId) {
      return isSignedIn() && exists(
        /databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid)
      );
    }

    function isClubOwner(clubId) {
      return isSignedIn() && clubExists(clubId) &&
          get(
            /databases/$(database)/documents/clubs/$(clubId)
          ).data.ownerId == request.auth.uid;
    }

    function hasPendingClubInvite(clubId, userId) {
      return isSignedIn() && exists(
        /databases/$(database)/documents/clubs/$(clubId)/invites/$(userId)
      ) && get(
        /databases/$(database)/documents/clubs/$(clubId)/invites/$(userId)
      ).data.inviteeId == userId;
    }

    function clubRole(clubId) {
      return get(
        /databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid)
      ).data.role;
    }

    function canManageClub(clubId) {
      return isClubMember(clubId) &&
          clubRole(clubId) in ['owner', 'coOwner', 'admin'];
    }

    function clubRolePower(role) {
      return role == 'owner' ? 60 :
          role == 'coOwner' ? 50 :
          role == 'admin' ? 40 :
          role == 'moderator' ? 30 :
          role == 'member' ? 20 : 10;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if false;

      match /friendRequests/{senderId} {
        allow read: if isOwner(userId);
        allow create: if isSignedIn() &&
            request.auth.uid == senderId &&
            senderId != userId &&
            request.resource.data.senderId == senderId;
        allow update: if false;
        allow delete: if isOneOfUsers(userId, senderId);
      }

      match /friends/{friendId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOneOfUsers(userId, friendId) &&
            userId != friendId;
      }


      match /clubs/{clubId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) || canManageClub(clubId);
        allow update: if isOwner(userId) || canManageClub(clubId);
        allow delete: if isOwner(userId) || canManageClub(clubId);
      }
    }

    match /conversations/{conversationId} {
      allow read: if isSignedIn() &&
          request.auth.uid in resource.data.participantIds;

      allow create: if isSignedIn() &&
          request.resource.data.participantIds is list &&
          request.resource.data.participantIds.size() == 2 &&
          request.auth.uid in request.resource.data.participantIds;

      allow update: if isSignedIn() &&
          request.auth.uid in resource.data.participantIds &&
          request.resource.data.participantIds == resource.data.participantIds;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isConversationParticipant(conversationId);
        allow create: if isConversationParticipant(conversationId) &&
            request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /clubs/{clubId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
          request.resource.data.ownerId == request.auth.uid;
      allow update: if isClubOwner(clubId) ||
          canManageClub(clubId) ||
          (
            hasPendingClubInvite(clubId, request.auth.uid) &&
            request.resource.data.memberCount == resource.data.memberCount + 1 &&
            request.resource.data.ownerId == resource.data.ownerId
          );
      allow delete: if isClubOwner(clubId);

      match /members/{memberId} {
        allow read: if isClubMember(clubId);
        allow create: if isSignedIn() &&
            request.auth.uid == memberId &&
            (
              get(
                /databases/$(database)/documents/clubs/$(clubId)/invites/$(memberId)
              ).data.inviteeId == memberId ||
              (
                request.resource.data.role == 'owner' &&
                get(
                  /databases/$(database)/documents/clubs/$(clubId)
                ).data.ownerId == request.auth.uid
              )
            );
        allow update: if isSignedIn() &&
            request.resource.data.userId == resource.data.userId &&
            request.resource.data.joinedAt == resource.data.joinedAt &&
            (
              (
                request.auth.uid == memberId &&
                request.resource.data.role == resource.data.role
              ) ||
              (
                clubRole(clubId) in ['owner', 'coOwner'] &&
                memberId != request.auth.uid &&
                resource.data.role != 'owner' &&
                request.resource.data.role != 'owner' &&
                clubRolePower(clubRole(clubId)) > clubRolePower(resource.data.role) &&
                clubRolePower(clubRole(clubId)) > clubRolePower(request.resource.data.role)
              )
            );
        allow delete: if isSignedIn() &&
            canManageClub(clubId) &&
            memberId != request.auth.uid &&
            resource.data.role != 'owner' &&
            clubRolePower(clubRole(clubId)) > clubRolePower(resource.data.role);
      }

      match /invites/{inviteeId} {
        allow read: if isSignedIn() &&
            (
              request.auth.uid == inviteeId ||
              canManageClub(clubId)
            );
        allow create: if isSignedIn() &&
            canManageClub(clubId) &&
            request.resource.data.inviteeId == inviteeId &&
            request.resource.data.inviterId == request.auth.uid &&
            request.resource.data.status == 'pending' &&
            !exists(
              /databases/$(database)/documents/clubs/$(clubId)/members/$(inviteeId)
            );
        allow update: if false;
        allow delete: if isSignedIn() &&
            (
              request.auth.uid == inviteeId ||
              canManageClub(clubId)
            );
      }

      match /channels/{channelId} {
        allow read: if isClubMember(clubId);
        allow create, update, delete: if isClubOwner(clubId) || canManageClub(clubId);

        match /messages/{messageId} {
          allow read: if isClubMember(clubId);
          allow create: if isClubMember(clubId) &&
              request.resource.data.senderId == request.auth.uid &&
              request.resource.data.clubId == clubId &&
              request.resource.data.channelId == channelId;
          allow update: if isClubMember(clubId) &&
              resource.data.senderId == request.auth.uid &&
              request.resource.data.senderId == resource.data.senderId;
          allow delete: if false;
        }
      }
    }

    match /rooms/{roomId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
          request.resource.data.hostId == request.auth.uid;

      // Non-host writers (joining/leaving) are only ever trusted with this
      // narrow set of lifecycle/counter fields — never name, description,
      // visibility, imageUrl, or hostId itself. `exists()`-based membership
      // checks are deliberately NOT required here: joinRoom() writes the
      // participant doc and this counter update in the same transaction,
      // and a plain exists() check can't see the other pending write in
      // that same transaction (that's what getAfter() is for). Precise
      // value validation for these counters belongs in a Cloud Function
      // trigger, not here.
      allow update: if isSignedIn() &&
          (
            resource.data.hostId == request.auth.uid
              ? request.resource.data.hostId == resource.data.hostId
              : request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly([
                    'participantCount', 'memberCount', 'speakerCount',
                    'isLive', 'endedAt', 'updatedAt',
                  ])
          );

      allow delete: if isRoomHost(roomId);

      match /participants/{participantId} {
        allow read: if isSignedIn();

        // Self-service creation must mirror what joinRoom()/createRoom()
        // actually write: the room's real host joins as host+speaker,
        // everyone else joins as a plain listener. Promoting to speaker
        // or moderator status only ever happens through a host-driven
        // update below.
        //
        // createRoom() writes the room doc and this participant doc in the
        // same batch, so a plain get()/isRoomHost() wouldn't see the room's
        // hostId yet — getAfter() resolves against the state once the whole
        // transaction/batch has applied, which is what we need here.
        allow create: if isSignedIn() &&
            request.auth.uid == participantId &&
            request.resource.data.userId == request.auth.uid &&
            (
              (
                getAfter(
                  /databases/$(database)/documents/rooms/$(roomId)
                ).data.hostId == request.auth.uid &&
                request.resource.data.role == 'host' &&
                request.resource.data.isSpeaker == true
              ) ||
              (
                getAfter(
                  /databases/$(database)/documents/rooms/$(roomId)
                ).data.hostId != request.auth.uid &&
                request.resource.data.role == 'listener' &&
                request.resource.data.isSpeaker == false &&
                request.resource.data.isHandRaised == false
              )
            );

        // A participant may only mute themselves or raise/lower their own
        // hand. Promotion to speaker, moderator mute-of-others, and role
        // changes are host-only.
        allow update: if isSignedIn() &&
            (
              isRoomHost(roomId) ||
              (
                request.auth.uid == participantId &&
                request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['isMuted', 'isHandRaised', 'updatedAt'])
              )
            );

        allow delete: if isSignedIn() &&
            (request.auth.uid == participantId || isRoomHost(roomId));
      }

      match /members/{memberId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() &&
            request.auth.uid == memberId;
        allow update, delete: if isSignedIn() &&
            (
              request.auth.uid == memberId ||
              isRoomHost(roomId)
            );
      }

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() &&
            request.resource.data.senderId == request.auth.uid &&
            (
              isRoomParticipant(roomId) ||
              isRoomMember(roomId) ||
              isRoomHost(roomId)
            );
        allow update, delete: if false;
      }
    }
    match /voiceMoments/{momentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
          request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() &&
          (resource.data.authorId == request.auth.uid ||
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'commentCount', 'updatedAt']));
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;

      match /likes/{userId} {
        allow read: if isSignedIn();
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() &&
            request.resource.data.authorId == request.auth.uid &&
            (
              (
                request.resource.data.type == 'text' &&
                request.resource.data.text is string &&
                request.resource.data.text.size() > 0 &&
                request.resource.data.text.size() <= 1000
              ) ||
              (
                request.resource.data.type == 'voice' &&
                request.resource.data.text is string &&
                request.resource.data.text.size() <= 140 &&
                request.resource.data.audioUrl is string &&
                request.resource.data.audioUrl.size() > 0 &&
                request.resource.data.storagePath is string &&
                request.resource.data.durationSeconds is int &&
                request.resource.data.durationSeconds >= 1 &&
                request.resource.data.durationSeconds <= 60
              )
            );
        allow update: if false;
        allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
      }
    }

  }
}
