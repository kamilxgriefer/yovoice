rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Auth disabling/revocation does not invalidate an already-issued token
    // immediately. Mirror the authoritative Firestore account status wherever
    // the two-document cross-service budget permits it. Existing Club media
    // instead consumes that budget on its root + live membership/ban mirror.
    function isActiveUser(userId) {
      let userPath = /databases/(default)/documents/users/$(userId);
      return isSignedIn() &&
          request.auth.uid == userId &&
          firestore.exists(userPath) &&
          firestore.get(userPath).data.get('banned', false) != true &&
          firestore.get(userPath).data.get('disabled', false) != true &&
          firestore.get(userPath).data.get('deleted', false) != true &&
          firestore.get(userPath).data.get('status', '') != 'deleted' &&
          !firestore.get(userPath).data.keys().hasAny(['authDeletedAt']);
    }

    function isAllowedImageType() {
      return request.resource.contentType in [
        'image/jpeg', 'image/png', 'image/webp'
      ];
    }

    function isAllowedAudioType() {
      return request.resource.contentType in [
        'audio/mp4', 'audio/m4a', 'audio/x-m4a'
      ];
    }

    function isValidImagePayload(maxBytes) {
      return request.resource.size >= 128 &&
          request.resource.size <= maxBytes &&
          isAllowedImageType();
    }

    function isValidAudioPayload() {
      return request.resource.size >= 1024 &&
          request.resource.size <= 12 * 1024 * 1024 &&
          isAllowedAudioType();
    }

    function isAllowedVideoType() {
      return request.resource.contentType in [
        'video/mp4', 'video/quicktime', 'video/webm'
      ];
    }

    function isValidVideoPayload() {
      return request.resource.size >= 1024 &&
          request.resource.size <= 64 * 1024 * 1024 &&
          isAllowedVideoType();
    }

    function videoExtensionMatchesMime(fileName) {
      return (
        fileName.matches('.*[.]mp4') &&
        request.resource.contentType == 'video/mp4'
      ) || (
        fileName.matches('.*[.]mov') &&
        request.resource.contentType == 'video/quicktime'
      ) || (
        fileName.matches('.*[.]webm') &&
        request.resource.contentType == 'video/webm'
      );
    }

    function imageExtensionMatchesMime(fileName) {
      return (
        fileName.matches('.*[.](jpg|jpeg)') &&
        request.resource.contentType == 'image/jpeg'
      ) || (
        fileName.matches('.*[.]png') &&
        request.resource.contentType == 'image/png'
      ) || (
        fileName.matches('.*[.]webp') &&
        request.resource.contentType == 'image/webp'
      );
    }

    // Profile artwork is private object storage. A callable authorizes the
    // current viewer against the live profile state and returns a
    // generation-bound V4 URL for at most 90 seconds. Direct object reads are
    // available only to the owner while a reservation is live, which supports
    // upload recovery without turning object names into bearer credentials.
    match /users/{userId}/profile/{fileName} {
      function reservationPath(uploadId) {
        return /databases/(default)/documents/profileMediaUploadReservations/$(userId)/uploads/$(uploadId);
      }

      function hasLiveReservation(uploadId, profileKind) {
        let path = reservationPath(uploadId);
        return firestore.exists(path) &&
            firestore.get(path).data.keys().hasOnly([
              'schemaVersion', 'ownerId', 'uploadId', 'kind', 'contentType',
              'size', 'storagePath', 'baseRevision', 'status', 'createdAt',
              'expiresAt'
            ]) &&
            firestore.get(path).data.schemaVersion == 1 &&
            firestore.get(path).data.ownerId == userId &&
            firestore.get(path).data.uploadId == uploadId &&
            firestore.get(path).data.kind == profileKind &&
            firestore.get(path).data.status == 'uploading' &&
            firestore.get(path).data.storagePath ==
                'users/' + userId + '/profile/' + fileName &&
            firestore.get(path).data.expiresAt > request.time;
      }

      function validProfileUpload() {
        return fileName.matches('(avatar|banner)_[a-f0-9]{32}[.](jpg|png|webp)') &&
            imageExtensionMatchesMime(fileName) &&
            isValidImagePayload(2 * 1024 * 1024) &&
            request.resource.metadata.keys().hasOnly([
              'ownerId', 'profileKind', 'uploadId'
            ]) &&
            request.resource.metadata.ownerId == userId &&
            request.resource.metadata.profileKind in ['avatar', 'banner'] &&
            request.resource.metadata.uploadId.matches('[a-f0-9]{32}') &&
            fileName.matches(
              request.resource.metadata.profileKind + '_' +
              request.resource.metadata.uploadId + '[.](jpg|png|webp)'
            ) &&
            hasLiveReservation(
              request.resource.metadata.uploadId,
              request.resource.metadata.profileKind
            ) &&
            firestore.get(
              reservationPath(request.resource.metadata.uploadId)
            ).data.contentType == request.resource.contentType &&
            firestore.get(
              reservationPath(request.resource.metadata.uploadId)
            ).data.size == request.resource.size;
      }

      allow read: if isActiveUser(userId) &&
          resource != null &&
          resource.metadata.keys().hasOnly([
            'ownerId', 'profileKind', 'uploadId'
          ]) &&
          resource.metadata.ownerId == userId &&
          resource.metadata.profileKind in ['avatar', 'banner'] &&
          resource.metadata.uploadId.matches('[a-f0-9]{32}') &&
          hasLiveReservation(
            resource.metadata.uploadId,
            resource.metadata.profileKind
          );
      allow create: if resource == null &&
          isVerified() &&
          isActiveUser(userId) &&
          validProfileUpload();
      allow update: if false;
      allow delete: if false;
    }

    match /room_images/{roomId}/{fileName} {
      function roomPath() {
        return /databases/(default)/documents/rooms/$(roomId);
      }

      function canManageActiveRoom() {
        return isActiveUser(request.auth.uid) &&
            firestore.exists(roomPath()) &&
            !firestore.get(roomPath()).data.keys().hasAny(['serverSchemaVersion', 'serverId']) &&
            firestore.get(roomPath()).data.hostId == request.auth.uid &&
            firestore.get(roomPath()).data.get('status', 'active') == 'active' &&
            firestore.get(roomPath()).data.get('deletionInProgress', false) != true;
      }

      function reservationPath() {
        return /databases/(default)/documents/roomCoverUploadReservations/$(request.resource.metadata.get('reservationId', ''));
      }

      function validRoomImageUpload() {
        let reservationId = request.resource.metadata.get('reservationId', '');
        let reservation = firestore.get(reservationPath()).data;
        return request.resource.metadata.keys().hasOnly([
              'ownerId', 'reservationId', 'roomId'
            ]) &&
            reservationId.matches('[a-f0-9]{40}') &&
            fileName.matches(request.auth.uid + '_[a-f0-9]{32}[.](jpg|png)') &&
            imageExtensionMatchesMime(fileName) &&
            isValidImagePayload(8 * 1024 * 1024) &&
            request.resource.metadata.get('ownerId', '') == request.auth.uid &&
            request.resource.metadata.get('roomId', '') == roomId &&
            firestore.exists(reservationPath()) &&
            reservation.schemaVersion == 1 &&
            reservation.ownerId == request.auth.uid &&
            reservation.roomId == roomId &&
            reservation.reservationId == reservationId &&
            reservation.storagePath ==
              'room_images/' + roomId + '/' + fileName &&
            reservation.status == 'uploading' &&
            reservation.expiresAt > request.time &&
            reservation.contentType == request.resource.contentType &&
            reservation.size == request.resource.size;
      }

      // Object names are not a public gallery. Even a public room may have
      // abandoned/superseded uploads under its prefix, so direct get AND list
      // both fail closed. Only the exact Firestore-bound object is exposed by
      // getRoomCoverMediaAccess through a <=90-second generation-bound grant.
      allow read: if false;
      allow create: if resource == null &&
          isVerified() &&
          isActiveUser(request.auth.uid) &&
          validRoomImageUpload();
      allow update: if false;
      allow delete: if isVerified() && canManageActiveRoom();
    }

    match /clubs/{userId}/{clubId}/{fileName} {
      function clubPath() {
        return /databases/(default)/documents/clubs/$(clubId);
      }

      function memberPath() {
        return /databases/(default)/documents/clubs/$(clubId)/members/$(request.auth.uid);
      }

      // Authority comes from the live Club root and membership, never from
      // the historical uid embedded in the object path. This closes the
      // former-owner overwrite after an ownership transfer.
      function canManageExistingClub() {
        return firestore.exists(clubPath()) &&
            firestore.get(clubPath()).data.get('status', 'active') == 'active' &&
            firestore.get(clubPath()).data.get('deletionInProgress', false) != true &&
            firestore.exists(memberPath()) &&
            firestore.get(memberPath()).data.userId == request.auth.uid &&
            firestore.get(memberPath()).data.get('banned', false) != true &&
            (
              (
                firestore.get(clubPath()).data.ownerId == request.auth.uid &&
                firestore.get(memberPath()).data.role == 'owner'
              ) ||
              firestore.get(memberPath()).data.role in ['coOwner', 'admin']
            );
      }

      // Two object-name shapes remain recognizable on purpose. New object
      // allocation below accepts only deterministic `avatar|banner`; the
      // timestamped shape is retained solely so already-existing objects from
      // older clients can still be replaced or deleted during migration.
      //
      // The timestamped form is validated exactly like the profile path it
      // borrows its shape from: a fixed kind, a numeric suffix, an image
      // extension, and a declared content type that agrees with that
      // extension. The deterministic form carries no extension to agree
      // with, so content type and byte bounds are its whole contract.
      function validClubImageUpload() {
        return (
              fileName in ['avatar', 'banner'] ||
              (
                fileName.matches('(avatar|banner)_[0-9]+[.](jpg|jpeg|png|webp)') &&
                imageExtensionMatchesMime(fileName)
              )
            ) &&
            isValidImagePayload(8 * 1024 * 1024);
      }

      function isOrdinaryClubMedia() {
        return firestore.exists(clubPath()) &&
            !firestore.get(clubPath()).data.keys().hasAny([
              'serverSchemaVersion', 'serverType', 'serverActivationState'
            ]) &&
            firestore.get(clubPath()).data.get('type', 'community') != 'family';
      }

      // Ordinary Club artwork is public product media. Family roots are a
      // private membership boundary and deliberately have NO media access in
      // this release: Firebase download-token URLs bypass Storage Rules after
      // leaking, while the UI does not yet have an authenticated media
      // resolver. Missing roots fail closed too, so pre-root objects cannot be
      // enumerated or used as an anonymous orphan store.
      allow read: if isOrdinaryClubMedia();

      // A Premium/quota-bound Club root and canonical owner membership must
      // exist before the first byte can be stored. First creation is limited
      // to the two deterministic object names; historical timestamped objects
      // may be replaced/deleted but new ones cannot be minted indefinitely.
      // Cloud Storage classifies content replacement as `create`, hence the
      // explicit resource split.
      allow create: if isVerified() &&
          validClubImageUpload() &&
          isOrdinaryClubMedia() &&
          (
            (
              resource == null &&
              fileName in ['avatar', 'banner'] &&
              canManageExistingClub() &&
              userId == firestore.get(clubPath()).data.ownerId
            ) ||
            (
              resource != null &&
              canManageExistingClub()
            )
          );
      allow update: if false;
      allow delete: if isVerified() &&
          isOrdinaryClubMedia() &&
          canManageExistingClub();
    }

    // Family media shares the historical namespace so migration never
    // duplicates private bytes. Legacy families retain their member reads.
    // Servers V1 may create only the two immutable objects named by one live,
    // server-issued reservation. The caller's active profile and that
    // reservation consume Storage Rules' two cross-service reads; current
    // Family membership is rechecked by finalize before any moment becomes
    // visible. Published playback uses generation-bound V4 grants, so a
    // completed reservation leaves no direct object-read surface.
    match /family_moments/{clubId}/{userId}/{fileName} {
      function isActiveFamilyMember() {
        let familyPath = /databases/(default)/documents/clubs/$(clubId);
        let membershipPath = /databases/(default)/documents/clubs/$(clubId)/members/$(request.auth.uid);
        return isSignedIn() &&
            firestore.exists(familyPath) &&
            !firestore.get(familyPath).data.keys().hasAny([
              'serverSchemaVersion', 'serverType', 'serverActivationState'
            ]) &&
            firestore.get(familyPath).data.type == 'family' &&
            firestore.get(familyPath).data.get('status', 'active') == 'active' &&
            firestore.get(familyPath).data.get('deletionInProgress', false) != true &&
            firestore.exists(membershipPath) &&
            firestore.get(membershipPath).data.userId == request.auth.uid &&
            firestore.get(membershipPath).data.get('banned', false) != true;
      }

      function v1ReservationPath(metadata) {
        return /databases/(default)/documents/serverFamilyMemoryUploadReservations/$(metadata.get('yovoiceMemoryId', ''));
      }

      function exactV1Metadata(metadata, assetKind) {
        return metadata.keys().hasOnly([
              'yovoiceServerId', 'yovoiceChannelId', 'yovoiceOwnerUid',
              'yovoiceMemoryId', 'yovoiceAssetKind'
            ]) &&
            metadata.get('yovoiceServerId', '') == clubId &&
            metadata.get('yovoiceOwnerUid', '') == userId &&
            metadata.get('yovoiceMemoryId', '').matches('fm_[a-f0-9]{40}') &&
            metadata.get('yovoiceChannelId', '').matches('[A-Za-z0-9_-]{1,128}') &&
            metadata.get('yovoiceAssetKind', '') == assetKind;
      }

      function liveV1Reservation(metadata) {
        let path = v1ReservationPath(metadata);
        let reservation = firestore.get(path).data;
        return firestore.exists(path) &&
            reservation.keys().hasOnly([
              'schemaVersion', 'kind', 'serverId', 'channelId', 'memoryId',
              'ownerId', 'requestId', 'caption', 'photoStoragePath',
              'photoContentType', 'photoSize', 'voiceStoragePath',
              'voiceContentType', 'voiceSize', 'voiceDurationMs', 'status',
              'createdAt', 'expiresAt'
            ]) &&
            reservation.schemaVersion == 1 &&
            reservation.kind == 'serverFamilyMemory' &&
            reservation.serverId == clubId &&
            reservation.channelId == metadata.get('yovoiceChannelId', '') &&
            reservation.memoryId == metadata.get('yovoiceMemoryId', '') &&
            reservation.ownerId == userId &&
            reservation.status == 'uploading' &&
            reservation.expiresAt is timestamp &&
            reservation.expiresAt > request.time;
      }

      function reservedV1Photo(size, contentType, metadata) {
        let reservation = firestore.get(v1ReservationPath(metadata)).data;
        let memoryId = metadata.get('yovoiceMemoryId', '');
        return exactV1Metadata(metadata, 'photo') &&
            liveV1Reservation(metadata) &&
            reservation.photoStoragePath ==
              'family_moments/' + clubId + '/' + userId + '/' + fileName &&
            reservation.photoContentType == contentType &&
            reservation.photoSize == size &&
            size >= 128 && size <= 8 * 1024 * 1024 &&
            (
              (fileName == memoryId + '_photo.jpg' && contentType == 'image/jpeg') ||
              (fileName == memoryId + '_photo.png' && contentType == 'image/png') ||
              (fileName == memoryId + '_photo.webp' && contentType == 'image/webp')
            );
      }

      function reservedV1Voice(size, contentType, metadata) {
        let reservation = firestore.get(v1ReservationPath(metadata)).data;
        let memoryId = metadata.get('yovoiceMemoryId', '');
        return exactV1Metadata(metadata, 'voice') &&
            liveV1Reservation(metadata) &&
            reservation.voiceStoragePath ==
              'family_moments/' + clubId + '/' + userId + '/' + fileName &&
            reservation.voiceContentType == contentType &&
            reservation.voiceSize == size &&
            reservation.voiceDurationMs is int &&
            reservation.voiceDurationMs >= 1000 &&
            reservation.voiceDurationMs <= 30000 &&
            size >= 1024 && size <= 8 * 1024 * 1024 &&
            fileName == memoryId + '_voice.m4a' &&
            contentType == 'audio/mp4';
      }

      function reservedV1Asset(size, contentType, metadata) {
        return reservedV1Photo(size, contentType, metadata) ||
            reservedV1Voice(size, contentType, metadata);
      }

      allow get: if isActiveFamilyMember() ||
          (isActiveUser(userId) && resource != null &&
            reservedV1Asset(resource.size, resource.contentType, resource.metadata));
      allow list: if isActiveFamilyMember();
      allow create: if resource == null && isVerified() &&
          isActiveUser(userId) &&
          reservedV1Asset(
            request.resource.size,
            request.resource.contentType,
            request.resource.metadata
          );
      allow update, delete: if false;
    }

    // Company Files use one server-issued reservation per immutable object.
    // The reservation is the upload capability; channel membership and the
    // Company/files-channel shape are checked by the reserving callable and
    // checked again before finalization. Published playback never uses this
    // direct rule surface: it receives a short, generation-bound V4 grant.
    match /server_company_files/{serverId}/{channelId}/{userId}/{fileName} {
      function reservationPath(metadata) {
        return /databases/(default)/documents/serverCompanyFileUploadReservations/$(metadata.get('yovoiceFileId', ''));
      }

      function exactMetadata(metadata) {
        return metadata.keys().hasOnly([
              'yovoiceServerId', 'yovoiceChannelId', 'yovoiceOwnerUid',
              'yovoiceFileId', 'yovoiceAssetKind'
            ]) &&
            metadata.get('yovoiceServerId', '') == serverId &&
            metadata.get('yovoiceChannelId', '') == channelId &&
            metadata.get('yovoiceOwnerUid', '') == userId &&
            metadata.get('yovoiceFileId', '').matches('cf_[a-f0-9]{40}') &&
            metadata.get('yovoiceAssetKind', '') == 'companyFile';
      }

      function liveReservation(metadata, size, contentType) {
        let path = reservationPath(metadata);
        let reservation = firestore.get(path).data;
        let fileId = metadata.get('yovoiceFileId', '');
        return firestore.exists(path) &&
            reservation.keys().hasOnly([
              'schemaVersion', 'kind', 'serverId', 'channelId', 'fileId',
              'ownerId', 'requestId', 'displayName', 'storagePath',
              'contentType', 'size', 'status', 'createdAt', 'expiresAt'
            ]) &&
            reservation.schemaVersion == 1 &&
            reservation.kind == 'serverCompanyFile' &&
            reservation.serverId == serverId &&
            reservation.channelId == channelId &&
            reservation.fileId == fileId &&
            reservation.ownerId == userId &&
            reservation.storagePath ==
              'server_company_files/' + serverId + '/' + channelId + '/' + userId + '/' + fileName &&
            reservation.contentType == contentType &&
            reservation.size == size &&
            reservation.status == 'uploading' &&
            reservation.expiresAt is timestamp &&
            reservation.expiresAt > request.time;
      }

      function exactReservedFile(size, contentType, metadata) {
        let fileId = metadata.get('yovoiceFileId', '');
        return exactMetadata(metadata) &&
            liveReservation(metadata, size, contentType) &&
            size >= 1 && size <= 25 * 1024 * 1024 &&
            (
              (fileName == fileId + '.pdf' && contentType == 'application/pdf') ||
              (fileName == fileId + '.jpg' && contentType == 'image/jpeg') ||
              (fileName == fileId + '.png' && contentType == 'image/png') ||
              (fileName == fileId + '.webp' && contentType == 'image/webp') ||
              (fileName == fileId + '.txt' && contentType == 'text/plain')
            );
      }

      allow get: if isActiveUser(userId) && resource != null &&
          exactReservedFile(resource.size, resource.contentType, resource.metadata);
      allow list: if false;
      allow create: if resource == null && isVerified() && isActiveUser(userId) &&
          exactReservedFile(
            request.resource.size,
            request.resource.contentType,
            request.resource.metadata
          );
      allow update, delete: if false;
    }

    // Photo and video messages in Servers V1 text channels. The upload
    // capability is ONE live, server-issued reservation
    // (serverMessageMediaUploadReservations/{messageId}, written only by
    // reserveServerChannelMessageMediaV1 after the channel's write check); the
    // path alone grants nothing. The reservation is the second and last
    // cross-service document (the first is the account-status read), so these
    // rules cannot evaluate the channel ACL: a viewer never reads bytes here.
    // Published media is served only by getServerChannelMessageMediaAccessV1,
    // which re-runs the channel ACL and returns 90-second generation-bound V4
    // URLs. Bounds are the direct-message ones: image jpeg/png/webp
    // 128 B-8 MiB, video mp4/quicktime/webm 1 KiB-64 MiB, 1-60 s.
    match /server_message_media/{serverId}/{channelId}/{userId}/{fileName} {
      function reservationPath(metadata) {
        return /databases/(default)/documents/serverMessageMediaUploadReservations/$(metadata.get('yovoiceMessageId', ''));
      }

      function exactMetadata(metadata) {
        let messageId = metadata.get('yovoiceMessageId', '');
        return metadata.keys().hasOnly([
              'yovoiceServerId', 'yovoiceChannelId', 'yovoiceOwnerUid',
              'yovoiceMessageId', 'yovoiceMessagePath', 'yovoiceMediaType'
            ]) &&
            metadata.get('yovoiceServerId', '') == serverId &&
            metadata.get('yovoiceChannelId', '') == channelId &&
            metadata.get('yovoiceOwnerUid', '') == userId &&
            messageId.matches('cm_[a-f0-9]{40}') &&
            metadata.get('yovoiceMessagePath', '') ==
              'clubs/' + serverId + '/channels/' + channelId + '/messages/' + messageId &&
            metadata.get('yovoiceMediaType', '') in ['image', 'video'];
      }

      function boundedMedia(size, contentType, metadata) {
        let messageId = metadata.get('yovoiceMessageId', '');
        let type = metadata.get('yovoiceMediaType', '');
        return (
              type == 'image' && size >= 128 && size <= 8 * 1024 * 1024 &&
              (
                (fileName == messageId + '.jpg' && contentType == 'image/jpeg') ||
                (fileName == messageId + '.png' && contentType == 'image/png') ||
                (fileName == messageId + '.webp' && contentType == 'image/webp')
              )
            ) || (
              type == 'video' && size >= 1024 && size <= 64 * 1024 * 1024 &&
              (
                (fileName == messageId + '.mp4' && contentType == 'video/mp4') ||
                (fileName == messageId + '.mov' && contentType == 'video/quicktime') ||
                (fileName == messageId + '.webm' && contentType == 'video/webm')
              )
            );
      }

      function liveReservation(metadata, size, contentType) {
        let path = reservationPath(metadata);
        let reservation = firestore.get(path).data;
        return firestore.exists(path) &&
            reservation.keys().hasOnly([
              'schemaVersion', 'kind', 'serverId', 'channelId', 'messageId',
              'ownerId', 'requestId', 'type', 'contentType', 'size',
              'durationSeconds', 'storagePath', 'status', 'createdAt', 'expiresAt'
            ]) &&
            reservation.schemaVersion == 1 &&
            reservation.kind == 'serverChannelMessageMedia' &&
            reservation.serverId == serverId &&
            reservation.channelId == channelId &&
            reservation.messageId == metadata.get('yovoiceMessageId', '') &&
            reservation.ownerId == userId &&
            reservation.storagePath ==
              'server_message_media/' + serverId + '/' + channelId + '/' + userId + '/' + fileName &&
            reservation.contentType == contentType &&
            reservation.size == size &&
            reservation.type == metadata.get('yovoiceMediaType', '') &&
            (
              (reservation.type == 'image' && reservation.durationSeconds == null) ||
              (
                reservation.type == 'video' &&
                reservation.durationSeconds is int &&
                reservation.durationSeconds >= 1 &&
                reservation.durationSeconds <= 60
              )
            ) &&
            reservation.status == 'uploading' &&
            reservation.expiresAt is timestamp &&
            reservation.expiresAt > request.time;
      }

      function exactReservedMedia(size, contentType, metadata) {
        return exactMetadata(metadata) &&
            boundedMedia(size, contentType, metadata) &&
            liveReservation(metadata, size, contentType);
      }

      // Upload recovery only: the uploader, while their reservation is live.
      allow get: if isActiveUser(userId) && resource != null &&
          exactReservedMedia(resource.size, resource.contentType, resource.metadata);
      allow list: if false;
      allow create: if resource == null && isVerified() && isActiveUser(userId) &&
          exactReservedMedia(
            request.resource.size,
            request.resource.contentType,
            request.resource.metadata
          );
      allow update, delete: if false;
    }

    // In-app bug report screenshots. The upload capability is ONE live,
    // server-issued reservation (bugReportUploadReservations/{reportId},
    // written only by submitBugReportV1 after its rate limits); the path alone
    // grants nothing. Exactly one JPEG of 128 B-1.5 MB, named after the
    // report, with exactly the reserved metadata. The reservation is the
    // second and last cross-service document (the first is the account-status
    // read). E-mail verification is deliberately NOT required: a tester stuck
    // before verification must be able to report, and the server-side rate
    // limit on reservations bounds the surface. The owner reads the bytes only
    // through getBugReportV1's 5-minute generation-bound V4 URL; the uploader
    // may read their own object back only while the reservation is live
    // (upload recovery). Nobody lists, updates or deletes.
    match /bug_reports/{userId}/{fileName} {
      function reservationPath(metadata) {
        return /databases/(default)/documents/bugReportUploadReservations/$(metadata.get('yovoiceReportId', ''));
      }

      function exactReservedScreenshot(size, contentType, metadata) {
        let reportId = metadata.get('yovoiceReportId', '');
        let path = reservationPath(metadata);
        let reservation = firestore.get(path).data;
        return metadata.keys().hasOnly(['yovoiceOwnerUid', 'yovoiceReportId']) &&
            metadata.get('yovoiceOwnerUid', '') == userId &&
            reportId.matches('br_[a-f0-9]{40}') &&
            fileName == reportId + '.jpg' &&
            contentType == 'image/jpeg' &&
            size >= 128 && size <= 1500000 &&
            firestore.exists(path) &&
            reservation.keys().hasOnly([
              'schemaVersion', 'kind', 'reportId', 'ownerId', 'contentType',
              'size', 'storagePath', 'status', 'createdAt', 'expiresAt'
            ]) &&
            reservation.schemaVersion == 1 &&
            reservation.kind == 'bugReportScreenshot' &&
            reservation.reportId == reportId &&
            reservation.ownerId == userId &&
            reservation.storagePath == 'bug_reports/' + userId + '/' + fileName &&
            reservation.contentType == contentType &&
            reservation.size == size &&
            reservation.status == 'uploading' &&
            reservation.expiresAt is timestamp &&
            reservation.expiresAt > request.time;
      }

      allow get: if isActiveUser(userId) && resource != null &&
          exactReservedScreenshot(resource.size, resource.contentType, resource.metadata);
      allow list: if false;
      allow create: if resource == null && isActiveUser(userId) &&
          exactReservedScreenshot(
            request.resource.size,
            request.resource.contentType,
            request.resource.metadata
          );
      allow update, delete: if false;
    }

    // Podcast Egress writes directly through its dedicated, least-privilege
    // GCS service account. Firebase clients never upload or read these MP3s;
    // playback is a short-lived, generation-bound signed URL issued only
    // after getServerPodcastEpisodeAccessV1 rechecks membership and channel ACL.
    match /server_podcast_episodes/{serverId}/{channelId}/{fileName} {
      allow read, write: if false;
    }

    // Private direct-message attachments are immutable, server-reserved
    // objects. A participant may point-read only an object already bound to a
    // canonical message; prefixes are never enumerable and an uploading
    // reservation alone grants no recipient read. No public download-token URL
    // is stored in Firestore. Creation is bound to an unexpired, server-owned
    // reservation whose exact object identity and media contract are mirrored
    // in custom metadata.
    match /message_attachments/{ownerId}/{conversationId}/{fileName} {
      function reservationPath() {
        return /databases/(default)/documents/directMessageUploadReservations/$(request.resource.metadata.get('yovoiceMessageId', ''));
      }

      function conversationPath() {
        return /databases/(default)/documents/conversations/$(conversationId);
      }

      function validAttachmentIdentity() {
        let messageId = request.resource.metadata.get('yovoiceMessageId', '');
        let reservation = firestore.get(reservationPath()).data;
        return request.resource.metadata.keys().hasOnly([
              'yovoiceConversationId', 'yovoiceMessageId',
              'yovoiceMessagePath', 'yovoiceMediaType', 'yovoiceOwnerUid'
            ]) &&
            messageId.matches('m_[a-f0-9]{40}') &&
            fileName.matches(messageId + '[.](jpg|png|webp|m4a|mp4|mov|webm)') &&
            request.resource.metadata.get('yovoiceOwnerUid', '') == ownerId &&
            request.resource.metadata.get('yovoiceConversationId', '') == conversationId &&
            request.resource.metadata.get('yovoiceMessagePath', '') ==
              'conversations/' + conversationId + '/messages/' + messageId &&
            firestore.exists(reservationPath()) &&
            reservation.schemaVersion == 1 &&
            reservation.ownerId == ownerId &&
            reservation.conversationId == conversationId &&
            reservation.messageId == messageId &&
            reservation.storagePath ==
              'message_attachments/' + ownerId + '/' + conversationId + '/' + fileName &&
            reservation.status == 'uploading' &&
            reservation.expiresAt > request.time &&
            reservation.contentType == request.resource.contentType &&
            reservation.type == request.resource.metadata.get('yovoiceMediaType', '') &&
            (
              (
                reservation.type == 'image' &&
                reservation.durationSeconds == null &&
                isValidImagePayload(8 * 1024 * 1024) &&
                imageExtensionMatchesMime(fileName)
              ) ||
              (
                reservation.type == 'voice' &&
                fileName.matches('m_[a-f0-9]{40}[.]m4a') &&
                reservation.durationSeconds is int &&
                reservation.durationSeconds >= 1 &&
                reservation.durationSeconds <= 60 &&
                isValidAudioPayload()
              ) ||
              (
                reservation.type == 'video' &&
                reservation.durationSeconds is int &&
                reservation.durationSeconds >= 1 &&
                reservation.durationSeconds <= 60 &&
                isValidVideoPayload() &&
                videoExtensionMatchesMime(fileName)
              )
            );
      }

      function canReadFinalizedAttachment() {
        let messageId = resource.metadata.get('yovoiceMessageId', '');
        // The generation-bound server finalizer adds yovoiceFinalized only
        // after validating the exact reservation/bytes and revoking the
        // upload's durable token. Build 18 objects are upgraded by the trusted
        // pre-cutover migration; marker-less objects intentionally have no
        // read fallback because rules cannot distinguish an old finalized
        // object from a current upload that is still in progress. This also
        // leaves the two cross-service reads for current account state and
        // current conversation membership.
        return isActiveUser(request.auth.uid) &&
            resource != null &&
            resource.metadata.keys().hasOnly([
              'yovoiceConversationId', 'yovoiceMessageId',
              'yovoiceMessagePath', 'yovoiceMediaType', 'yovoiceOwnerUid',
              'yovoiceFinalized'
            ]) &&
            resource.metadata.get('yovoiceFinalized', '') == 'true' &&
            messageId.matches('m_[a-f0-9]{40}') &&
            fileName.matches(messageId + '[.](jpg|png|webp|m4a|mp4|mov|webm)') &&
            resource.metadata.get('yovoiceOwnerUid', '') == ownerId &&
            resource.metadata.get('yovoiceConversationId', '') == conversationId &&
            resource.metadata.get('yovoiceMessagePath', '') ==
              'conversations/' + conversationId + '/messages/' + messageId &&
            firestore.exists(conversationPath()) &&
            firestore.get(conversationPath()).data.schemaVersion == 2 &&
            request.auth.uid in firestore.get(conversationPath()).data.participantIds &&
            (
              (
                resource.metadata.get('yovoiceMediaType', '') == 'image' &&
                resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
              ) ||
              (
                resource.metadata.get('yovoiceMediaType', '') == 'voice' &&
                resource.contentType in ['audio/mp4', 'audio/m4a', 'audio/x-m4a']
              ) ||
              (
                resource.metadata.get('yovoiceMediaType', '') == 'video' &&
                resource.contentType in ['video/mp4', 'video/quicktime', 'video/webm']
              )
            );
      }

      allow get: if canReadFinalizedAttachment();
      allow list: if false;
      allow create: if resource == null &&
          isVerified() &&
          isActiveUser(ownerId) &&
          validAttachmentIdentity();
      allow update, delete: if false;
    }

    // Reels are private, immutable, server-reserved objects. The uploader may
    // create or recover only the exact bytes described by one live reservation;
    // published playback is served by a short-lived generation-bound V4 grant.
    match /reels/{userId}/{reelId}/{fileName} {
      function reservationPath() {
        return /databases/(default)/documents/reelUploadReservations/$(reelId);
      }

      function liveReservation() {
        let path = reservationPath();
        return firestore.exists(path) &&
            firestore.get(path).data.schemaVersion == 1 &&
            firestore.get(path).data.status == 'uploading' &&
            firestore.get(path).data.ownerId == userId &&
            firestore.get(path).data.reelId == reelId &&
            firestore.get(path).data.expiresAt is timestamp &&
            firestore.get(path).data.expiresAt > request.time;
      }

      function exactMetadata(metadata, kind) {
        return metadata.keys().hasOnly(['ownerId', 'reelId', 'assetKind']) &&
            metadata.ownerId == userId &&
            metadata.reelId == reelId &&
            metadata.assetKind == kind;
      }

      function reservedMedia(size, contentType, metadata) {
        let reservation = firestore.get(reservationPath()).data;
        return exactMetadata(metadata, 'media') &&
            reservation.mediaStoragePath ==
                'reels/' + userId + '/' + reelId + '/' + fileName &&
            reservation.mediaContentType == contentType &&
            reservation.mediaSize == size &&
            size >= 128 &&
            (
              (
                reservation.mediaKind == 'image' &&
                size <= 10 * 1024 * 1024 &&
                (
                  (fileName == 'media.jpg' && contentType == 'image/jpeg') ||
                  (fileName == 'media.png' && contentType == 'image/png') ||
                  (fileName == 'media.webp' && contentType == 'image/webp')
                )
              ) ||
              (
                reservation.mediaKind == 'video' &&
                size <= 100 * 1024 * 1024 &&
                (
                  (fileName == 'media.mp4' && contentType == 'video/mp4') ||
                  (fileName == 'media.mov' && contentType == 'video/quicktime') ||
                  (fileName == 'media.webm' && contentType == 'video/webm')
                )
              )
            );
      }

      function reservedAudio(size, contentType, metadata) {
        let reservation = firestore.get(reservationPath()).data;
        return reservation.hasBackingAudio == true &&
            exactMetadata(metadata, 'backingAudio') &&
            reservation.backingAudioStoragePath ==
                'reels/' + userId + '/' + reelId + '/' + fileName &&
            reservation.audioContentType == contentType &&
            reservation.audioSize == size &&
            size >= 512 && size <= 15 * 1024 * 1024 &&
            (
              (fileName == 'backing-audio.mp3' && contentType == 'audio/mpeg') ||
              (fileName == 'backing-audio.m4a' && contentType == 'audio/mp4') ||
              (fileName == 'backing-audio.wav' && contentType == 'audio/wav')
            );
      }

      function reservedAsset(size, contentType, metadata) {
        return liveReservation() &&
            (
              reservedMedia(size, contentType, metadata) ||
              reservedAudio(size, contentType, metadata)
            );
      }

      allow get: if isActiveUser(userId) &&
          reservedAsset(resource.size, resource.contentType, resource.metadata);
      allow list: if false;
      allow create: if resource == null && isVerified() &&
          isActiveUser(userId) &&
          reservedAsset(
            request.resource.size,
            request.resource.contentType,
            request.resource.metadata
          );
      allow update, delete: if false;
    }

    match /voice_moments/{userId}/{fileName} {
      function canonicalUploadingDraft(momentId) {
        let momentPath = /databases/(default)/documents/voiceMoments/$(momentId);
        return firestore.exists(momentPath) &&
            firestore.get(momentPath).data.schemaVersion == 2 &&
            firestore.get(momentPath).data.authorId == userId &&
            firestore.get(momentPath).data.get('isPublished', true) == false &&
            firestore.get(momentPath).data.get('isDeleted', true) == false &&
            firestore.get(momentPath).data.get('status', '') == 'uploading' &&
            firestore.get(momentPath).data.get('audioUrl', null) == null &&
            firestore.get(momentPath).data.get('publishedAt', null) == null &&
            firestore.get(momentPath).data.get('mediaGeneration', null) == null &&
            firestore.get(momentPath).data.get('mediaSize', null) == null &&
            firestore.get(momentPath).data.get('mediaContentType', null) == null &&
            firestore.get(momentPath).data.storagePath ==
                'voice_moments/' + userId + '/' + fileName &&
            firestore.get(momentPath).data.durationSeconds is int &&
            firestore.get(momentPath).data.durationSeconds >= 1 &&
            firestore.get(momentPath).data.durationSeconds <= 60;
      }

      function validUnpublishedDraft() {
        let momentId = request.resource.metadata.get('momentId', '');
        return request.resource.metadata.keys().hasOnly(['authorId', 'momentId']) &&
            request.resource.metadata.get('authorId', '') == userId &&
            momentId.matches('[a-f0-9]{20}') &&
            fileName == momentId + '.m4a' &&
            canonicalUploadingDraft(momentId);
      }

      function canReadMomentAudio() {
        let momentId = resource.metadata.get('momentId', '');
        let momentPath = /databases/(default)/documents/voiceMoments/$(momentId);
        return isSignedIn() &&
            resource.metadata.keys().hasOnly(['authorId', 'momentId']) &&
            momentId.matches('[A-Za-z0-9]{20}') &&
            fileName == momentId + '.m4a' &&
            resource.metadata.get('authorId', '') == userId &&
            firestore.exists(momentPath) &&
            firestore.get(momentPath).data.authorId == userId &&
            firestore.get(momentPath).data.storagePath ==
                'voice_moments/' + userId + '/' + fileName &&
            // Direct SDK reads exist only for the author's still-uploading
            // draft so an ambiguous upload can recover its generation.
            // Published playback is authorized by the
            // getVoiceMomentMediaAccess callable and uses a short-lived,
            // generation-bound signed URL. Never expose a durable Firebase
            // download token through this rule.
            request.auth.uid == userId &&
            firestore.get(momentPath).data.get('isPublished', true) == false &&
            firestore.get(momentPath).data.get('isDeleted', true) == false &&
            firestore.get(momentPath).data.get('status', '') == 'uploading';
      }

      allow read: if canReadMomentAudio();
      allow create: if resource == null &&
          isVerified() &&
          isActiveUser(userId) &&
          isValidAudioPayload() &&
          validUnpublishedDraft();
      // Existing media is immutable to clients. Cleanup remains scheduler/Admin
      // authority outside Storage Rules, including failed uploading drafts.
      allow update, delete: if false;
    }

    match /voice_replies/{userId}/{momentId}/{fileName} {
      function uploadReservationPath() {
        let commentId = request.resource.metadata.get('commentId', '');
        return /databases/(default)/documents/voiceMomentUploadReservations/$(commentId);
      }

      function validReservedVoiceReplyUpload() {
        let commentId = request.resource.metadata.get('commentId', '');
        let reservation = firestore.get(uploadReservationPath()).data;
        return request.resource.metadata.keys().hasOnly([
              'authorId', 'momentId', 'commentId'
            ]) &&
            request.resource.metadata.get('authorId', '') == userId &&
            request.resource.metadata.get('momentId', '') == momentId &&
            commentId.matches('[a-f0-9]{20}') &&
            fileName == commentId + '.m4a' &&
            firestore.exists(uploadReservationPath()) &&
            reservation.schemaVersion == 1 &&
            reservation.kind == 'voiceMomentComment' &&
            reservation.status == 'uploading' &&
            reservation.ownerId == userId &&
            reservation.momentId == momentId &&
            reservation.commentId == commentId &&
            reservation.storagePath ==
                'voice_replies/' + userId + '/' + momentId + '/' + fileName &&
            reservation.durationSeconds is int &&
            reservation.durationSeconds >= 1 &&
            reservation.durationSeconds <= 60 &&
            reservation.expiresAt is timestamp &&
            reservation.expiresAt > request.time;
      }

      function canReadReservedVoiceReply() {
        let commentId = resource.metadata.get('commentId', '');
        let reservationPath =
            /databases/(default)/documents/voiceMomentUploadReservations/$(commentId);
        let reservation = firestore.get(reservationPath).data;
        return isSignedIn() &&
            request.auth.uid == userId &&
            resource.metadata.keys().hasOnly([
              'authorId', 'momentId', 'commentId'
            ]) &&
            resource.metadata.get('authorId', '') == userId &&
            resource.metadata.get('momentId', '') == momentId &&
            commentId.matches('[a-f0-9]{20}') &&
            fileName == commentId + '.m4a' &&
            firestore.exists(reservationPath) &&
            reservation.schemaVersion == 1 &&
            reservation.kind == 'voiceMomentComment' &&
            reservation.status == 'uploading' &&
            reservation.ownerId == userId &&
            reservation.momentId == momentId &&
            reservation.commentId == commentId &&
            reservation.storagePath ==
                'voice_replies/' + userId + '/' + momentId + '/' + fileName &&
            reservation.expiresAt is timestamp &&
            reservation.expiresAt > request.time;
      }

      // Only the uploader may recover metadata while the reservation is
      // alive. Published reply playback uses the same short-lived callable
      // grants as root Moments.
      allow read: if canReadReservedVoiceReply();
      allow create: if resource == null &&
          isVerified() &&
          isActiveUser(userId) &&
          isValidAudioPayload() &&
          validReservedVoiceReplyUpload();
      // Existing media is immutable to clients. Cleanup remains scheduler/Admin
      // authority outside Storage Rules, including still-reserved uploads.
      allow update, delete: if false;
    }

    // A VOICE COMMENT ON A REEL. Structurally identical to the Voice reply
    // block above and deliberately so — same reservation-bound create, same
    // exact three metadata keys, same 1-60 s bound read off the reservation,
    // same "the uploader alone may read it back, and only while the
    // reservation is alive", same immutability.
    //
    // It is a SEPARATE block rather than a widening of that one because the
    // Voice reply's reservation collection is keyed by momentId and this one
    // by reelId: the two documents live in different collections and describe
    // different parents, so one rule cannot answer for both without accepting
    // a Moment reservation as authority for a Reel object.
    match /reel_voice_comments/{userId}/{reelId}/{fileName} {
      function voiceCommentReservationPath() {
        let commentId = request.resource.metadata.get('commentId', '');
        return /databases/(default)/documents/reelVoiceCommentReservations/$(commentId);
      }

      function validReservedReelVoiceCommentUpload() {
        let commentId = request.resource.metadata.get('commentId', '');
        let reservation = firestore.get(voiceCommentReservationPath()).data;
        return request.resource.metadata.keys().hasOnly([
              'authorId', 'reelId', 'commentId'
            ]) &&
            request.resource.metadata.get('authorId', '') == userId &&
            request.resource.metadata.get('reelId', '') == reelId &&
            commentId.matches('[a-f0-9]{40}') &&
            fileName == commentId + '.m4a' &&
            firestore.exists(voiceCommentReservationPath()) &&
            reservation.schemaVersion == 1 &&
            reservation.kind == 'reelVoiceComment' &&
            reservation.status == 'uploading' &&
            reservation.ownerId == userId &&
            reservation.reelId == reelId &&
            reservation.commentId == commentId &&
            reservation.storagePath ==
                'reel_voice_comments/' + userId + '/' + reelId + '/' + fileName &&
            reservation.durationSeconds is int &&
            reservation.durationSeconds >= 1 &&
            reservation.durationSeconds <= 60 &&
            reservation.expiresAt is timestamp &&
            reservation.expiresAt > request.time;
      }

      function canReadReservedReelVoiceComment() {
        let commentId = resource.metadata.get('commentId', '');
        let reservationPath =
            /databases/(default)/documents/reelVoiceCommentReservations/$(commentId);
        let reservation = firestore.get(reservationPath).data;
        return isSignedIn() &&
            request.auth.uid == userId &&
            resource.metadata.keys().hasOnly([
              'authorId', 'reelId', 'commentId'
            ]) &&
            resource.metadata.get('authorId', '') == userId &&
            resource.metadata.get('reelId', '') == reelId &&
            commentId.matches('[a-f0-9]{40}') &&
            fileName == commentId + '.m4a' &&
            firestore.exists(reservationPath) &&
            reservation.schemaVersion == 1 &&
            reservation.kind == 'reelVoiceComment' &&
            reservation.status == 'uploading' &&
            reservation.ownerId == userId &&
            reservation.reelId == reelId &&
            reservation.commentId == commentId &&
            reservation.storagePath ==
                'reel_voice_comments/' + userId + '/' + reelId + '/' + fileName &&
            reservation.expiresAt is timestamp &&
            reservation.expiresAt > request.time;
      }

      // Once finalizeReelVoiceCommentDraft deletes the reservation, EVERY
      // direct read dies with it — including the uploader's own. Playback from
      // then on is a short-lived, generation-bound V4 grant minted by
      // getReelMediaAccessV2, which re-checks the Reel's audience AND the
      // commenter's, in both block directions, on every single request.
      allow read: if canReadReservedReelVoiceComment();
      allow create: if resource == null &&
          isVerified() &&
          isActiveUser(userId) &&
          isValidAudioPayload() &&
          validReservedReelVoiceCommentUpload();
      // Existing media is immutable to clients. Deletion is the cleanup
      // worker's Admin-SDK authority, never a client's — a commenter revoking
      // their words goes through deleteReelComment, which queues the object.
      allow update, delete: if false;
    }
  }
}
