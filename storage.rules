rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    // Mirrors firestore.rules' isVerified() — gates uploads tied to
    // content that gets shown to other users (room/club images, voice
    // moments/replies). Profile photos are deliberately left out: setting
    // one up during onboarding, before verification completes, is normal.
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Emulator-tested in firestore-tests/storage.test.js (run in CI).
    //
    // Size cap: since the crop editor landed (ADR-025), every profile
    // upload is a re-encoded JPEG — 1024x1024 avatars / 1920x1080
    // banners at quality 85, ~100-500 KB in practice. 2 MB is generous
    // headroom over the largest possible re-encode while cutting the old
    // as-is-upload ceiling (10 MB) fivefold. The three content types are
    // kept (not narrowed to JPEG alone) so any not-yet-refreshed client
    // that still uploads a validated original PNG/WebP keeps working.
    match /users/{userId}/profile/{fileName} {
      allow read: if true;
      allow write: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.size <= 2 * 1024 * 1024
          && request.resource.contentType in [
               'image/jpeg', 'image/png', 'image/webp'
             ];
    }

    // room_image_service.dart uploads to room_images/{roomId}/{uid}_{ts}.ext —
    // the segment right after room_images/ is the ROOM, not the uploader, so
    // matching it against request.auth.uid (as this rule used to) could
    // never succeed unless a room's ID happened to equal someone's uid.
    // Every room image upload was rejected. Validate via the filename
    // prefix instead, which is the uploader's uid by construction.
    match /room_images/{roomId}/{fileName} {
      allow read: if true;
      allow write: if isVerified()
          && fileName.matches(request.auth.uid + '_.*')
          && request.resource.size < 8 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
    }

    // club_service.dart uploads to clubs/{uid}/{clubId}/{kind}_{ts}.ext —
    // there was no rule for this path at all, so every club image upload
    // was rejected by the default deny.
    match /clubs/{userId}/{clubId}/{fileName} {
      allow read: if true;
      allow write: if isVerified()
          && request.auth.uid == userId
          && request.resource.size < 8 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
    }

    match /voice_moments/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isVerified()
          && request.auth.uid == userId
          && request.resource.size < 12 * 1024 * 1024
          && request.resource.contentType.matches('audio/.*');
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }
    match /voice_replies/{userId}/{momentId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isVerified()
          && request.auth.uid == userId
          && request.resource.size < 12 * 1024 * 1024
          && request.resource.contentType.matches('audio/.*');
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

  }
}
