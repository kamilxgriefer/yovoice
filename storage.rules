rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    // Mirrors firestore.rules' isVerified() — gates uploads tied to
    // content that gets shown to other users (room/club images, voice
    // moments/replies). Profile photos are deliberately left out: setting
    // one up during onboarding, before verification completes, is normal.
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Deployed 2026-08-08. Not emulator-tested — there is no storage rules
    // harness yet (see Roadmap 0b). Verified by inspection instead:
    // profile_service.dart is the only writer to this prefix and always
    // sets one of the three content types below.
    //
    // Size cap matches ProfileImageRules' banner budget (10 MB source).
    // It used to be 8 MB, which the client could not satisfy: a banner is
    // accepted up to 10 MB and — until the re-encode step lands — the
    // picked bytes are uploaded as-is on Web, where image_picker ignores
    // maxWidth. A 9 MB banner therefore passed client validation and was
    // then rejected here as "unauthorized". Content types are pinned to
    // the three formats the app can decode everywhere rather than any
    // image/*, so this is a narrower rule than before despite the higher
    // ceiling. Tighten the size again once uploads are re-encoded.
    match /users/{userId}/profile/{fileName} {
      allow read: if true;
      allow write: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.size <= 10 * 1024 * 1024
          && request.resource.contentType in [
               'image/jpeg', 'image/png', 'image/webp'
             ];
    }

    // room_image_service.dart uploads to room_images/{roomId}/{uid}_{ts}.ext —
    // the segment right after room_images/ is the ROOM, not the uploader, so
    // matching it against request.auth.uid (as this rule used to) could
    // never succeed unless a room's ID happened to equal someone's uid.
    // Every room image upload was rejected. Validate via the filename
    // prefix instead, which is the uploader's uid by construction.
    match /room_images/{roomId}/{fileName} {
      allow read: if true;
      allow write: if isVerified()
          && fileName.matches(request.auth.uid + '_.*')
          && request.resource.size < 8 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
    }

    // club_service.dart uploads to clubs/{uid}/{clubId}/{kind}_{ts}.ext —
    // there was no rule for this path at all, so every club image upload
    // was rejected by the default deny.
    match /clubs/{userId}/{clubId}/{fileName} {
      allow read: if true;
      allow write: if isVerified()
          && request.auth.uid == userId
          && request.resource.size < 8 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
    }

    match /voice_moments/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isVerified()
          && request.auth.uid == userId
          && request.resource.size < 12 * 1024 * 1024
          && request.resource.contentType.matches('audio/.*');
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }
    match /voice_replies/{userId}/{momentId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isVerified()
          && request.auth.uid == userId
          && request.resource.size < 12 * 1024 * 1024
          && request.resource.contentType.matches('audio/.*');
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

  }
}
