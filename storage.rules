rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Auth disabling/revocation does not invalidate an already-issued token
    // immediately. Mirror the authoritative Firestore account status wherever
    // the two-document cross-service budget permits it. Existing Club media
    // instead consumes that budget on its root + live membership/ban mirror.
    function isActiveUser(userId) {
      let userPath = /databases/(default)/documents/users/$(userId);
      return isSignedIn() &&
          request.auth.uid == userId &&
          firestore.exists(userPath) &&
          firestore.get(userPath).data.get('banned', false) != true &&
          firestore.get(userPath).data.get('disabled', false) != true;
    }

    function isAllowedImageType() {
      return request.resource.contentType in [
        'image/jpeg', 'image/png', 'image/webp'
      ];
    }

    function isAllowedAudioType() {
      return request.resource.contentType in [
        'audio/mp4', 'audio/m4a', 'audio/x-m4a'
      ];
    }

    function isValidImagePayload(maxBytes) {
      return request.resource.size >= 128 &&
          request.resource.size <= maxBytes &&
          isAllowedImageType();
    }

    function isValidAudioPayload() {
      return request.resource.size >= 1024 &&
          request.resource.size <= 12 * 1024 * 1024 &&
          isAllowedAudioType();
    }

    function imageExtensionMatchesMime(fileName) {
      return (
        fileName.matches('.*[.](jpg|jpeg)') &&
        request.resource.contentType == 'image/jpeg'
      ) || (
        fileName.matches('.*[.]png') &&
        request.resource.contentType == 'image/png'
      ) || (
        fileName.matches('.*[.]webp') &&
        request.resource.contentType == 'image/webp'
      );
    }

    // Profile images remain public by product design. Creates are append-only;
    // the client switches the Firestore pointer before deleting the old object.
    match /users/{userId}/profile/{fileName} {
      function validProfileUpload() {
        return fileName.matches('(avatar|banner)_[0-9]+[.](jpg|jpeg|png|webp)') &&
            imageExtensionMatchesMime(fileName) &&
            isValidImagePayload(2 * 1024 * 1024);
      }

      allow read: if true;
      allow create: if resource == null &&
          isActiveUser(userId) &&
          validProfileUpload();
      allow update: if false;
      allow delete: if isActiveUser(userId);
    }

    match /room_images/{roomId}/{fileName} {
      function canManageActiveRoom() {
        let roomPath = /databases/(default)/documents/rooms/$(roomId);
        return isActiveUser(request.auth.uid) &&
            firestore.exists(roomPath) &&
            firestore.get(roomPath).data.hostId == request.auth.uid &&
            firestore.get(roomPath).data.get('status', 'active') == 'active' &&
            firestore.get(roomPath).data.get('deletionInProgress', false) != true;
      }

      function validRoomImageUpload() {
        return fileName.matches(request.auth.uid + '_[0-9]+[.](jpg|png)') &&
            imageExtensionMatchesMime(fileName) &&
            isValidImagePayload(8 * 1024 * 1024);
      }

      allow read: if true;
      allow create: if resource == null &&
          isVerified() &&
          canManageActiveRoom() &&
          validRoomImageUpload();
      allow update: if false;
      allow delete: if isVerified() && canManageActiveRoom();
    }

    match /clubs/{userId}/{clubId}/{fileName} {
      function clubPath() {
        return /databases/(default)/documents/clubs/$(clubId);
      }

      function memberPath() {
        return /databases/(default)/documents/clubs/$(clubId)/members/$(request.auth.uid);
      }

      // Authority comes from the live Club root and membership, never from
      // the historical uid embedded in the object path. This closes the
      // former-owner overwrite after an ownership transfer.
      function canManageExistingClub() {
        return firestore.exists(clubPath()) &&
            firestore.get(clubPath()).data.get('status', 'active') == 'active' &&
            firestore.get(clubPath()).data.get('deletionInProgress', false) != true &&
            firestore.exists(memberPath()) &&
            firestore.get(memberPath()).data.userId == request.auth.uid &&
            firestore.get(memberPath()).data.get('banned', false) != true &&
            (
              (
                firestore.get(clubPath()).data.ownerId == request.auth.uid &&
                firestore.get(memberPath()).data.role == 'owner'
              ) ||
              firestore.get(memberPath()).data.role in ['coOwner', 'admin']
            );
      }

      // Two object-name shapes remain recognizable on purpose. New object
      // allocation below accepts only deterministic `avatar|banner`; the
      // timestamped shape is retained solely so already-existing objects from
      // older clients can still be replaced or deleted during migration.
      //
      // The timestamped form is validated exactly like the profile path it
      // borrows its shape from: a fixed kind, a numeric suffix, an image
      // extension, and a declared content type that agrees with that
      // extension. The deterministic form carries no extension to agree
      // with, so content type and byte bounds are its whole contract.
      function validClubImageUpload() {
        return (
              fileName in ['avatar', 'banner'] ||
              (
                fileName.matches('(avatar|banner)_[0-9]+[.](jpg|jpeg|png|webp)') &&
                imageExtensionMatchesMime(fileName)
              )
            ) &&
            isValidImagePayload(8 * 1024 * 1024);
      }

      function isOrdinaryClubMedia() {
        return firestore.exists(clubPath()) &&
            firestore.get(clubPath()).data.get('type', 'community') != 'family';
      }

      // Ordinary Club artwork is public product media. Family roots are a
      // private membership boundary and deliberately have NO media access in
      // this release: Firebase download-token URLs bypass Storage Rules after
      // leaking, while the UI does not yet have an authenticated media
      // resolver. Missing roots fail closed too, so pre-root objects cannot be
      // enumerated or used as an anonymous orphan store.
      allow read: if isOrdinaryClubMedia();

      // A Premium/quota-bound Club root and canonical owner membership must
      // exist before the first byte can be stored. First creation is limited
      // to the two deterministic object names; historical timestamped objects
      // may be replaced/deleted but new ones cannot be minted indefinitely.
      // Cloud Storage classifies content replacement as `create`, hence the
      // explicit resource split.
      allow create: if isVerified() &&
          validClubImageUpload() &&
          isOrdinaryClubMedia() &&
          (
            (
              resource == null &&
              fileName in ['avatar', 'banner'] &&
              canManageExistingClub() &&
              userId == firestore.get(clubPath()).data.ownerId
            ) ||
            (
              resource != null &&
              canManageExistingClub()
            )
          );
      allow update: if false;
      allow delete: if isVerified() &&
          isOrdinaryClubMedia() &&
          canManageExistingClub();
    }

    // No shipping client currently implements Family Moment uploads. Keep
    // existing member-only reads, but fail closed on client writes until a
    // server-issued upload session can bind object, author and Firestore row
    // without exceeding Storage Rules' two cross-service document reads.
    match /family_moments/{clubId}/{userId}/{fileName} {
      function isActiveFamilyMember() {
        let familyPath = /databases/(default)/documents/clubs/$(clubId);
        let membershipPath = /databases/(default)/documents/clubs/$(clubId)/members/$(request.auth.uid);
        return isSignedIn() &&
            firestore.exists(familyPath) &&
            firestore.get(familyPath).data.type == 'family' &&
            firestore.get(familyPath).data.get('status', 'active') == 'active' &&
            firestore.get(familyPath).data.get('deletionInProgress', false) != true &&
            firestore.exists(membershipPath) &&
            firestore.get(membershipPath).data.userId == request.auth.uid &&
            firestore.get(membershipPath).data.get('banned', false) != true;
      }

      allow read: if isActiveFamilyMember();
      allow create, update, delete: if false;
    }

    // Private direct-message attachments are immutable, server-reserved
    // objects. A participant may read through the authenticated Storage SDK;
    // no public download-token URL is stored in Firestore. Creation is bound
    // to an unexpired, server-owned reservation whose exact object identity
    // and media contract are mirrored in custom metadata.
    match /message_attachments/{ownerId}/{conversationId}/{fileName} {
      function reservationPath() {
        return /databases/(default)/documents/directMessageUploadReservations/$(request.resource.metadata.get('yovoiceMessageId', ''));
      }

      function conversationPath() {
        return /databases/(default)/documents/conversations/$(conversationId);
      }

      function validAttachmentIdentity() {
        let messageId = request.resource.metadata.get('yovoiceMessageId', '');
        let reservation = firestore.get(reservationPath()).data;
        return request.resource.metadata.keys().hasOnly([
              'yovoiceConversationId', 'yovoiceMessageId',
              'yovoiceMessagePath', 'yovoiceMediaType', 'yovoiceOwnerUid'
            ]) &&
            messageId.matches('m_[a-f0-9]{40}') &&
            fileName.matches(messageId + '[.](jpg|png|webp|m4a)') &&
            request.resource.metadata.get('yovoiceOwnerUid', '') == ownerId &&
            request.resource.metadata.get('yovoiceConversationId', '') == conversationId &&
            request.resource.metadata.get('yovoiceMessagePath', '') ==
              'conversations/' + conversationId + '/messages/' + messageId &&
            firestore.exists(reservationPath()) &&
            reservation.schemaVersion == 1 &&
            reservation.ownerId == ownerId &&
            reservation.conversationId == conversationId &&
            reservation.messageId == messageId &&
            reservation.storagePath ==
              'message_attachments/' + ownerId + '/' + conversationId + '/' + fileName &&
            reservation.status == 'uploading' &&
            reservation.expiresAt > request.time &&
            reservation.contentType == request.resource.contentType &&
            reservation.type == request.resource.metadata.get('yovoiceMediaType', '') &&
            (
              (
                reservation.type == 'image' &&
                reservation.durationSeconds == null &&
                isValidImagePayload(8 * 1024 * 1024) &&
                imageExtensionMatchesMime(fileName)
              ) ||
              (
                reservation.type == 'voice' &&
                fileName.matches('m_[a-f0-9]{40}[.]m4a') &&
                reservation.durationSeconds is int &&
                reservation.durationSeconds >= 1 &&
                reservation.durationSeconds <= 60 &&
                isValidAudioPayload()
              )
            );
      }

      function canReadPrivateAttachment() {
        return isActiveUser(request.auth.uid) &&
            firestore.exists(conversationPath()) &&
            firestore.get(conversationPath()).data.schemaVersion == 2 &&
            request.auth.uid in firestore.get(conversationPath()).data.participantIds;
      }

      allow read: if canReadPrivateAttachment();
      allow create: if resource == null &&
          isVerified() &&
          isActiveUser(ownerId) &&
          validAttachmentIdentity();
      allow update, delete: if false;
    }

    match /voice_moments/{userId}/{fileName} {
      function validUnpublishedDraft() {
        let momentId = request.resource.metadata.get('momentId', '');
        let momentPath = /databases/(default)/documents/voiceMoments/$(momentId);
        return request.resource.metadata.keys().hasOnly(['authorId', 'momentId']) &&
            request.resource.metadata.get('authorId', '') == userId &&
            momentId.matches('[A-Za-z0-9]{20}') &&
            fileName == momentId + '.m4a' &&
            firestore.exists(momentPath) &&
            firestore.get(momentPath).data.authorId == userId &&
            firestore.get(momentPath).data.get('isPublished', true) == false &&
            firestore.get(momentPath).data.get('audioUrl', null) == null &&
            firestore.get(momentPath).data.storagePath ==
                'voice_moments/' + userId + '/' + fileName &&
            firestore.get(momentPath).data.durationSeconds is int &&
            firestore.get(momentPath).data.durationSeconds >= 1 &&
            firestore.get(momentPath).data.durationSeconds <= 60;
      }

      allow read: if isSignedIn();
      allow create: if resource == null &&
          isVerified() &&
          isActiveUser(userId) &&
          isValidAudioPayload() &&
          validUnpublishedDraft();
      allow update: if false;
      allow delete: if isActiveUser(userId);
    }

    match /voice_replies/{userId}/{momentId}/{fileName} {
      function validPublishedParent() {
        let parentPath = /databases/(default)/documents/voiceMoments/$(momentId);
        let commentId = request.resource.metadata.get('commentId', '');
        return request.resource.metadata.keys().hasOnly([
              'authorId', 'momentId', 'commentId'
            ]) &&
            request.resource.metadata.get('authorId', '') == userId &&
            request.resource.metadata.get('momentId', '') == momentId &&
            commentId.matches('[A-Za-z0-9]{20}') &&
            fileName == commentId + '.m4a' &&
            firestore.exists(parentPath) &&
            firestore.get(parentPath).data.get('isPublished', false) == true &&
            firestore.get(parentPath).data.get('isDeleted', false) != true;
      }

      allow read: if isSignedIn();
      allow create: if resource == null &&
          isVerified() &&
          isActiveUser(userId) &&
          isValidAudioPayload() &&
          validPublishedParent();
      allow update: if false;
      allow delete: if isActiveUser(userId);
    }
  }
}
